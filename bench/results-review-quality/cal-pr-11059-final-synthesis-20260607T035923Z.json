    {
      "challengedBy": [],
      "claim": "The new webhook handler uses `prisma.credential.findFirst({ where: { userId, appId: appMetadata.slug } })` and later creates with `appId: appMetadata.slug`, but `appId` is typically a foreign-key/id field rather than a slug. This cross-file contract mismatch means existing credentials will not be found and updates may duplicate or fail depending on the schema.",
      "confidence": 0.7200000286102295,
      "discoveredBy": [
        "final-synthesis"
      ],
