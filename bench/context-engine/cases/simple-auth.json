{
  "schemaVersion": "muzen.context-eval-case.v2",
  "name": "simple-auth",
  "repoSource": {
    "kind": "fixture",
    "path": "fixtures/context-engine/simple-auth"
  },
  "changedFiles": [
    "src/auth/token.rs"
  ],
  "description": "Small Rust auth fixture for smoke-testing deterministic snapshot retrieval.",
  "cases": [
    {
      "id": "auth-token-related-tests",
      "kind": "related-tests",
      "path": "src/auth/token.rs",
      "maxResults": 5,
      "expectedPaths": [
        "tests/auth_token_test.rs"
      ],
      "strict": true
    },
    {
      "id": "auth-token-importers",
      "kind": "related-symbols",
      "path": "src/auth/token.rs",
      "maxResults": 10,
      "expectedPaths": [
        "src/routes.rs",
        "src/auth/token.rs"
      ],
      "expectedRanges": [
        {
          "kind": "symbol",
          "path": "src/auth/token.rs",
          "startLine": 1,
          "endLine": 4
        },
        {
          "kind": "symbol",
          "path": "src/auth/token.rs",
          "startLine": 6,
          "endLine": 11
        }
      ],
      "strict": true
    },
    {
      "id": "auth-token-text-search",
      "kind": "search-text",
      "query": "expires_at",
      "maxResults": 5,
      "expectedPaths": [
        "src/auth/token.rs"
      ],
      "strict": true
    },
    {
      "id": "auth-token-camelcase-search",
      "kind": "search-text",
      "query": "authorizeRequest",
      "maxResults": 5,
      "expectedPaths": [
        "src/auth/token.rs"
      ],
      "strict": true
    },
    {
      "id": "auth-token-local-semantic-search",
      "kind": "search-text",
      "query": "user id token",
      "maxResults": 5,
      "localSemantic": true,
      "maxEmbeddingInputs": 64,
      "expectedPaths": [
        "src/auth/token.rs"
      ],
      "strict": true
    }
  ]
}
