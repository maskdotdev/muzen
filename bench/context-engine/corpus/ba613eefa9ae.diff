+
+const isNonEmptyString = (value: unknown): value is string =>
+  typeof value === "string" && value.trim().length > 0
+
+const normalizeApiUrl = (value: string) => value.trim().replace(/\/+$/, "")
+
+const toOptionalString = (value: unknown) => {
+  if (typeof value !== "string") {
+    return null
+  }
+  const normalized = value.trim()
+  return normalized.length > 0 ? normalized : null
+}
+
+const sha256Hex = (input: string) =>
+  createHash("sha256").update(input).digest("hex")
+
+const normalizeReviewGateScope = (value: {
+  instanceUrl?: unknown
+  projectId?: unknown
+}): PersistReviewGateScope | null => {
+  const instanceUrl = toOptionalString(value.instanceUrl)?.replace(/\/+$/, "") ?? ""
+  const projectId = toOptionalString(value.projectId) ?? ""
+  if (!instanceUrl || !projectId) {
+    return null
+  }
+  return {
+    instanceUrl,
+    projectId,
+  }
+}
+
+const getEnvModel = (deps: PersistReviewRunDeps) => {
+  if (isNonEmptyString(deps.env.AI_MODEL)) {
+    return deps.env.AI_MODEL.trim()
+  }
+  if (isNonEmptyString(deps.env.OPENAI_MODEL)) {
+    return deps.env.OPENAI_MODEL.trim()
+  }
+  return deps.defaultModel
+}
+
+const buildReviewSummary = (findings: ReviewFinding[]) => {
+  if (findings.length === 0) {
+    return "AI review complete. No findings."
+  }
+  const highCount = findings.filter((finding) => finding.severity === "high").length
+  const medCount = findings.filter((finding) => finding.severity === "med").length
+  const lowCount = findings.length - highCount - medCount
+  return `AI review complete: ${findings.length} findings (${highCount} high, ${medCount} med, ${lowCount} low).`
+}
+
+const normalizePersonaPasses = (value: string[] | null | undefined) => {
+  if (!Array.isArray(value)) {
+    return [] as string[]
+  }
+  return Array.from(
+    new Set(
+      value
+        .map((entry) => String(entry ?? "").trim())
+        .filter((entry) => entry.length > 0),
+    ),
+  )
+}
+
+const isReviewFindingArray = (value: unknown): value is ReviewFinding[] =>
+  Array.isArray(value)
+
+export const persistReviewRunWithDeps = async (
+  args: PersistReviewRunInput,
+  deps: PersistReviewRunDeps,
+): Promise<PersistReviewRunResult> => {
+  const patch = String(args.patch ?? "")
+  const patchLength =
+    typeof args.patchLength === "number" && Number.isFinite(args.patchLength)
+      ? Math.max(0, Math.floor(args.patchLength))
+      : patch.length
+  const patchHash =
+    toOptionalString(args.patchHash) ?? (patch ? sha256Hex(patch) : null)
+  const verificationPatch = String(args.verificationPatch ?? patch)
+  const instanceUrl = normalizeApiUrl(args.instanceUrl)
+  const projectId = String(args.projectId).trim()
+  const mergeRequestIid = String(args.mergeRequestIid).trim()
+  const integrationId = toOptionalString(args.integrationId)
+  const source = args.source === "auto_project" ? "auto_project" : "manual"
+  const visibility =
+    args.visibility === "integration_shared" ? "integration_shared" : "private"
+  const requestedByUserId = toOptionalString(args.requestedByUserId)
+  const reviewConfigHash = toOptionalString(args.reviewConfigHash) ?? ""
+  const scope = normalizeReviewGateScope({
+    instanceUrl,
+    projectId,
+  })
+
+  if (!patchHash) {
+    throw new PersistReviewRunError("Patch hash is required.", 400)
+  }
+  if (!instanceUrl || !projectId || !mergeRequestIid) {
+    throw new PersistReviewRunError(
+      "instanceUrl, projectId, and mergeRequestIid are required.",
+      400,
+    )
+  }
+
+  const [gatePreferences, integration] = await Promise.all([
+    deps.resolveReviewGatePreferences({
+      userId: args.userId,
+      scope,
+    }),
+    deps.resolveManagedIntegrationForScope({
+      userId: args.userId,
+      instanceUrl,
+      projectId,
+      integrationId,
+    }),
+  ])
+
+  let argusSettings: PersistReviewArgusSettings | null = null
+  if (integration) {
+    try {
+      argusSettings = await deps.resolvePersistedRunArgusSettings({
+        integration,
+        userId: args.userId,
+        mergeRequestIid,
+        scope,
+      })
+    } catch (error) {
+      args.logger?.set({
+        argusJsonPersistResolutionError:
+          error instanceof Error
+            ? error.message.slice(0, 300)
+            : "Failed to resolve argus.json.",
+      })
+    }
+  }
+
+  const effectiveGateSettings =
+    argusSettings?.review.value ?? gatePreferences.effectiveSettings
+  const effectiveWorkflowSettings = argusSettings?.gitlab.value ?? {
+    aiReviewAutoPostEnabled: integration?.aiReviewAutoPostEnabled ?? false,
+    argusMrLinkAutoCommentEnabled:
+      integration?.argusMrLinkAutoCommentEnabled ?? false,
+  }
+
+  const issueContext = normalizeReviewIssueContext(args.issueContext)
+  const precisionResult = applyReviewPrecisionCleanup(args.findings)
+  const needsVerifierSettings =
+    precisionResult.findings.length > 0 &&
+    (deps.resolveReviewModelVerifierMode("persist") !== "off" ||
+      deps.resolveReviewModelVerifierMode("publish") !== "off")
+  let verifierProviderSettings = args.verifierProviderSettings ?? null
+  if (needsVerifierSettings && !verifierProviderSettings) {
+    try {
+      verifierProviderSettings = await deps.resolveReviewProviderSettingsForUser(
+        args.userId,
+      )
+    } catch (error) {
+      if (error instanceof ReviewProviderSettingsError) {
+        throw new PersistReviewRunError(error.message, error.status)
+      }
+      throw error
+    }
+  }
+
+  const verifierResult = await deps.runReviewModelVerifier({
+    policy: "persist",
+    findings: precisionResult.findings,
+    patch: verificationPatch,
+    issueContext,
+    providerSettings: verifierProviderSettings,
+    artifactPrefix: args.artifactPrefix,
+    traceId: toOptionalString(args.requestId),
+  })
+  const gateResult = applyReviewGate({
+    findings: verifierResult.findings,
+    settings: effectiveGateSettings,
+  })
+  const filteredFindings = gateResult.filteredFindings
+  const suppressedByReason = mergeSuppressedByReason(
+    precisionResult.suppressedByReason,
+    verifierResult.suppressedByReason,
+    gateResult.suppressedByReason,
+  )
+  const suppressedFindingsCount =
+    precisionResult.suppressedFindingsCount +
+    verifierResult.suppressedFindingsCount +
+    gateResult.suppressedFindingsCount
+  const shouldReuseProvidedSummary =
+    isNonEmptyString(args.summary) &&
+    filteredFindings.length === args.findings.length - suppressedFindingsCount
+  const summary = shouldReuseProvidedSummary
+    ? args.summary!.trim()
+    : buildReviewSummary(filteredFindings)
+  const model = toOptionalString(args.model) ?? getEnvModel(deps)
+  const personaMode = normalizeReviewPersonaMode(
+    args.personaMode ?? effectiveGateSettings.personaMode,
+  )
+  const persona = normalizeReviewPersona(
+    args.persona ?? effectiveGateSettings.persona,
+  )
+  const personaPasses = normalizePersonaPasses(args.personaPasses)
+  const gateProfile = {
+    ...buildStoredGateProfile(effectiveGateSettings),
+    personaMode,
+    persona,
+    personaPasses,
+  }
+
+  let sourceBranch: string | null = toOptionalString(args.sourceBranch)
+  let sourceBaseSha: string | null = toOptionalString(args.sourceBaseSha)
+  let sourceStartSha: string | null = toOptionalString(args.sourceStartSha)
+  let sourceHeadSha: string | null = toOptionalString(args.sourceHeadSha)
+  if (integration) {
+    try {
+      const graphScope = await deps.resolveMergeRequestGraphScope({
+        integration,
+        userId: args.userId,
+        instanceUrl,
+        projectId,
+        mergeRequestIid,
+      })
+      sourceBranch = graphScope?.sourceBranch ?? sourceBranch
+      sourceBaseSha = graphScope?.sourceBaseSha ?? sourceBaseSha
+      sourceStartSha = graphScope?.sourceStartSha ?? sourceStartSha
+      sourceHeadSha = graphScope?.sourceHeadSha ?? sourceHeadSha
+    } catch (error) {
+      args.logger?.set({
+        reviewGraphScopeLookupError:
+          error instanceof Error ? error.message : "unknown",
+        reviewGraphScopeLookupIntegrationId: integration.id,
+        instanceUrl,
+        projectId,
+        mergeRequestIid,
+      })
+    }
+  }
+
+  const row = await deps.insertReviewRun({
+    userId: args.userId,
+    requestedByUserId,
+    instanceUrl,
+    projectId,
+    mergeRequestIid,
+    integrationId: integration?.id ?? null,
+    source,
+    visibility,
+    sourceBranch,
+    sourceBaseSha,
+    sourceStartSha,
+    sourceHeadSha,
+    personaMode,
+    persona,
+    personaPasses,
+    reviewConfigHash,
+    gateProfile,
+    model,
+    patchLength,
+    patchHash,
+    findings: filteredFindings,
+    issueContext,
+    findingsCount: filteredFindings.length,
+    suppressedFindingsCount,
+    suppressedByReason,
+    summary,
+  })
+
+  const requestId = toOptionalString(args.requestId)
+  if (requestId) {
+    await deps.finalizeAccess({
+      userId: args.userId,
+      requestId,
+      usesServerToken: args.usedServerToken,
+    })
+  }
+
+  const publishPrecisionResult = verifyFindingsForPublication(filteredFindings)
+  const publishVerifierResult = await deps.runReviewModelVerifier({
+    policy: "publish",
+    findings: publishPrecisionResult.findings,
+    patch: verificationPatch,
+    issueContext,
+    providerSettings: verifierProviderSettings,
+    artifactPrefix: args.artifactPrefix,
+    traceId: toOptionalString(args.requestId),
+  })
+  const publishableFindings = publishVerifierResult.blockedByError
+    ? []
+    : publishVerifierResult.findings
+
+  args.logger?.set({
+    reviewVerifierPersistMode: verifierResult.mode,
+    reviewVerifierPersistEvaluatedCount: verifierResult.evaluatedCount,
+    reviewVerifierPersistSuppressedCount: verifierResult.suppressedFindingsCount,
+    reviewVerifierPersistShadowSuppressedCount:
+      verifierResult.shadowSuppressedFindingsCount,
+    reviewVerifierPublishMode: publishVerifierResult.mode,
+    reviewVerifierPublishEvaluatedCount: publishVerifierResult.evaluatedCount,
+    reviewVerifierPublishSuppressedCount:
+      publishVerifierResult.suppressedFindingsCount,
+    reviewVerifierPublishShadowSuppressedCount:
+      publishVerifierResult.shadowSuppressedFindingsCount,
+    reviewVerifierPublishBlockedByError: publishVerifierResult.blockedByError,
+    reviewVerifierPublishError: publishVerifierResult.errorMessage,
+  })
+
+  if (
+    effectiveWorkflowSettings.aiReviewAutoPostEnabled &&
+    integration &&
+    row &&
+    publishableFindings.length > 0
+  ) {
+    const upsertResult = await deps.upsertPublicationsForReview({
+      reviewId: row.id,
+      integrationId: integration.id,
+      userId: args.userId,
+      instanceUrl,
+      projectId,
+      mergeRequestIid,
+      findings: publishableFindings,
+    })
+
+    const queuedKeys = Object.entries(upsertResult.commentPublishByKey)
+      .filter(([, state]) => state.status === "pending")
+      .map(([commentKey]) => commentKey)
+    for (const commentKey of queuedKeys) {
+      await deps.processPublicationNow({
+        integrationId: integration.id,
+        mergeRequestIid,
+        commentKey,
+      })
+    }
+  }
+
+  const commentPublishByKey = row
+    ? await deps.getCommentPublishByKeyForReview({
+        integrationId: integration?.id ?? null,
+        mergeRequestIid,
+        findings: publishableFindings,
+      })
+    : {}
+
+  return {
+    review: row
+      ? {
+          id: row.id,
+          summary: row.summary,
+          model,
+          findings: isReviewFindingArray(row.findings) ? row.findings : [],
+          source,
+          access:
+            row.visibility === "integration_shared" ? "shared_member" : "owner",
+          personaMode: normalizeReviewPersonaMode(row.personaMode),
+          persona: normalizeReviewPersona(row.persona),
+          personaPasses: normalizePersonaPasses(
+            Array.isArray(row.personaPasses) ? row.personaPasses : [],
+          ),
+          feedback: null,
+          commentFeedbackByKey: {},
+          commentPublishByKey,
+          issueContext: normalizeReviewIssueContext(row.issueContext),
+          createdAt: row.createdAt.toISOString(),
+        }
+      : null,
+    suppressedFindingsCount,
+    suppressedByReason,
+    gateProfile: {
+      ...gateProfile,
+    },
+    filteredFindings,
+    summary,
+    model,
+    integrationId: integration?.id ?? null,
+  }
+}
