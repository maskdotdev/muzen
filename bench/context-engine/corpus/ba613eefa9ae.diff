+}
+
+describe("persistReviewRunWithDeps", () => {
+  test("persists a review run and finalizes reserved access", async () => {
+    const deps = createDeps()
+
+    const result = await persistReviewRunWithDeps({
+      userId: "user-1",
+      patch: "diff --git a/src/a.ts b/src/a.ts\n+const value = 1;\n",
+      findings: [],
+      instanceUrl: "https://gitlab.example.com/",
+      projectId: "123",
+      mergeRequestIid: "42",
