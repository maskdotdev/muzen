+    defaultModel: "gpt-test",
+    resolveReviewGatePreferences: mock(async () => ({
+      effectiveSettings: gateSettings,
+    })),
+    resolveManagedIntegrationForScope: mock(async () => null),
+    resolvePersistedRunArgusSettings: mock(async () => null),
+    resolveReviewProviderSettingsForUser: mock(async () => ({
+      apiUrl: "https://api.example.com",
+      model: "gpt-test",
+      token: "token",
+      usesServerToken: true,
+    })),
+    resolveReviewModelVerifierMode: mock(() => "off"),
+    runReviewModelVerifier: mock(async (
