+    ) => ({
+      policy: args.policy,
+      mode: "off",
+      model: args.providerSettings?.model ?? null,
+      findings: args.findings,
+      evaluatedCount: 0,
+      suppressedFindingsCount: 0,
+      suppressedByReason: emptySuppressedByReason(),
+      shadowSuppressedFindingsCount: 0,
+      shadowSuppressedByReason: emptySuppressedByReason(),
