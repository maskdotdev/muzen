+                provider="openai_compatible",
+                model="gpt-5",
+                secret_ref="vault://workspaces/acme/models/default",
+                base_url="https://models.example.test",
+                routing={"region": "us-east"},
+            ),
+        )
+        loaded_model = await workspace.models.get("default")
