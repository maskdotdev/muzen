+  }))
+
+  const mod = await import(
+    `@/components/onboarding/hooks/use-onboarding-flow-controller.ts?cacheBust=${Math.random()
+      .toString(36)
+      .slice(2)}`,
+  )
+
+  return { mod, router }
+}
+
+const createState = () => ({
+  gitlabInstance: "https://gitlab.com",
+  setGitlabInstance: noop,
+  customInstance: "https://",
+  setCustomInstance: noop,
+  instanceTokens: {},
+  setInstanceTokens: noop,
+  token: "token",
+  setToken: noop,
+  projects: [] as Array<{ id: string }>,
+  setProjects: noop,
+  projectsError: "",
+  setProjectsError: noop,
+  selectedProjectId: "",
+  setSelectedProjectId: noop,
