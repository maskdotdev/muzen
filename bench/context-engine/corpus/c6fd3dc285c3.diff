+      tokenCacheHash: "hash-1",
+      projectsCacheKey: "https://gitlab.com::hash-1",
+      trackEvent: noop,
+      callGitLab: mock(async () => []),
+      validateToken: mock(async () => undefined),
+      mergeRequestsQueryKey: mock(() => ["onboarding", "merge-requests", "", "", 5] as const),
+      fetchProjects: mock(async () => []),
+      applyLoadedProjects: noop,
+      preloadProjectsForContinue: noop,
+      loadProjects: deps.loadProjects,
+      loadMergeRequests: mock(async () => undefined),
+      handleTokenSubmit: mock(async () => undefined),
+      handleInstanceChange: noop,
+      handleTokenChange: noop,
