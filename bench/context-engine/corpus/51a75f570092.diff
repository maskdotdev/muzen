@@ -0,0 +1,122 @@
+import { describe, expect, mock, test } from 'bun:test'
+
+type LoggerContext = Record<string, unknown>
+
+type ApiLogHandlerArgs = {
+  logger: {
+    set: (context: LoggerContext) => void
+  }
+  requestId: string
+}
+
+type ApiLogHandlerResult = {
+  response: Response
+  status: number
+  outcome?: string
+}
+
+type RunWithApiRequestLogArgs = {
+  request: Request
+  path: string
+  event: string
+  handler: (args: ApiLogHandlerArgs) => Promise<ApiLogHandlerResult>
+}
+
+const loadRouteModule = async (options?: { authorized?: boolean }) => {
+  const loggerContext: LoggerContext = {}
+  const runWithApiRequestLog = mock(async ({ handler }: RunWithApiRequestLogArgs) => {
+    const logger = {
+      set: (context: LoggerContext) => {
+        Object.assign(loggerContext, context)
+      },
+    }
+
+    const result = await handler({ logger, requestId: 'req_1' })
+    return result.response
+  })
+
+  const secureCompare = mock(() => options?.authorized ?? true)
+  const cleanupIndexArtifacts = mock(async () => ({
+    lock: 'acquired' as const,
+    scannedRuns: 4,
+    trackedRuns: 4,
+    deletedRuns: 2,
+  }))
+
+  mock.module('@/lib/utils/logger', () => ({ runWithApiRequestLog }))
+  mock.module('@/lib/gitlab/crypto', () => ({ secureCompare }))
+  mock.module('@/lib/gitlab/env', () => ({ gitlabEnv: { internalRunnerKey: 'runner-key' } }))
+  mock.module('@/lib/indexing/artifact-retention', () => ({ cleanupIndexArtifacts }))
+
+  const routeModule = await import(`./route?cacheBust=${Math.random().toString(36).slice(2)}`)
+
+  return {
+    POST: routeModule.POST as (request: Request) => Promise<Response>,
+    cleanupIndexArtifacts,
+    loggerContext,
+  }
+}
+
+describe('internal indexing cleanup route', () => {
+  test('returns 401 when internal runner auth fails', async () => {
+    const { POST, cleanupIndexArtifacts } = await loadRouteModule({ authorized: false })
+
+    const response = await POST(
+      new Request('http://localhost/api/internal/indexing/cleanup', {
+        method: 'POST',
+        headers: {
+          'content-type': 'application/json',
+          'x-internal-runner-key': 'wrong',
+        },
+        body: JSON.stringify({}),
+      }),
+    )
+
+    const body = await response.json()
+
+    expect(response.status).toBe(401)
+    expect(body).toEqual({ error: 'Unauthorized' })
+    expect(cleanupIndexArtifacts).toHaveBeenCalledTimes(0)
+  })
+
+  test('returns cleanup summary for authorized requests', async () => {
+    const { POST, cleanupIndexArtifacts, loggerContext } = await loadRouteModule({
+      authorized: true,
+    })
+
+    const response = await POST(
+      new Request('http://localhost/api/internal/indexing/cleanup', {
+        method: 'POST',
+        headers: {
+          'content-type': 'application/json',
+          'x-internal-runner-key': 'runner-key',
+        },
+        body: JSON.stringify({
+          readyKeepPerBranch: 2,
+          deleteLimit: 20,
+        }),
+      }),
+    )
+
+    const body = await response.json()
+
+    expect(response.status).toBe(200)
+    expect(cleanupIndexArtifacts).toHaveBeenCalledWith({
+      readyKeepPerBranch: 2,
+      deleteLimit: 20,
+    })
+    expect(body).toEqual({
+      data: {
+        lock: 'acquired',
+        scannedRuns: 4,
+        trackedRuns: 4,
+        deletedRuns: 2,
+      },
+    })
+    expect(loggerContext).toMatchObject({
+      summary: {
+        deletedRuns: 2,
+      },
+    })
+  })
+})
diff --git a/src/app/api/internal/indexing/cleanup/route.ts b/src/app/api/internal/indexing/cleanup/route.ts
new file mode 100644
index 00000000..3da9d718
--- /dev/null
+++ b/src/app/api/internal/indexing/cleanup/route.ts
@@ -0,0 +1,63 @@
+import { NextResponse } from 'next/server'
+import { z } from 'zod'
+
+import { secureCompare } from '@/lib/gitlab/crypto'
+import { gitlabEnv } from '@/lib/gitlab/env'
+import { cleanupIndexArtifacts } from '@/lib/indexing/artifact-retention'
+import { runWithApiRequestLog } from '@/lib/utils/logger'
+
+const cleanupPayloadSchema = z.object({
+  readyKeepPerBranch: z.number().int().positive().max(100).optional(),
+  failedRetentionDays: z.number().int().positive().max(3650).optional(),
+  supersededRetentionDays: z.number().int().positive().max(3650).optional(),
+  maxTotalBytes: z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER).optional(),
+  runScanLimit: z.number().int().positive().max(20_000).optional(),
+  deleteLimit: z.number().int().positive().max(2_000).optional(),
+})
+
+const isAuthorizedRunnerRequest = (request: Request) => {
+  const headerValue = request.headers.get('x-internal-runner-key')
+  if (!headerValue) {
+    return false
+  }
+
+  return secureCompare(headerValue, gitlabEnv.internalRunnerKey)
+}
+
+export async function POST(request: Request) {
+  return runWithApiRequestLog({
+    request,
+    path: '/api/internal/indexing/cleanup',
+    event: 'api.indexing.cleanup',
+    handler: async ({ logger }) => {
+      if (!isAuthorizedRunnerRequest(request)) {
+        return {
+          status: 401,
+          outcome: 'unauthorized',
+          response: NextResponse.json({ error: 'Unauthorized' }, { status: 401 }),
+        }
+      }
+
+      const payload = await request.json().catch(() => ({}))
+      const parsed = cleanupPayloadSchema.safeParse(payload)
+      if (!parsed.success) {
+        return {
+          status: 400,
+          outcome: 'invalid_request',
+          response: NextResponse.json({ error: 'Invalid cleanup payload.' }, { status: 400 }),
+        }
+      }
+
+      const summary = await cleanupIndexArtifacts(parsed.data)
+      logger.set({
+        summary,
+      })
+
+      return {
+        status: 200,
+        outcome: 'success',
+        response: NextResponse.json({ data: summary }),
+      }
+    },
+  })
+}
diff --git a/src/lib/indexing/artifact-retention.ts b/src/lib/indexing/artifact-retention.ts
new file mode 100644
index 00000000..772e6510
--- /dev/null
+++ b/src/lib/indexing/artifact-retention.ts
@@ -0,0 +1,359 @@
+import { desc, eq, inArray, isNotNull } from 'drizzle-orm'
+
+import { db } from '@/lib/db'
+import { indexBranchStates, indexRuns } from '@/lib/db/schema'
+import {
+  createArtifactCleanupStore,
+  type ArtifactCleanupStore,
+} from '@/lib/indexing/stores/artifact-cleanup-store'
+
+const RUN_STATUSES_WITH_ARTIFACTS = ['ready', 'failed', 'superseded'] as const
+const PENDING_ARTIFACTS_PREFIX = 'pending'
+const PRUNED_ARTIFACTS_PREFIX = 'pruned:'
+
+const ONE_DAY_MS = 24 * 60 * 60 * 1000
+const DEFAULT_READY_KEEP_PER_BRANCH = 3
+const DEFAULT_FAILED_RETENTION_DAYS = 14
+const DEFAULT_SUPERSEDED_RETENTION_DAYS = 3
+const DEFAULT_MAX_TOTAL_BYTES = 10 * 1024 * 1024 * 1024
+const DEFAULT_RUN_SCAN_LIMIT = 1_000
+const DEFAULT_DELETE_LIMIT = 200
+
+type CompletedRunStatus = (typeof RUN_STATUSES_WITH_ARTIFACTS)[number]
+
+type CompletedRun = {
+  id: string
+  branchStateId: string
+  status: CompletedRunStatus
+  artifactsPrefix: string
+  createdAt: Date
+  updatedAt: Date
+}
+
+type CleanupReason = 'ready_count' | 'failed_age' | 'superseded_age' | 'size_limit'
+
+type CleanupPolicy = {
+  readyKeepPerBranch: number
+  failedRetentionDays: number
+  supersededRetentionDays: number
+  maxTotalBytes: number
+  runScanLimit: number
+  deleteLimit: number
+}
+
+export type CleanupIndexArtifactsSummary = {
+  lock: 'acquired' | 'skipped'
+  policy: CleanupPolicy
+  scannedRuns: number
+  trackedRuns: number
+  protectedRuns: number
+  candidateRuns: number
+  skippedByDeleteLimit: number
+  deletedRuns: number
+  deletedBytes: number
+  deletedObjects: number
+  errors: number
+  totalBytesBefore: number | null
+  totalBytesAfter: number | null
+  reasons: Record<CleanupReason, number>
+}
+
+type CleanupIndexArtifactsOptions = {
+  readyKeepPerBranch?: number
+  failedRetentionDays?: number
+  supersededRetentionDays?: number
+  maxTotalBytes?: number
+  runScanLimit?: number
+  deleteLimit?: number
+}
+
+const parsePositiveInt = (value: string | undefined, fallback: number) => {
+  if (!value) {
+    return fallback
+  }
+
+  const parsed = Number.parseInt(value, 10)
+  if (!Number.isFinite(parsed) || parsed <= 0) {
+    return fallback
+  }
+
+  return parsed
+}
+
+const parseNonNegativeInt = (value: string | undefined, fallback: number) => {
+  if (!value) {
+    return fallback
+  }
+
+  const parsed = Number.parseInt(value, 10)
+  if (!Number.isFinite(parsed) || parsed < 0) {
+    return fallback
+  }
+
+  return parsed
+}
+
+const isPrunedPrefix = (prefix: string) => prefix.startsWith(PRUNED_ARTIFACTS_PREFIX)
+
+const resolvePolicy = (options: CleanupIndexArtifactsOptions): CleanupPolicy => ({
+  readyKeepPerBranch:
+    options.readyKeepPerBranch ??
+    parsePositiveInt(
+      process.env.INDEXER_ARTIFACT_RETENTION_READY_KEEP_PER_BRANCH,
+      DEFAULT_READY_KEEP_PER_BRANCH,
+    ),
+  failedRetentionDays:
+    options.failedRetentionDays ??
+    parsePositiveInt(
+      process.env.INDEXER_ARTIFACT_RETENTION_FAILED_DAYS,
+      DEFAULT_FAILED_RETENTION_DAYS,
+    ),
+  supersededRetentionDays:
+    options.supersededRetentionDays ??
+    parsePositiveInt(
+      process.env.INDEXER_ARTIFACT_RETENTION_SUPERSEDED_DAYS,
+      DEFAULT_SUPERSEDED_RETENTION_DAYS,
+    ),
+  maxTotalBytes:
+    options.maxTotalBytes ??
+    parseNonNegativeInt(
+      process.env.INDEXER_ARTIFACT_RETENTION_MAX_TOTAL_BYTES,
+      DEFAULT_MAX_TOTAL_BYTES,
+    ),
+  runScanLimit:
+    options.runScanLimit ??
+    parsePositiveInt(process.env.INDEXER_ARTIFACT_CLEANUP_RUN_SCAN_LIMIT, DEFAULT_RUN_SCAN_LIMIT),
+  deleteLimit:
+    options.deleteLimit ??
+    parsePositiveInt(process.env.INDEXER_ARTIFACT_CLEANUP_DELETE_LIMIT, DEFAULT_DELETE_LIMIT),
+})
+
+const createEmptyReasons = (): Record<CleanupReason, number> => ({
+  ready_count: 0,
+  failed_age: 0,
+  superseded_age: 0,
+  size_limit: 0,
+})
+
+const markRunArtifactsPruned = async (run: CompletedRun) => {
+  await db
+    .update(indexRuns)
+    .set({
+      artifactsPrefix: `${PRUNED_ARTIFACTS_PREFIX}${run.artifactsPrefix}`,
+      updatedAt: new Date(),
+    })
+    .where(eq(indexRuns.id, run.id))
+}
+
+let cleanupInProgress = false
+
+export const cleanupIndexArtifacts = async (
+  options: CleanupIndexArtifactsOptions = {},
+  deps: { cleanupStore?: ArtifactCleanupStore } = {},
+): Promise<CleanupIndexArtifactsSummary> => {
+  const policy = resolvePolicy(options)
+  const summary: CleanupIndexArtifactsSummary = {
+    lock: 'skipped',
+    policy,
+    scannedRuns: 0,
+    trackedRuns: 0,
+    protectedRuns: 0,
+    candidateRuns: 0,
+    skippedByDeleteLimit: 0,
+    deletedRuns: 0,
+    deletedBytes: 0,
+    deletedObjects: 0,
+    errors: 0,
+    totalBytesBefore: null,
+    totalBytesAfter: null,
+    reasons: createEmptyReasons(),
+  }
+
+  if (cleanupInProgress) {
+    return summary
+  }
+
+  cleanupInProgress = true
+  summary.lock = 'acquired'
+  const cleanupStore = deps.cleanupStore ?? createArtifactCleanupStore()
+
+  try {
+    const [servingPointers, completedRuns] = await Promise.all([
+      db
+        .select({
+          lastReadyRunId: indexBranchStates.lastReadyRunId,
+        })
+        .from(indexBranchStates)
+        .where(isNotNull(indexBranchStates.lastReadyRunId)),
+      db
+        .select({
+          id: indexRuns.id,
+          branchStateId: indexRuns.branchStateId,
+          status: indexRuns.status,
+          artifactsPrefix: indexRuns.artifactsPrefix,
+          createdAt: indexRuns.createdAt,
+          updatedAt: indexRuns.updatedAt,
+        })
+        .from(indexRuns)
+        .where(inArray(indexRuns.status, RUN_STATUSES_WITH_ARTIFACTS))
+        .orderBy(desc(indexRuns.updatedAt))
+        .limit(policy.runScanLimit),
+    ])
+
+    summary.scannedRuns = completedRuns.length
+
+    const trackedRuns = completedRuns.filter((run) => {
+      const prefix = run.artifactsPrefix.trim()
+      if (!prefix) {
+        return false
+      }
+
+      return prefix !== PENDING_ARTIFACTS_PREFIX && !isPrunedPrefix(prefix)
+    })
+    summary.trackedRuns = trackedRuns.length
+
+    const protectedRunIds = new Set(
+      servingPointers.flatMap((pointer) =>
+        typeof pointer.lastReadyRunId === 'string' && pointer.lastReadyRunId.length > 0
+          ? [pointer.lastReadyRunId]
+          : [],
+      ),
+    )
+
+    const readyRunsByBranch = new Map<string, CompletedRun[]>()
+    for (const run of trackedRuns) {
+      if (run.status !== 'ready') {
+        continue
+      }
+
+      const bucket = readyRunsByBranch.get(run.branchStateId)
+      if (bucket) {
+        bucket.push(run)
+      } else {
+        readyRunsByBranch.set(run.branchStateId, [run])
+      }
+    }
+
+    for (const runs of readyRunsByBranch.values()) {
+      runs
+        .slice()
+        .sort((left, right) => right.updatedAt.getTime() - left.updatedAt.getTime())
+        .slice(0, policy.readyKeepPerBranch)
+        .forEach((run) => {
+          protectedRunIds.add(run.id)
+        })
+    }
+
+    summary.protectedRuns = protectedRunIds.size
+
+    const failedCutoffMs = Date.now() - policy.failedRetentionDays * ONE_DAY_MS
+    const supersededCutoffMs = Date.now() - policy.supersededRetentionDays * ONE_DAY_MS
+    const candidates = new Map<string, { run: CompletedRun; reason: CleanupReason }>()
+
+    for (const run of trackedRuns) {
+      if (protectedRunIds.has(run.id)) {
+        continue
+      }
+
+      if (run.status === 'ready') {
+        candidates.set(run.id, {
+          run,
+          reason: 'ready_count',
+        })
+        continue
+      }
+
+      if (run.status === 'failed' && run.updatedAt.getTime() <= failedCutoffMs) {
+        candidates.set(run.id, {
+          run,
+          reason: 'failed_age',
+        })
+        continue
+      }
+
+      if (run.status === 'superseded' && run.updatedAt.getTime() <= supersededCutoffMs) {
+        candidates.set(run.id, {
+          run,
+          reason: 'superseded_age',
+        })
+      }
+    }
+
+    const sizesByRunId = new Map<string, number>()
+    if (policy.maxTotalBytes > 0) {
+      for (const run of trackedRuns) {
+        try {
+          const details = await cleanupStore.describePrefix({
+            artifactsPrefix: run.artifactsPrefix,
+          })
+          sizesByRunId.set(run.id, Math.max(0, details.bytes))
+        } catch {
+          sizesByRunId.set(run.id, 0)
+          summary.errors += 1
+        }
+      }
+
+      const totalBytesBefore = trackedRuns.reduce(
+        (acc, run) => acc + (sizesByRunId.get(run.id) ?? 0),
+        0,
+      )
+      summary.totalBytesBefore = totalBytesBefore
+
+      let projectedBytesAfter = totalBytesBefore
+      for (const candidate of candidates.values()) {
+        projectedBytesAfter -= sizesByRunId.get(candidate.run.id) ?? 0
+      }
+
+      if (projectedBytesAfter > policy.maxTotalBytes) {
+        const overflowCandidates = trackedRuns
+          .filter((run) => !protectedRunIds.has(run.id) && !candidates.has(run.id))
+          .sort((left, right) => left.updatedAt.getTime() - right.updatedAt.getTime())
+
+        for (const run of overflowCandidates) {
+          candidates.set(run.id, {
+            run,
+            reason: 'size_limit',
+          })
+          projectedBytesAfter -= sizesByRunId.get(run.id) ?? 0
+          if (projectedBytesAfter <= policy.maxTotalBytes) {
+            break
+          }
+        }
+      }
+    }
+
+    const orderedCandidates = [...candidates.values()].sort(
+      (left, right) => left.run.updatedAt.getTime() - right.run.updatedAt.getTime(),
+    )
+    summary.candidateRuns = orderedCandidates.length
+
+    const selectedCandidates = orderedCandidates.slice(0, policy.deleteLimit)
+    summary.skippedByDeleteLimit = Math.max(0, orderedCandidates.length - selectedCandidates.length)
+
+    for (const candidate of selectedCandidates) {
+      summary.reasons[candidate.reason] += 1
+
+      try {
+        const deleted = await cleanupStore.deletePrefix({
+          artifactsPrefix: candidate.run.artifactsPrefix,
+        })
+
+        await markRunArtifactsPruned(candidate.run)
+
+        summary.deletedRuns += 1
+        summary.deletedBytes += deleted.bytes
+        summary.deletedObjects += deleted.objects
+      } catch {
+        summary.errors += 1
+      }
+    }
+
+    if (summary.totalBytesBefore !== null) {
+      summary.totalBytesAfter = Math.max(0, summary.totalBytesBefore - summary.deletedBytes)
+    }
+
+    return summary
+  } finally {
+    cleanupInProgress = false
+  }
+}
