index 00000000..59d48c25
--- /dev/null
+++ b/src/lib/indexing/stores/artifact-cleanup-store.ts
@@ -0,0 +1,28 @@
+import { createFsArtifactStore } from '@/lib/indexing/stores/artifact-store.fs'
+import { createS3ArtifactStore } from '@/lib/indexing/stores/artifact-store.s3'
+
+export type ArtifactCleanupDetails = {
+  bytes: number
+  objects: number
+}
+
+export interface ArtifactCleanupStore {
+  describePrefix(args: {
+    artifactsPrefix: string
+  }): Promise<ArtifactCleanupDetails>
+
+  deletePrefix(args: {
+    artifactsPrefix: string
+  }): Promise<ArtifactCleanupDetails>
+}
+
+const resolveBackend = () => process.env.INDEXER_ARTIFACTS_BACKEND?.trim().toLowerCase() || 'fs'
+
+export const createArtifactCleanupStore = (): ArtifactCleanupStore => {
+  const backend = resolveBackend()
+  if (backend === 's3') {
+    return createS3ArtifactStore()
+  }
+
+  return createFsArtifactStore()
+}
