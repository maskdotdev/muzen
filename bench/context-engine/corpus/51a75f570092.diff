diff --git a/src/lib/indexing/tests/artifact-retention.test.ts b/src/lib/indexing/tests/artifact-retention.test.ts
new file mode 100644
index 00000000..7673ab54
--- /dev/null
+++ b/src/lib/indexing/tests/artifact-retention.test.ts
@@ -0,0 +1,225 @@
+import { describe, expect, mock, test } from 'bun:test'
+
+type CompletedRun = {
+  id: string
+  branchStateId: string
+  status: 'ready' | 'failed' | 'superseded'
+  artifactsPrefix: string
+  createdAt: Date
+  updatedAt: Date
+}
+
+const loadModule = async (args: {
+  servingPointers: Array<{ lastReadyRunId: string | null }>
+  completedRuns: CompletedRun[]
+  deletePrefix?: (args: { artifactsPrefix: string }) => Promise<{ bytes: number; objects: number }>
+}) => {
+  let selectCall = 0
+  const select = mock(() => {
+    selectCall += 1
+
+    if (selectCall === 1) {
+      return {
+        from: () => ({
+          where: () => Promise.resolve(args.servingPointers),
+        }),
+      }
+    }
+
+    return {
+      from: () => ({
+        where: () => ({
+          orderBy: () => ({
+            limit: () => Promise.resolve(args.completedRuns),
+          }),
+        }),
+      }),
+    }
+  })
+
+  const updateSets: Array<Record<string, unknown>> = []
+  const update = mock(() => ({
+    set: (values: Record<string, unknown>) => {
+      updateSets.push(values)
+      return {
+        where: () => Promise.resolve([]),
+      }
+    },
+  }))
+
+  const db = {
+    select,
+    update,
+  }
+
+  const deletePrefix = mock(
+    args.deletePrefix ??
+      (async ({ artifactsPrefix }: { artifactsPrefix: string }) => ({
+        bytes: artifactsPrefix.length,
+        objects: 1,
+      })),
+  )
+
+  mock.module('@/lib/db', () => ({ db }))
+
+  const mod = await import(`@/lib/indexing/artifact-retention.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+
+  return {
+    cleanupIndexArtifacts: mod.cleanupIndexArtifacts as (
+      options?: {
+        readyKeepPerBranch?: number
+        failedRetentionDays?: number
+        supersededRetentionDays?: number
+        maxTotalBytes?: number
+        runScanLimit?: number
+        deleteLimit?: number
+      },
+      deps?: {
+        cleanupStore?: {
+          describePrefix: (args: { artifactsPrefix: string }) => Promise<{ bytes: number; objects: number }>
+          deletePrefix: (args: { artifactsPrefix: string }) => Promise<{ bytes: number; objects: number }>
+        }
+      },
+    ) => Promise<{
+      lock: 'acquired' | 'skipped'
+      deletedRuns: number
+      trackedRuns: number
+      reasons: Record<'ready_count' | 'failed_age' | 'superseded_age' | 'size_limit', number>
+    }>,
+    deletePrefix,
+    updateSets,
+  }
+}
+
+describe('cleanupIndexArtifacts', () => {
+  test('prunes old failed/superseded and extra ready artifacts while protecting serving run', async () => {
+    const now = Date.now()
+    const recent = new Date(now - 2 * 60 * 60 * 1000)
+    const oldFailed = new Date(now - 20 * 24 * 60 * 60 * 1000)
+    const oldSuperseded = new Date(now - 10 * 24 * 60 * 60 * 1000)
+
+    const { cleanupIndexArtifacts, deletePrefix, updateSets } = await loadModule({
+      servingPointers: [{ lastReadyRunId: 'run-ready-1' }],
+      completedRuns: [
+        {
+          id: 'run-ready-1',
+          branchStateId: 'branch-1',
+          status: 'ready',
+          artifactsPrefix: 'integrations/i/runs/default/main/head-a/run-ready-1',
+          createdAt: recent,
+          updatedAt: recent,
+        },
+        {
+          id: 'run-ready-2',
+          branchStateId: 'branch-1',
+          status: 'ready',
+          artifactsPrefix: 'integrations/i/runs/default/main/head-b/run-ready-2',
+          createdAt: oldSuperseded,
+          updatedAt: oldSuperseded,
+        },
+        {
+          id: 'run-failed-old',
+          branchStateId: 'branch-2',
+          status: 'failed',
+          artifactsPrefix: 'integrations/i/runs/default/release/head-c/run-failed-old',
+          createdAt: oldFailed,
+          updatedAt: oldFailed,
+        },
+        {
+          id: 'run-failed-recent',
+          branchStateId: 'branch-2',
+          status: 'failed',
+          artifactsPrefix: 'integrations/i/runs/default/release/head-d/run-failed-recent',
+          createdAt: recent,
+          updatedAt: recent,
+        },
+        {
+          id: 'run-superseded-old',
+          branchStateId: 'branch-2',
+          status: 'superseded',
+          artifactsPrefix: 'integrations/i/runs/default/release/head-e/run-superseded-old',
+          createdAt: oldSuperseded,
+          updatedAt: oldSuperseded,
+        },
+      ],
+    })
+
+    const summary = await cleanupIndexArtifacts(
+      {
+        readyKeepPerBranch: 1,
+        failedRetentionDays: 7,
+        supersededRetentionDays: 3,
+        maxTotalBytes: 0,
+        runScanLimit: 100,
+        deleteLimit: 10,
+      },
+      {
+        cleanupStore: {
+          describePrefix: async () => ({ bytes: 0, objects: 0 }),
+          deletePrefix,
+        },
+      },
+    )
+
+    expect(summary.lock).toBe('acquired')
+    expect(summary.trackedRuns).toBe(5)
+    expect(summary.deletedRuns).toBe(3)
+    expect(summary.reasons).toEqual({
+      ready_count: 1,
+      failed_age: 1,
+      superseded_age: 1,
+      size_limit: 0,
+    })
+    expect(deletePrefix).toHaveBeenCalledTimes(3)
+    expect(updateSets).toHaveLength(3)
+    expect(updateSets.every((entry) => String(entry.artifactsPrefix).startsWith('pruned:'))).toBe(
+      true,
+    )
+  })
+
+  test('returns skipped when cleanup is already in progress', async () => {
+    let resolveDescribe: ((value: { bytes: number; objects: number }) => void) | null = null
+    const blockedDescribe = () =>
+      new Promise<{ bytes: number; objects: number }>((resolve) => {
+        resolveDescribe = resolve
+      })
+
+    const old = new Date(Date.now() - 2 * 24 * 60 * 60 * 1000)
+    const { cleanupIndexArtifacts, updateSets } = await loadModule({
+      servingPointers: [],
+      completedRuns: [
+        {
+          id: 'run-ready-1',
+          branchStateId: 'branch-1',
+          status: 'ready',
+          artifactsPrefix: 'integrations/i/runs/default/main/head-x/run-ready-1',
+          createdAt: old,
+          updatedAt: old,
+        },
+      ],
+    })
+
+    const firstCleanupPromise = cleanupIndexArtifacts({
+      maxTotalBytes: 1,
+    }, {
+      cleanupStore: {
+        describePrefix: blockedDescribe,
+        deletePrefix: async () => ({ bytes: 0, objects: 0 }),
+      },
+    })
+    await Promise.resolve()
+
+    const secondSummary = await cleanupIndexArtifacts({
+      maxTotalBytes: 1,
+    })
+
+    expect(secondSummary.lock).toBe('skipped')
+    expect(secondSummary.deletedRuns).toBe(0)
+
+    resolveDescribe?.({ bytes: 123, objects: 1 })
+    const firstSummary = await firstCleanupPromise
+
+    expect(firstSummary.lock).toBe('acquired')
+    expect(updateSets).toHaveLength(0)
+  })
+})
