+CREATE EXTENSION IF NOT EXISTS vector;--> statement-breakpoint
+CREATE TABLE "index_vectors" (
+	"id" uuid PRIMARY KEY DEFAULT gen_random_uuid() NOT NULL,
+	"branch_state_id" uuid NOT NULL,
+	"run_id" uuid NOT NULL,
+	"path" text NOT NULL,
+	"file_id" text NOT NULL,
+	"chunk_index" integer NOT NULL,
+	"chunk_id" text NOT NULL,
+	"content" text NOT NULL,
+	"embedding" vector(1536) NOT NULL,
+	"metadata" jsonb,
+	"created_at" timestamp with time zone DEFAULT now() NOT NULL,
+	"updated_at" timestamp with time zone DEFAULT now() NOT NULL,
+	CONSTRAINT "index_vectors_branch_path_file_chunk_uq" UNIQUE("branch_state_id","path","file_id","chunk_index")
+);
+--> statement-breakpoint
+ALTER TABLE "index_vectors" ADD CONSTRAINT "index_vectors_branch_state_id_index_branch_states_id_fk" FOREIGN KEY ("branch_state_id") REFERENCES "public"."index_branch_states"("id") ON DELETE cascade ON UPDATE no action;--> statement-breakpoint
