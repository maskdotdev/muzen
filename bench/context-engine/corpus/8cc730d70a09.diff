index 00000000..3e69d935
--- /dev/null
+++ b/src/lib/indexing/stores/vector-store.pg.ts
@@ -0,0 +1,146 @@
+import { and, eq, ne, sql } from 'drizzle-orm'
+
+import { db } from '@/lib/db'
+import { indexVectors } from '@/lib/db/schema'
+import { INDEX_VECTOR_DIMENSION } from '@/lib/indexing/constants'
+import type { VectorQueryCandidate, VectorStore } from '@/lib/indexing/contracts'
+
+const normalizeEmbedding = (embedding: number[]) => {
+  if (embedding.length !== INDEX_VECTOR_DIMENSION) {
+    throw new Error(
+      `Embedding dimension mismatch. Expected ${INDEX_VECTOR_DIMENSION}, received ${embedding.length}.`,
+    )
+  }
+
+  const values = embedding.map((value) => {
+    if (!Number.isFinite(value)) {
+      throw new Error('Embedding contains non-finite values.')
+    }
+    return Number(value.toFixed(8))
+  })
+
+  return `[${values.join(',')}]`
+}
+
+const parseCandidate = (row: Record<string, unknown>): VectorQueryCandidate => ({
+  path: String(row.path),
+  fileId: String(row.fileId),
+  runId: String(row.runId),
+  chunkIndex: Number(row.chunkIndex),
+  score: Number(row.score),
+  content: typeof row.content === 'string' ? row.content : '',
+})
+
+export class PostgresVectorStore implements VectorStore {
+  async upsertChunks(args: {
+    branchStateId: string
+    runId: string
+    path: string
+    fileId: string
+    chunks: Array<{
+      chunkIndex: number
+      chunkId: string
+      content: string
+      embedding: number[]
+      metadata: Record<string, unknown>
+    }>
+  }): Promise<void> {
+    if (args.chunks.length === 0) {
+      return
+    }
+
+    const now = new Date()
+
+    await db
+      .insert(indexVectors)
+      .values(
+        args.chunks.map((chunk) => ({
+          branchStateId: args.branchStateId,
+          runId: args.runId,
+          path: args.path,
+          fileId: args.fileId,
+          chunkIndex: chunk.chunkIndex,
+          chunkId: chunk.chunkId,
+          content: chunk.content,
+          embedding: chunk.embedding,
+          metadata: chunk.metadata,
+          createdAt: now,
+          updatedAt: now,
+        })),
+      )
+      .onConflictDoUpdate({
+        target: [
+          indexVectors.branchStateId,
+          indexVectors.path,
+          indexVectors.fileId,
+          indexVectors.chunkIndex,
+        ],
+        set: {
+          runId: args.runId,
+          chunkId: sql`excluded.chunk_id`,
+          content: sql`excluded.content`,
+          embedding: sql`excluded.embedding`,
+          metadata: sql`excluded.metadata`,
+          updatedAt: now,
+        },
+      })
+  }
+
+  async queryCandidates(args: {
+    branchStateId: string
+    embedding: number[]
+    limit: number
+    oversample?: number
+  }): Promise<VectorQueryCandidate[]> {
+    const oversample = Math.max(1, Math.floor(args.oversample ?? 5))
+    const limit = Math.max(1, Math.floor(args.limit))
+    const effectiveLimit = Math.min(1_000, limit * oversample)
+    const queryVector = normalizeEmbedding(args.embedding)
+
+    const result = await db.execute(sql`
+      select
+        ${indexVectors.path} as "path",
+        ${indexVectors.fileId} as "fileId",
+        ${indexVectors.runId} as "runId",
+        ${indexVectors.chunkIndex} as "chunkIndex",
+        (1 - (${indexVectors.embedding} <=> ${queryVector}::vector)) as "score",
+        ${indexVectors.content} as "content"
+      from ${indexVectors}
+      where ${indexVectors.branchStateId} = ${args.branchStateId}
+      order by ${indexVectors.embedding} <=> ${queryVector}::vector asc
+      limit ${effectiveLimit}
+    `)
+
+    return result.rows.map((raw) => parseCandidate(raw as Record<string, unknown>))
+  }
+
+  async deleteStaleByPath(args: {
+    branchStateId: string
+    path: string
+    keepFileId: string | null
+  }): Promise<void> {
+    if (args.keepFileId === null) {
+      await db
+        .delete(indexVectors)
+        .where(
+          and(
+            eq(indexVectors.branchStateId, args.branchStateId),
+            eq(indexVectors.path, args.path),
+          ),
+        )
+      return
+    }
+
+    await db
+      .delete(indexVectors)
+      .where(
+        and(
+          eq(indexVectors.branchStateId, args.branchStateId),
+          eq(indexVectors.path, args.path),
+          ne(indexVectors.fileId, args.keepFileId),
+        ),
+      )
+  }
+}
+
+export const createPostgresVectorStore = () => new PostgresVectorStore()
