+CREATE INDEX "index_vectors_branch_path_idx" ON "index_vectors" USING btree ("branch_state_id","path");--> statement-breakpoint
+CREATE INDEX "index_vectors_branch_file_idx" ON "index_vectors" USING btree ("branch_state_id","file_id");--> statement-breakpoint
+CREATE INDEX "index_vectors_run_id_idx" ON "index_vectors" USING btree ("run_id");--> statement-breakpoint
+CREATE INDEX "index_vectors_embedding_ivfflat_idx" ON "index_vectors" USING ivfflat ("embedding" vector_cosine_ops) WITH (lists = 100);
