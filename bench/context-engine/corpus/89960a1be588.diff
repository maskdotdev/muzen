+"use client"
+
+import { FormEvent, useEffect, useMemo, useRef, useState } from "react"
+import { useRouter } from "next/navigation"
+import {
+  IconArrowLeft,
+  IconCheck,
+  IconCloud,
+  IconGitMerge,
+  IconServer,
+} from "@tabler/icons-react"
+
+import { MergeRequestDiffViewer } from "@/components/merge-request-diff-viewer"
+import { Button } from "@/components/ui/button"
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
+import { Input } from "@/components/ui/input"
+import { Label } from "@/components/ui/label"
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select"
+
+export type OnboardingRouteStep = "tokens" | "projects" | "mrs"
+
+type Project = {
+  id: string
+  name: string
+  path: string
+  webUrl: string
+}
+
+type MergeRequest = {
+  id: string
+  iid: string
+  title: string
+  state: string
+  author: string
+  webUrl: string
+}
+
+type OnboardingSessionState = {
+  gitlabInstance: string
+  customInstance: string
+  token: string
+  projects: Project[]
+  selectedProjectId: string
+  mergeRequests: MergeRequest[]
+  selectedMergeRequestId: string
+}
+
+type OnboardingEventMetadata = {
+  instanceUrl?: string
+  selectedProjectCount?: number
+  projectId?: string
+  mergeRequestId?: string
+}
+
+const INSTANCE_PRESETS = ["https://gitlab.com", "https://gitlab.example.com", "custom"]
+const ONBOARDING_STORAGE_KEY = "argus-onboarding-selections-v2"
+
+const routeStepPosition: Record<OnboardingRouteStep, number> = {
+  tokens: 1,
+  projects: 2,
+  mrs: 3,
+}
+
+const resolveGitLabInstance = (instance: string, customValue: string) => {
+  const value = (instance === "custom" ? customValue : instance).trim()
+  if (!value) {
+    throw new Error("Please select or enter a GitLab instance.")
+  }
+  return value.replace(/\/+$/, "")
+}
+
+const readPersistedState = (): Partial<OnboardingSessionState> => {
+  const raw = window.sessionStorage.getItem(ONBOARDING_STORAGE_KEY)
+  if (!raw) {
+    return {}
+  }
+
+  try {
+    const parsed = JSON.parse(raw) as Partial<OnboardingSessionState>
+    return parsed && typeof parsed === "object" ? parsed : {}
+  } catch {
+    return {}
+  }
+}
+
+const isNonEmptyString = (value: unknown): value is string =>
+  typeof value === "string" && value.trim().length > 0
+
+export function OnboardingFlow({ routeStep }: { routeStep: OnboardingRouteStep }) {
+  const router = useRouter()
+  const currentStep = routeStepPosition[routeStep]
+  const startedEventTracked = useRef(false)
+  const completionEventTracked = useRef(false)
+
+  const [isHydrated, setIsHydrated] = useState(false)
+
+  const [gitlabInstance, setGitlabInstance] = useState(INSTANCE_PRESETS[0])
+  const [customInstance, setCustomInstance] = useState("https://")
+  const [token, setToken] = useState("")
+  const [projects, setProjects] = useState<Project[]>([])
+  const [projectsError, setProjectsError] = useState("")
+  const [selectedProjectId, setSelectedProjectId] = useState("")
+
+  const [mergeRequests, setMergeRequests] = useState<MergeRequest[]>([])
+  const [mergeRequestsError, setMergeRequestsError] = useState("")
+  const [selectedMergeRequestId, setSelectedMergeRequestId] = useState("")
+  const [actionBusy, setActionBusy] = useState(false)
+
+  const selectedProject = projects.find((project) => project.id === selectedProjectId)
+  const selectedMergeRequest = mergeRequests.find((mr) => mr.id === selectedMergeRequestId)
+
+  const canLoadProjects = useMemo(
+    () =>
+      token.trim().length > 0 &&
+      (gitlabInstance === "custom"
+        ? customInstance.trim().length > 0
+        : gitlabInstance.trim().length > 0),
+    [token, gitlabInstance, customInstance],
+  )
+  const resolvedGitLabInstance = useMemo(() => {
+    if (!token.trim()) {
+      return ""
+    }
+
+    try {
+      return resolveGitLabInstance(gitlabInstance, customInstance)
+    } catch {
+      return ""
+    }
+  }, [token, gitlabInstance, customInstance])
+
+  const trackEvent = async (
+    event:
+      | "onboarding_started"
+      | "onboarding_token_validated"
+      | "onboarding_projects_selected"
+      | "onboarding_completed",
+    metadata?: OnboardingEventMetadata,
+  ) => {
+    await fetch("/api/onboarding/track", {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+      },
+      body: JSON.stringify({ event, metadata }),
+    }).catch(() => null)
+  }
+
+  const getErrorMessage = (value: unknown) => {
+    if (typeof value === "string") {
+      return value
+    }
+    if (value && typeof value === "object" && "error" in value) {
+      return String((value as { error?: string }).error)
+    }
+    return "Something went wrong."
+  }
+
+  const callGitLab = async (
+    action: "projects" | "merge-requests",
+    projectId?: string,
+  ) => {
+    const normalizedInstance = resolveGitLabInstance(gitlabInstance, customInstance)
+    const response = await fetch("/api/gitlab", {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+      },
+      body: JSON.stringify({
+        action,
+        instanceUrl: normalizedInstance,
+        token,
+        ...(projectId ? { projectId } : {}),
+      }),
+    })
+
+    const payload = await response.json()
+    if (!response.ok) {
+      throw new Error(getErrorMessage(payload))
+    }
+
+    if (!Array.isArray(payload.data)) {
+      throw new Error("Unexpected response from server.")
+    }
+
+    return payload.data
+  }
+
+  const loadProjects = async () => {
+    setActionBusy(true)
+    setProjectsError("")
+    setMergeRequestsError("")
+
+    try {
+      const data = (await callGitLab("projects")) as Project[]
+      setProjects(data)
+      setSelectedProjectId("")
+      setMergeRequests([])
+      setSelectedMergeRequestId("")
+      await trackEvent("onboarding_token_validated", {
+        instanceUrl: resolveGitLabInstance(gitlabInstance, customInstance),
+      })
+      return true
+    } catch (error) {
+      setProjectsError(getErrorMessage(error))
+      return false
+    } finally {
+      setActionBusy(false)
+    }
+  }
+
+  const loadMergeRequests = async (projectId: string) => {
+    setActionBusy(true)
+    setMergeRequestsError("")
+
+    try {
+      const data = (await callGitLab("merge-requests", projectId)) as MergeRequest[]
+      setMergeRequests(data)
+      setSelectedMergeRequestId("")
+      await trackEvent("onboarding_projects_selected", {
+        selectedProjectCount: projects.length,
+        projectId,
+      })
+      router.push("/onboarding/mrs")
+    } catch (error) {
+      setMergeRequestsError(getErrorMessage(error))
+    } finally {
+      setActionBusy(false)
+    }
+  }
+
+  const handleTokenSubmit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault()
+    const success = await loadProjects()
+    if (success) {
+      router.push("/onboarding/projects")
+    }
+  }
+
+  const handleProjectSelection = async (projectId: string) => {
+    setSelectedProjectId(projectId)
+    await loadMergeRequests(projectId)
+  }
+
+  const handleMergeRequestSelection = (mrId: string) => {
+    setSelectedMergeRequestId(mrId)
+    if (!completionEventTracked.current) {
+      completionEventTracked.current = true
+      void trackEvent("onboarding_completed", {
+        projectId: selectedProjectId,
+        mergeRequestId: mrId,
+      })
+    }
+  }
+
+  useEffect(() => {
+    const persisted = readPersistedState()
+    if (isNonEmptyString(persisted.gitlabInstance)) {
+      setGitlabInstance(persisted.gitlabInstance)
+    }
+    if (isNonEmptyString(persisted.customInstance)) {
+      setCustomInstance(persisted.customInstance)
+    }
+    if (isNonEmptyString(persisted.token)) {
+      setToken(persisted.token)
+    }
+    if (Array.isArray(persisted.projects)) {
+      setProjects(persisted.projects as Project[])
+    }
+    if (isNonEmptyString(persisted.selectedProjectId)) {
+      setSelectedProjectId(persisted.selectedProjectId)
+    }
+    if (Array.isArray(persisted.mergeRequests)) {
+      setMergeRequests(persisted.mergeRequests as MergeRequest[])
+    }
+    if (isNonEmptyString(persisted.selectedMergeRequestId)) {
+      setSelectedMergeRequestId(persisted.selectedMergeRequestId)
+    }
+    setIsHydrated(true)
+  }, [])
+
+  useEffect(() => {
+    if (!isHydrated) {
+      return
+    }
+    window.sessionStorage.setItem(
+      ONBOARDING_STORAGE_KEY,
+      JSON.stringify({
+        gitlabInstance,
+        customInstance,
+        token,
+        projects,
+        selectedProjectId,
+        mergeRequests,
+        selectedMergeRequestId,
+      } satisfies OnboardingSessionState),
+    )
+  }, [
+    isHydrated,
+    gitlabInstance,
+    customInstance,
+    token,
+    projects,
+    selectedProjectId,
+    mergeRequests,
+    selectedMergeRequestId,
+  ])
+
+  useEffect(() => {
+    if (!isHydrated) {
+      return
+    }
+    if (routeStep !== "tokens") {
+      return
+    }
+    if (startedEventTracked.current) {
+      return
+    }
+
+    startedEventTracked.current = true
+    void trackEvent("onboarding_started")
+  }, [isHydrated, routeStep])
+
+  useEffect(() => {
+    if (!isHydrated) {
+      return
+    }
+
+    if (routeStep === "projects" && !token.trim()) {
+      router.replace("/onboarding/tokens")
+      return
+    }
+
+    if (routeStep === "mrs" && !selectedProjectId) {
+      router.replace("/onboarding/projects")
+    }
+  }, [isHydrated, routeStep, token, selectedProjectId, router])
+
+  const renderHeader = (title: string, description: string) => (
+    <section className="flex flex-wrap items-start justify-between gap-3">
+      <div>
+        <h1 className="text-2xl font-semibold">{title}</h1>
+        <p className="text-sm text-muted-foreground">{description}</p>
+      </div>
+      <div className="flex items-center gap-2 text-sm text-muted-foreground">
+        <IconCheck className="size-4 text-primary" />
+        <span>Step {currentStep} of 3</span>
+      </div>
+    </section>
+  )
+
+  if (routeStep === "tokens") {
+    return (
+      <div className="space-y-4">
+        {renderHeader(
+          "Onboarding · Tokens",
+          "Connect GitLab and preload projects to continue.",
+        )}
+
+        <Card>
+          <CardHeader>
+            <CardTitle className="flex items-center gap-2">
+              <IconServer />
+              1) GitLab instance + token
+            </CardTitle>
+            <CardDescription>
+              Choose your GitLab instance and provide a personal access token.
+            </CardDescription>
+          </CardHeader>
+          <CardContent>
+            <form onSubmit={handleTokenSubmit} className="grid gap-3">
+              <div className="grid gap-1">
+                <Label htmlFor="gitlab-instance">Instance</Label>
+                <Select value={gitlabInstance} onValueChange={setGitlabInstance}>
+                  <SelectTrigger className="w-full">
+                    <SelectValue placeholder="Select GitLab instance" />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {INSTANCE_PRESETS.map((instance) => (
+                      <SelectItem key={instance} value={instance}>
+                        {instance === "custom" ? "Custom URL" : instance}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+                {gitlabInstance === "custom" ? (
+                  <Input
+                    value={customInstance}
+                    onChange={(event) => setCustomInstance(event.target.value)}
+                    placeholder="https://gitlab.example.com"
+                  />
+                ) : null}
+              </div>
+              <div className="grid gap-1">
+                <Label htmlFor="gitlab-token">Personal access token</Label>
+                <Input
+                  id="gitlab-token"
+                  type="password"
+                  value={token}
+                  onChange={(event) => setToken(event.target.value)}
+                  placeholder="glpat-..."
+                />
+              </div>
+              {projectsError ? <p className="text-xs text-destructive">{projectsError}</p> : null}
+              <Button type="submit" disabled={actionBusy || !canLoadProjects}>
+                {actionBusy ? "Loading projects..." : "Continue to projects"}
+              </Button>
+            </form>
+          </CardContent>
+        </Card>
+      </div>
+    )
+  }
+
+  if (routeStep === "projects") {
+    return (
+      <div className="space-y-4">
+        {renderHeader(
+          "Onboarding · Projects",
+          "Choose one project and preload open merge requests.",
+        )}
+
+        <Card>
+          <CardHeader>
+            <CardTitle className="flex items-center gap-2">
+              <IconCloud />
+              1) Select project
+            </CardTitle>
+            <CardDescription>
+              Pick a project to continue to merge request selection.
+            </CardDescription>
+          </CardHeader>
+          <CardContent className="grid gap-3">
+            <div className="flex gap-2">
+              <Button variant="outline" onClick={() => router.push("/onboarding/tokens")}>
+                <IconArrowLeft />
+                Back to tokens
+              </Button>
+              <Button onClick={loadProjects} disabled={!canLoadProjects || actionBusy}>
+                {actionBusy ? "Loading projects..." : "Reload projects"}
+              </Button>
+            </div>
+
+            {projects.length > 0 ? (
+              <>
+                <Label htmlFor="project-select">Project</Label>
+                <Select value={selectedProjectId} onValueChange={handleProjectSelection}>
+                  <SelectTrigger id="project-select" className="w-full">
+                    <SelectValue placeholder="Select a project" />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {projects.map((project) => (
+                      <SelectItem key={project.id} value={project.id}>
+                        {project.name}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              </>
+            ) : (
+              <p className="text-sm text-muted-foreground">
+                No projects loaded yet. Use Reload projects to fetch them.
+              </p>
+            )}
+
+            {projectsError ? <p className="text-xs text-destructive">{projectsError}</p> : null}
+            {mergeRequestsError ? (
+              <p className="text-xs text-destructive">{mergeRequestsError}</p>
+            ) : null}
+          </CardContent>
+        </Card>
+      </div>
+    )
+  }
+
+  return (
+    <div className="space-y-4">
+      {renderHeader(
+        "Onboarding · Merge Requests",
+        "Choose a merge request to complete onboarding.",
+      )}
+
+      <Card>
+        <CardHeader>
+          <CardTitle className="flex items-center gap-2">
+            <IconGitMerge />
+            1) Select merge request
+          </CardTitle>
+          <CardDescription>
+            Choose one merge request from the selected project.
+          </CardDescription>
+        </CardHeader>
+        <CardContent className="grid gap-3">
+          <div className="flex gap-2">
+            <Button variant="outline" onClick={() => router.push("/onboarding/projects")}>
+              <IconArrowLeft />
+              Back to projects
+            </Button>
+            <Button
+              variant="outline"
+              onClick={() => selectedProjectId && loadMergeRequests(selectedProjectId)}
+              disabled={!selectedProjectId || actionBusy}
+            >
+              {actionBusy ? "Loading merge requests..." : "Reload merge requests"}
+            </Button>
+          </div>
+
+          {mergeRequests.length > 0 ? (
+            <>
+              <Label htmlFor="mr-select">Merge request</Label>
+              <Select value={selectedMergeRequestId} onValueChange={handleMergeRequestSelection}>
+                <SelectTrigger id="mr-select" className="w-full">
+                  <SelectValue placeholder="Select a merge request" />
+                </SelectTrigger>
+                <SelectContent>
+                  {mergeRequests.map((mr) => (
+                    <SelectItem key={mr.id} value={mr.id}>
+                      {`#${mr.iid} ${mr.title} — ${mr.state}`}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            </>
+          ) : (
+            <p className="text-sm text-muted-foreground">
+              No merge requests loaded yet. Reload from this page or pick another project.
+            </p>
+          )}
+
+          {selectedMergeRequest && (
+            <div className="rounded-md border p-3 text-sm">
+              <p className="font-medium">Selected: {selectedMergeRequest.title}</p>
+              <p className="text-xs text-muted-foreground">Author: {selectedMergeRequest.author}</p>
+              <p className="text-xs text-muted-foreground">IID: {selectedMergeRequest.iid}</p>
+              <a
+                href={selectedMergeRequest.webUrl}
+                target="_blank"
+                rel="noreferrer"
+                className="text-xs text-blue-600 underline"
+              >
+                Open MR in GitLab
+              </a>
+            </div>
+          )}
+
+          {mergeRequestsError ? (
+            <p className="text-xs text-destructive">{mergeRequestsError}</p>
+          ) : null}
+        </CardContent>
+      </Card>
+
+      {selectedProject && selectedMergeRequest ? (
+        <Card>
+          <CardHeader>
+            <CardTitle>Onboarding complete</CardTitle>
+            <CardDescription>
+              Your onboarding choices are captured. Review the live merge request diff below.
+            </CardDescription>
+          </CardHeader>
+          <CardContent className="space-y-2">
+            <p className="text-sm">Project: {selectedProject.path ?? selectedProject.name}</p>
+            <p className="text-sm">
+              Merge request: #{selectedMergeRequest.iid} {selectedMergeRequest.title}
+            </p>
+          </CardContent>
+        </Card>
+      ) : null}
+
+      {selectedProject && selectedMergeRequest && resolvedGitLabInstance ? (
+        <MergeRequestDiffViewer
+          instanceUrl={resolvedGitLabInstance}
+          token={token}
+          projectId={selectedProject.id}
+          mergeRequestIid={selectedMergeRequest.iid}
+        />
+      ) : null}
+    </div>
+  )
+}
