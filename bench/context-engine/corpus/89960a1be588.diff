diff --git a/src/components/merge-request-diff-viewer.tsx b/src/components/merge-request-diff-viewer.tsx
new file mode 100644
index 00000000..683336f5
--- /dev/null
+++ b/src/components/merge-request-diff-viewer.tsx
@@ -0,0 +1,388 @@
+"use client"
+
+import { parsePatchFiles, type FileDiffMetadata } from "@pierre/diffs"
+import { FileDiff, WorkerPoolContextProvider } from "@pierre/diffs/react"
+import { useCallback, useEffect, useMemo, useState } from "react"
+
+import { Badge } from "@/components/ui/badge"
+import { Button } from "@/components/ui/button"
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
+import { Input } from "@/components/ui/input"
+import { Label } from "@/components/ui/label"
+
+type DiffDataSource = "raw_diffs" | "changes"
+type DiffStyle = "split" | "unified"
+
+type MergeRequestDiffViewerProps = {
+  instanceUrl: string
+  token: string
+  projectId: string
+  mergeRequestIid: string
+}
+
+type DiffPayload = {
+  data?: {
+    patch?: unknown
+    source?: unknown
+  }
+  error?: unknown
+}
+
+const INITIAL_FILE_BATCH_SIZE = 12
+const FILE_BATCH_SIZE = 8
+const DIFF_CACHE_SIZE = 400
+const DEFAULT_WORKER_COUNT = 4
+
+const getErrorMessage = (value: unknown) => {
+  if (typeof value === "string") {
+    return value
+  }
+  if (value && typeof value === "object" && "error" in value) {
+    return String((value as { error?: string }).error)
+  }
+  return "Unable to load merge request diff."
+}
+
+const getFileLabel = (file: FileDiffMetadata) => {
+  if (file.prevName && file.prevName !== file.name) {
+    return `${file.prevName} -> ${file.name}`
+  }
+
+  return file.name
+}
+
+const getChangeTypeLabel = (type: FileDiffMetadata["type"]) => {
+  switch (type) {
+    case "new":
+      return "new"
+    case "deleted":
+      return "deleted"
+    case "rename-pure":
+      return "renamed"
+    case "rename-changed":
+      return "renamed+changed"
+    default:
+      return "changed"
+  }
+}
+
+const getChangeTypeBadgeVariant = (type: FileDiffMetadata["type"]) => {
+  switch (type) {
+    case "new":
+      return "secondary"
+    case "deleted":
+      return "destructive"
+    default:
+      return "outline"
+  }
+}
+
+export function MergeRequestDiffViewer({
+  instanceUrl,
+  token,
+  projectId,
+  mergeRequestIid,
+}: MergeRequestDiffViewerProps) {
+  const [isLoading, setIsLoading] = useState(false)
+  const [loadError, setLoadError] = useState("")
+  const [patchText, setPatchText] = useState("")
+  const [dataSource, setDataSource] = useState<DiffDataSource | null>(null)
+
+  const [filenameFilter, setFilenameFilter] = useState("")
+  const [diffStyle, setDiffStyle] = useState<DiffStyle>("split")
+  const [wrapLines, setWrapLines] = useState(false)
+  const [showLineNumbers, setShowLineNumbers] = useState(true)
+  const [visibleFileCount, setVisibleFileCount] = useState(INITIAL_FILE_BATCH_SIZE)
+
+  const loadDiff = useCallback(async () => {
+    setIsLoading(true)
+    setLoadError("")
+
+    try {
+      const response = await fetch("/api/gitlab", {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+        },
+        body: JSON.stringify({
+          action: "merge-request-diff",
+          instanceUrl,
+          token,
+          projectId,
+          mergeRequestIid,
+        }),
+      })
+
+      const payload = (await response.json().catch(() => null)) as DiffPayload | null
+      if (!response.ok) {
+        throw new Error(getErrorMessage(payload))
+      }
+
+      if (!payload?.data || typeof payload.data.patch !== "string") {
+        throw new Error("Unexpected diff response from server.")
+      }
+
+      const source = payload.data.source === "changes" ? "changes" : "raw_diffs"
+      setPatchText(payload.data.patch)
+      setDataSource(source)
+      setVisibleFileCount(INITIAL_FILE_BATCH_SIZE)
+    } catch (error) {
+      setPatchText("")
+      setDataSource(null)
+      setLoadError(getErrorMessage(error))
+    } finally {
+      setIsLoading(false)
+    }
+  }, [instanceUrl, token, projectId, mergeRequestIid])
+
+  useEffect(() => {
+    void loadDiff()
+  }, [loadDiff])
+
+  const parsedPatch = useMemo(() => {
+    if (!patchText) {
+      return { files: [] as FileDiffMetadata[], parseError: "" }
+    }
+
+    try {
+      const patches = parsePatchFiles(
+        patchText,
+        `mr-${projectId}-${mergeRequestIid}`,
+      )
+      const files = patches.flatMap((patch) => patch.files)
+      return { files, parseError: "" }
+    } catch (error) {
+      return {
+        files: [] as FileDiffMetadata[],
+        parseError: getErrorMessage(error),
+      }
+    }
+  }, [mergeRequestIid, patchText, projectId])
+
+  const normalizedFilter = filenameFilter.trim().toLowerCase()
+  const filteredFiles = useMemo(() => {
+    if (!normalizedFilter) {
+      return parsedPatch.files
+    }
+
+    return parsedPatch.files.filter((file) => {
+      const label = getFileLabel(file).toLowerCase()
+      return label.includes(normalizedFilter)
+    })
+  }, [normalizedFilter, parsedPatch.files])
+
+  useEffect(() => {
+    setVisibleFileCount(INITIAL_FILE_BATCH_SIZE)
+  }, [normalizedFilter, patchText])
+
+  const totals = useMemo(
+    () =>
+      filteredFiles.reduce(
+        (accumulator, file) => {
+          for (const hunk of file.hunks) {
+            accumulator.additions += hunk.additionCount
+            accumulator.deletions += hunk.deletionCount
+          }
+          return accumulator
+        },
+        { additions: 0, deletions: 0 },
+      ),
+    [filteredFiles],
+  )
+
+  const visibleFiles = filteredFiles.slice(0, visibleFileCount)
+  const canLoadMore = visibleFileCount < filteredFiles.length
+
+  const workerPoolSize = useMemo(() => {
+    if (typeof navigator === "undefined") {
+      return DEFAULT_WORKER_COUNT
+    }
+
+    const cores = navigator.hardwareConcurrency || DEFAULT_WORKER_COUNT
+    return Math.max(2, Math.min(8, cores - 1))
+  }, [])
+
+  const diffOptions = useMemo(
+    () => ({
+      diffStyle,
+      overflow: (wrapLines ? "wrap" : "scroll") as "wrap" | "scroll",
+      disableLineNumbers: !showLineNumbers,
+      lineDiffType: "word" as const,
+      diffIndicators: "classic" as const,
+      hunkSeparators: "line-info" as const,
+      expansionLineCount: 20,
+      tokenizeMaxLineLength: 1500,
+      theme: {
+        light: "github-light",
+        dark: "github-dark",
+      },
+      themeType: "system" as const,
+    }),
+    [diffStyle, showLineNumbers, wrapLines],
+  )
+
+  const poolOptions = useMemo(
+    () => ({
+      workerFactory: () =>
+        new Worker(
+          new URL("@pierre/diffs/worker/worker.js", import.meta.url),
+        ),
+      poolSize: workerPoolSize,
+      totalASTLRUCacheSize: DIFF_CACHE_SIZE,
+    }),
+    [workerPoolSize],
+  )
+
+  const highlighterOptions = useMemo(
+    () => ({
+      theme: {
+        light: "github-light",
+        dark: "github-dark",
+      },
+      lineDiffType: "word" as const,
+      tokenizeMaxLineLength: 1500,
+    }),
+    [],
+  )
+
+  return (
+    <Card>
+      <CardHeader className="gap-3">
+        <CardTitle>5) Review diff</CardTitle>
+        <CardDescription>
+          High-fidelity rendering powered by diffs.com with patch fallback for reliability.
+        </CardDescription>
+      </CardHeader>
+      <CardContent className="space-y-4">
+        <div className="flex flex-wrap gap-2">
+          <Badge variant="outline">{filteredFiles.length} files</Badge>
+          <Badge variant="secondary">+{totals.additions}</Badge>
+          <Badge variant="destructive">-{totals.deletions}</Badge>
+          {dataSource ? (
+            <Badge variant="outline">
+              source: {dataSource === "raw_diffs" ? "raw_diffs" : "changes fallback"}
+            </Badge>
+          ) : null}
+        </div>
+
+        <div className="grid gap-3 md:grid-cols-2">
+          <div className="grid gap-1.5">
+            <Label htmlFor="diff-file-filter">Filter files</Label>
+            <Input
+              id="diff-file-filter"
+              placeholder="Search by filename"
+              value={filenameFilter}
+              onChange={(event) => setFilenameFilter(event.target.value)}
+            />
+          </div>
+          <div className="grid gap-1.5">
+            <Label>Viewer controls</Label>
+            <div className="flex flex-wrap gap-2">
+              <Button
+                type="button"
+                size="sm"
+                variant={diffStyle === "split" ? "default" : "outline"}
+                onClick={() => setDiffStyle("split")}
+              >
+                Split
+              </Button>
+              <Button
+                type="button"
+                size="sm"
+                variant={diffStyle === "unified" ? "default" : "outline"}
+                onClick={() => setDiffStyle("unified")}
+              >
+                Unified
+              </Button>
+              <Button
+                type="button"
+                size="sm"
+                variant={wrapLines ? "default" : "outline"}
+                onClick={() => setWrapLines((current) => !current)}
+              >
+                Wrap lines
+              </Button>
+              <Button
+                type="button"
+                size="sm"
+                variant={showLineNumbers ? "default" : "outline"}
+                onClick={() => setShowLineNumbers((current) => !current)}
+              >
+                Line numbers
+              </Button>
+              <Button
+                type="button"
+                size="sm"
+                variant="outline"
+                disabled={isLoading}
+                onClick={() => void loadDiff()}
+              >
+                {isLoading ? "Reloading..." : "Reload diff"}
+              </Button>
+            </div>
+          </div>
+        </div>
+
+        {loadError ? <p className="text-sm text-destructive">{loadError}</p> : null}
+        {parsedPatch.parseError ? (
+          <p className="text-sm text-destructive">{parsedPatch.parseError}</p>
+        ) : null}
+
+        {isLoading ? (
+          <div className="rounded-md border border-dashed px-4 py-8 text-center text-sm text-muted-foreground">
+            Loading merge request diff...
+          </div>
+        ) : null}
+
+        {!isLoading && !loadError && !parsedPatch.parseError && visibleFiles.length === 0 ? (
+          <div className="rounded-md border border-dashed px-4 py-8 text-center text-sm text-muted-foreground">
+            No files match your current filter.
+          </div>
+        ) : null}
+
+        {visibleFiles.length > 0 ? (
+          <WorkerPoolContextProvider
+            poolOptions={poolOptions}
+            highlighterOptions={highlighterOptions}
+          >
+            <div className="space-y-4">
+              {visibleFiles.map((file) => (
+                <div key={file.cacheKey ?? getFileLabel(file)} className="space-y-2">
+                  <div className="flex flex-wrap items-center gap-2 text-xs">
+                    <span className="rounded bg-muted px-2 py-1 font-medium text-foreground">
+                      {getFileLabel(file)}
+                    </span>
+                    <Badge variant={getChangeTypeBadgeVariant(file.type)}>
+                      {getChangeTypeLabel(file.type)}
+                    </Badge>
+                  </div>
+                  <FileDiff
+                    fileDiff={file}
+                    options={diffOptions}
+                    className="rounded-lg border"
+                  />
+                </div>
+              ))}
+            </div>
+          </WorkerPoolContextProvider>
+        ) : null}
+
+        {canLoadMore ? (
+          <div className="pt-2">
+            <Button
+              type="button"
+              variant="outline"
+              onClick={() =>
+                setVisibleFileCount((count) =>
+                  Math.min(count + FILE_BATCH_SIZE, filteredFiles.length),
+                )
+              }
+            >
+              Load more files ({filteredFiles.length - visibleFileCount} remaining)
+            </Button>
+          </div>
+        ) : null}
+      </CardContent>
+    </Card>
+  )
+}
