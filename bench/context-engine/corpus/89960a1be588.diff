diff --git a/src/app/api/gitlab/route.ts b/src/app/api/gitlab/route.ts
new file mode 100644
index 00000000..6e31c13e
--- /dev/null
+++ b/src/app/api/gitlab/route.ts
@@ -0,0 +1,309 @@
+import { NextResponse } from "next/server"
+
+type GitLabAction = "projects" | "merge-requests" | "merge-request-diff"
+
+type GitLabProjectPayload = {
+  action: GitLabAction
+  instanceUrl: string
+  token: string
+  projectId?: string
+  mergeRequestIid?: string
+}
+
+type Project = {
+  id: string
+  name: string
+  path: string
+  webUrl: string
+}
+
+type MergeRequest = {
+  id: string
+  iid: string
+  title: string
+  state: string
+  author: string
+  webUrl: string
+}
+
+const MAX_PATCH_BYTES = 2_500_000
+
+class GitLabRouteError extends Error {
+  status: number
+
+  constructor(message: string, status = 502) {
+    super(message)
+    this.status = status
+  }
+}
+
+const isNonEmptyString = (value: unknown): value is string =>
+  typeof value === "string" && value.trim().length > 0
+
+const normalizeInstanceUrl = (input: string) => {
+  const trimmed = input.trim().replace(/\/+$/, "")
+  if (!trimmed) {
+    throw new Error("GitLab instance URL is required.")
+  }
+
+  if (/^https?:\/\//i.test(trimmed)) {
+    return trimmed
+  }
+
+  return `https://${trimmed}`
+}
+
+const getGitLabRequest = async (
+  instanceUrl: string,
+  token: string,
+  apiPath: string,
+) => {
+  const response = await fetch(`${instanceUrl}${apiPath}`, {
+    headers: {
+      "PRIVATE-TOKEN": token,
+      "User-Agent": "argus-app",
+    },
+    method: "GET",
+  })
+
+  if (!response.ok) {
+    const responseText = await response.text()
+    const bodyMessage =
+      responseText.length > 0 ? responseText.slice(0, 400) : undefined
+    throw new GitLabRouteError(
+      `GitLab request failed (${response.status}): ${bodyMessage ?? "no details"}`,
+    )
+  }
+
+  return response
+}
+
+const getGitLabJson = async <T>(
+  instanceUrl: string,
+  token: string,
+  apiPath: string,
+) => {
+  const response = await getGitLabRequest(instanceUrl, token, apiPath)
+  return (await response.json()) as T
+}
+
+const getPatchSizeBytes = (patch: string) => Buffer.byteLength(patch, "utf8")
+
+const buildPatchFromChanges = (payload: unknown) => {
+  const root =
+    payload && typeof payload === "object"
+      ? (payload as Record<string, unknown>)
+      : null
+
+  const changes = Array.isArray(root?.changes)
+    ? root.changes.filter(
+        (item): item is Record<string, unknown> =>
+          Boolean(item) && typeof item === "object",
+      )
+    : []
+
+  return changes
+    .map((change) => {
+      const rawDiff = String(change.diff ?? "").trimEnd()
+      if (!rawDiff) {
+        return null
+      }
+
+      if (rawDiff.startsWith("diff --git ")) {
+        return rawDiff
+      }
+
+      const oldPath = String(change.old_path ?? change.new_path ?? "unknown")
+      const newPath = String(change.new_path ?? change.old_path ?? "unknown")
+      const oldHeader = change.new_file === true ? "/dev/null" : `a/${oldPath}`
+      const newHeader = change.deleted_file === true ? "/dev/null" : `b/${newPath}`
+      const diffHeader = `diff --git a/${oldPath} b/${newPath}`
+      const includesFileHeaders =
+        /^---\s/m.test(rawDiff) && /^\+\+\+\s/m.test(rawDiff)
+
+      if (includesFileHeaders) {
+        return `${diffHeader}\n${rawDiff}`
+      }
+
+      return `${diffHeader}\n--- ${oldHeader}\n+++ ${newHeader}\n${rawDiff}`
+    })
+    .filter((value): value is string => Boolean(value))
+    .join("\n\n")
+}
+
+const getMergeRequestPatch = async ({
+  instanceUrl,
+  token,
+  projectId,
+  mergeRequestIid,
+}: {
+  instanceUrl: string
+  token: string
+  projectId: string
+  mergeRequestIid: string
+}) => {
+  const encodedProjectId = encodeURIComponent(projectId)
+  const encodedMergeRequestIid = encodeURIComponent(mergeRequestIid)
+
+  try {
+    const rawDiffResponse = await getGitLabRequest(
+      instanceUrl,
+      token,
+      `/api/v4/projects/${encodedProjectId}/merge_requests/${encodedMergeRequestIid}/raw_diffs`,
+    )
+    const contentLength = Number(rawDiffResponse.headers.get("content-length"))
+    if (Number.isFinite(contentLength) && contentLength > MAX_PATCH_BYTES) {
+      throw new GitLabRouteError(
+        "Diff is too large to render reliably in the browser.",
+        413,
+      )
+    }
+
+    const patch = await rawDiffResponse.text()
+    if (getPatchSizeBytes(patch) > MAX_PATCH_BYTES) {
+      throw new GitLabRouteError(
+        "Diff is too large to render reliably in the browser.",
+        413,
+      )
+    }
+
+    if (patch.trim().length > 0) {
+      return { patch, source: "raw_diffs" as const }
+    }
+  } catch (rawDiffError) {
+    if (rawDiffError instanceof GitLabRouteError && rawDiffError.status === 413) {
+      throw rawDiffError
+    }
+  }
+
+  const changesPayload = await getGitLabJson<Record<string, unknown>>(
+    instanceUrl,
+    token,
+    `/api/v4/projects/${encodedProjectId}/merge_requests/${encodedMergeRequestIid}/changes?access_raw_diffs=true`,
+  )
+  const fallbackPatch = buildPatchFromChanges(changesPayload)
+
+  if (!fallbackPatch.trim()) {
+    throw new GitLabRouteError("Merge request has no diff content to render.", 404)
+  }
+
+  if (getPatchSizeBytes(fallbackPatch) > MAX_PATCH_BYTES) {
+    throw new GitLabRouteError(
+      "Diff is too large to render reliably in the browser.",
+      413,
+    )
+  }
+
+  return { patch: fallbackPatch, source: "changes" as const }
+}
+
+export async function POST(request: Request) {
+  const payload = (await request.json().catch(() => null)) as
+    | GitLabProjectPayload
+    | null
+
+  if (!payload || payload.action === undefined) {
+    return NextResponse.json({ error: "Invalid request payload." }, { status: 400 })
+  }
+
+  if (
+    payload.action !== "projects" &&
+    payload.action !== "merge-requests" &&
+    payload.action !== "merge-request-diff"
+  ) {
+    return NextResponse.json({ error: "Unsupported action." }, { status: 400 })
+  }
+
+  if (!isNonEmptyString(payload.instanceUrl)) {
+    return NextResponse.json(
+      { error: "GitLab instance URL is required." },
+      { status: 400 },
+    )
+  }
+
+  if (!isNonEmptyString(payload.token)) {
+    return NextResponse.json(
+      { error: "Personal access token is required." },
+      { status: 400 },
+    )
+  }
+
+  const normalizedInstanceUrl = normalizeInstanceUrl(payload.instanceUrl)
+
+  try {
+    if (payload.action === "projects") {
+      const responseData = await getGitLabJson<Array<Record<string, unknown>>>(
+        normalizedInstanceUrl,
+        payload.token,
+        "/api/v4/projects?membership=true&per_page=100&order_by=last_activity_at&sort=desc",
+      )
+
+      const projects: Project[] = responseData
+        .filter((item) => item && typeof item === "object")
+        .map((item) => ({
+          id: String(item.id),
+          name: String(item.name_with_namespace ?? item.name ?? item.path),
+          path: String(item.path_with_namespace ?? item.path),
+          webUrl: String(item.web_url ?? ""),
+        }))
+
+      return NextResponse.json({ data: projects })
+    }
+
+    if (!isNonEmptyString(payload.projectId)) {
+      return NextResponse.json(
+        { error: "Project selection is required." },
+        { status: 400 },
+      )
+    }
+
+    if (payload.action === "merge-requests") {
+      const responseData = await getGitLabJson<Array<Record<string, unknown>>>(
+        normalizedInstanceUrl,
+        payload.token,
+        `/api/v4/projects/${encodeURIComponent(payload.projectId)}/merge_requests?state=opened&per_page=100&order_by=updated_at&sort=desc`,
+      )
+
+      const mergeRequests: MergeRequest[] = responseData
+        .filter((item) => item && typeof item === "object")
+        .map((item) => ({
+          id: String(item.id),
+          iid: String(item.iid),
+          title: String(item.title ?? ""),
+          state: String(item.state ?? "unknown"),
+          author:
+            item.author &&
+            typeof item.author === "object" &&
+            "name" in item.author
+              ? String((item.author as { name?: unknown }).name ?? "Unknown author")
+              : "Unknown author",
+          webUrl: String(item.web_url ?? ""),
+        }))
+
+      return NextResponse.json({ data: mergeRequests })
+    }
+
+    if (!isNonEmptyString(payload.mergeRequestIid)) {
+      return NextResponse.json(
+        { error: "Merge request selection is required." },
+        { status: 400 },
+      )
+    }
+
+    const mergeRequestDiff = await getMergeRequestPatch({
+      instanceUrl: normalizedInstanceUrl,
+      token: payload.token,
+      projectId: payload.projectId,
+      mergeRequestIid: payload.mergeRequestIid,
+    })
+
+    return NextResponse.json({ data: mergeRequestDiff })
+  } catch (error) {
+    const status = error instanceof GitLabRouteError ? error.status : 502
+    const message =
+      error instanceof Error
+        ? error.message
+        : "Unexpected GitLab lookup error."
+    return NextResponse.json({ error: message }, { status })
+  }
+}
