diff --git a/apps/web/src/features/review/components/review-status.ts b/apps/web/src/features/review/components/review-status.ts
new file mode 100644
index 00000000..8f89b041
--- /dev/null
+++ b/apps/web/src/features/review/components/review-status.ts
@@ -0,0 +1,51 @@
+import type {
+  ReviewFreshnessReason,
+  ReviewRunEvent,
+} from "@/features/review/model/diff/types"
+import type { ReviewGateSuppressedByReason } from "@/features/review/model/gate"
+
+export const REVIEW_STATUS_BADGE_STYLE: Record<string, string> = {
+  running:
+    "border-blue-200/60 bg-blue-500/10 text-blue-600 dark:border-blue-800/50 dark:bg-blue-500/10 dark:text-blue-400",
+  complete:
+    "border-emerald-200/60 bg-emerald-500/10 text-emerald-600 dark:border-emerald-800/50 dark:bg-emerald-500/10 dark:text-emerald-400",
+  failed:
+    "border-red-200/60 bg-red-500/10 text-red-600 dark:border-red-800/50 dark:bg-red-500/10 dark:text-red-400",
+  stale:
+    "border-amber-200/60 bg-amber-500/10 text-amber-700 dark:border-amber-800/50 dark:bg-amber-500/10 dark:text-amber-400",
+  current:
+    "border-sky-200/60 bg-sky-500/10 text-sky-700 dark:border-sky-800/50 dark:bg-sky-500/10 dark:text-sky-400",
+}
+
+export const SHARED_RUN_ATTACH_MESSAGE = "Attached to shared review in progress."
+
+export const getReviewFreshnessCopy = (
+  reason: ReviewFreshnessReason | null,
+) => {
+  if (reason === "diff_and_config") {
+    return "Showing a previous review. The diff and review settings changed since it ran."
+  }
+  if (reason === "config_changed") {
+    return "Showing a previous review. Review settings changed since it ran."
+  }
+  if (reason === "diff_changed") {
+    return "Showing a previous review. The merge request diff changed since it ran."
+  }
+  return "Showing a previous review."
+}
+
+export const formatReviewSuppressedReasons = (
+  value: ReviewGateSuppressedByReason,
+) => {
+  const parts: string[] = []
+  if (value.lowConfidence > 0) {
+    parts.push(`${value.lowConfidence} low confidence`)
+  }
+  if (value.missingEvidence > 0) {
+    parts.push(`${value.missingEvidence} missing evidence`)
+  }
+  return parts.join(", ")
+}
+
+export const hasAttachedSharedRun = (events: ReviewRunEvent[]) =>
+  events.some((event) => event.message === SHARED_RUN_ATTACH_MESSAGE)
