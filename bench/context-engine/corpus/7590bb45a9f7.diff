+        })}
+      />,
+    )
+
+    expect(markup).toContain("Stale")
+    expect(markup).toContain(
+      "Showing a previous review. The merge request diff changed since it ran.",
+    )
+    expect(markup).toContain("2 findings after review-gate filtering.")
+    expect(markup).toContain(
+      "3 findings suppressed by the review gate (2 low confidence, 1 missing evidence).",
+    )
+  })
 })
