@@ -0,0 +1,21 @@
+import { describe, expect, test } from "bun:test"
+
+import {
+  normalizeReviewExecutionBackend,
+  resolveReviewExecutionBackend,
+} from "./index"
+
+describe("review execution backend", () => {
+  test("accepts argus-agent as a valid backend", () => {
+    expect(normalizeReviewExecutionBackend("argus-agent")).toBe("argus-agent")
+  })
+
+  test("normalizes invalid and legacy values to argus-agent", () => {
+    expect(normalizeReviewExecutionBackend("not-a-backend")).toBe("argus-agent")
+    expect(normalizeReviewExecutionBackend("opencode")).toBe("argus-agent")
+  })
+
+  test("always resolves argus-agent", () => {
+    expect(resolveReviewExecutionBackend()).toBe("argus-agent")
+  })
+})
