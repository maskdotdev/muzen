diff --git a/apps/web/src/lib/argus-search/trace-impact-graph.ts b/apps/web/src/lib/argus-search/trace-impact-graph.ts
new file mode 100644
index 00000000..9f4e6446
--- /dev/null
+++ b/apps/web/src/lib/argus-search/trace-impact-graph.ts
@@ -0,0 +1,93 @@
+import { asRecord, withTimeout } from "@/lib/argus-search/sdk-client-utils"
+
+type TraceImpactNode = { depth: number; node: Record<string, unknown> }
+
+type CollectTraceImpactGraphOptions = {
+  nodeId?: string
+  symbol?: string
+  limit: number
+  maxDepth: number
+  timeoutMs: number
+  timeoutMessage: string
+  fetchCallers: (nextNodeId?: string, nextName?: string) => Promise<unknown[]>
+  normalizeNode: (node: Record<string, unknown>) => Record<string, unknown>
+}
+
+export const collectTraceImpactGraph = async (
+  options: CollectTraceImpactGraphOptions,
+): Promise<TraceImpactNode[]> => {
+  const visited = new Set<string>()
+  const queue: Array<{ nodeId: string; depth: number }> = []
+  const out: TraceImpactNode[] = []
+
+  if (options.nodeId) {
+    visited.add(options.nodeId)
+    queue.push({ nodeId: options.nodeId, depth: 0 })
+  } else {
+    const seeds = await withTimeout(
+      Promise.resolve(options.fetchCallers(undefined, options.symbol)),
+      options.timeoutMs,
+      options.timeoutMessage,
+    )
+
+    for (const seed of seeds) {
+      const seedRecord = asRecord(seed)
+      if (!seedRecord) {
+        continue
+      }
+
+      const seedId = seedRecord.id ? String(seedRecord.id) : ""
+      if (!seedId || visited.has(seedId)) {
+        continue
+      }
+
+      visited.add(seedId)
+      out.push({
+        depth: 1,
+        node: options.normalizeNode(seedRecord),
+      })
+      if (out.length >= options.limit || options.maxDepth <= 1) {
+        return out
+      }
+      queue.push({ nodeId: seedId, depth: 1 })
+    }
+  }
+
+  while (queue.length > 0) {
+    const current = queue.shift()
+    if (!current || current.depth >= options.maxDepth) {
+      continue
+    }
+
+    const callers = await withTimeout(
+      Promise.resolve(options.fetchCallers(current.nodeId)),
+      options.timeoutMs,
+      options.timeoutMessage,
+    )
+
+    for (const caller of callers) {
+      const callerRecord = asRecord(caller)
+      if (!callerRecord) {
+        continue
+      }
+
+      const callerId = callerRecord.id ? String(callerRecord.id) : ""
+      if (!callerId || visited.has(callerId)) {
+        continue
+      }
+
+      const nextDepth = current.depth + 1
+      visited.add(callerId)
+      out.push({
+        depth: nextDepth,
+        node: options.normalizeNode(callerRecord),
+      })
+      if (out.length >= options.limit) {
+        return out
+      }
+      queue.push({ nodeId: callerId, depth: nextDepth })
+    }
+  }
+
+  return out
+}
