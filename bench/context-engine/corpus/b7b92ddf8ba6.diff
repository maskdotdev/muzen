+import { and, desc, eq } from "drizzle-orm"
+
+import { db } from "@/lib/db"
+import {
+  aiReviewCommentFeedback,
+  aiReviewRuns,
+  type AiReviewFinding,
+} from "@/lib/db/schema"
+import {
+  applyReviewGate,
+  getReviewPersonaPasses,
+  normalizeReviewGateSettings,
+  type ReviewGateSettings,
+} from "@/lib/review/gate"
+import { normalizeReviewPersona, normalizeReviewPersonaMode } from "@/lib/review/persona"
+import { resolveReviewGatePreferences } from "@/lib/review/preferences"
+import * as commentPublish from "@/lib/review/comment-publish"
+
+export type ReviewReadScope = {
+  instanceUrl: string
+  projectId: string
+  mergeRequestIid: string
+}
+
+export type PersistedReviewReadModel = {
+  id: string
+  summary: string
+  findings: AiReviewFinding[]
+  personaMode: "disabled" | "single" | "multi"
+  persona: "generalist" | "security" | "performance" | "maintainability"
+  personaPasses: string[]
+  feedback: "up" | "down" | null
+  commentFeedbackByKey: Record<string, "up" | "down">
+  commentPublishByKey: Record<string, {
+    status: "pending" | "processing" | "failed" | "succeeded" | "dead"
+    attempts: number
+    lastError: string
+    discussionId: string | null
+    noteId: string | null
+    updatedAt: string
+  }>
+  createdAt: string
+  suppressedFindingsCount: number
+  suppressedByReason: {
+    lowConfidence: number
+    missingEvidence: number
+  }
+}
+
+export type ReviewGateProfile = ReviewGateSettings & {
+  scopeSource?: string
+  personaMode: "disabled" | "single" | "multi"
+  persona: "generalist" | "security" | "performance" | "maintainability"
+  personaPasses: string[]
+}
+
+export type LatestReviewReadModel = {
+  review: Omit<PersistedReviewReadModel, "suppressedFindingsCount" | "suppressedByReason"> | null
+  suppressedFindingsCount: number
+  suppressedByReason: {
+    lowConfidence: number
+    missingEvidence: number
+  }
+  gateProfile: ReviewGateProfile
+}
+
+export type ReviewFixQueue = {
+  reviewId: string | null
+  reviewSummary: string | null
+  items: Array<{
+    reviewId: string
+    commentKey: string
+    title: string
+    body: string
+    severity: "high" | "med" | "low"
+    confidence: number
+    file: string
+    line: number
+    side: "additions" | "deletions"
+    evidence?: string
+    status: "pending" | "processing" | "failed" | "succeeded" | "dead" | null
+    discussionId: string | null
+    noteId: string | null
+    updatedAt: string | null
+  }>
+}
+
+type ReviewRow = {
+  id: string
+  summary: string
+  findings: AiReviewFinding[]
+  personaMode: "disabled" | "single" | "multi"
+  persona: "generalist" | "security" | "performance" | "maintainability"
+  personaPasses: string[]
+  feedback: "up" | "down" | null
+  createdAt: Date
+  instanceUrl: string
+  projectId: string
+  mergeRequestIid: string
+}
+
+const buildGateProfile = (
+  effectiveSettings: ReviewGateSettings & { scopeSource?: string },
+): ReviewGateProfile => {
+  const personaMode = normalizeReviewPersonaMode(effectiveSettings.personaMode)
+  const persona =
+    personaMode === "single"
+      ? normalizeReviewPersona(effectiveSettings.persona)
+      : "generalist"
+
+  return {
+    ...effectiveSettings,
+    personaMode,
+    persona,
+    personaPasses: getReviewPersonaPasses(effectiveSettings),
+  }
+}
+
+const toPersistedReview = ({
+  row,
+  findings,
+  commentFeedbackByKey,
+  commentPublishByKey,
+  suppressedFindingsCount,
+  suppressedByReason,
+}: {
+  row: ReviewRow
+  findings: AiReviewFinding[]
+  commentFeedbackByKey: Record<string, "up" | "down">
+  commentPublishByKey: PersistedReviewReadModel["commentPublishByKey"]
+  suppressedFindingsCount: number
+  suppressedByReason: PersistedReviewReadModel["suppressedByReason"]
+}): PersistedReviewReadModel => ({
+  id: row.id,
+  summary: row.summary,
+  findings,
+  personaMode: normalizeReviewPersonaMode(row.personaMode),
+  persona: normalizeReviewPersona(row.persona),
+  personaPasses: Array.isArray(row.personaPasses)
+    ? row.personaPasses
+        .map((entry) => normalizeReviewPersona(entry))
+        .filter((entry) => entry.length > 0)
+    : [],
+  feedback: row.feedback,
+  commentFeedbackByKey,
+  commentPublishByKey,
+  createdAt: row.createdAt.toISOString(),
+  suppressedFindingsCount,
+  suppressedByReason,
+})
+
+const loadLatestReviewRowForScope = async ({
+  userId,
+  scope,
+}: {
+  userId: string
+  scope: ReviewReadScope
+}) =>
+  await db
+    .select({
+      id: aiReviewRuns.id,
+      summary: aiReviewRuns.summary,
+      findings: aiReviewRuns.findings,
+      personaMode: aiReviewRuns.personaMode,
+      persona: aiReviewRuns.persona,
+      personaPasses: aiReviewRuns.personaPasses,
+      feedback: aiReviewRuns.feedback,
+      createdAt: aiReviewRuns.createdAt,
+      instanceUrl: aiReviewRuns.instanceUrl,
+      projectId: aiReviewRuns.projectId,
+      mergeRequestIid: aiReviewRuns.mergeRequestIid,
+    })
+    .from(aiReviewRuns)
+    .where(
+      and(
+        eq(aiReviewRuns.userId, userId),
+        eq(aiReviewRuns.instanceUrl, scope.instanceUrl),
+        eq(aiReviewRuns.projectId, scope.projectId),
+        eq(aiReviewRuns.mergeRequestIid, scope.mergeRequestIid),
+      ),
+    )
+    .orderBy(desc(aiReviewRuns.createdAt))
+    .limit(1)
+
+const loadReviewRowById = async ({
+  userId,
+  reviewId,
+}: {
+  userId: string
+  reviewId: string
+}) =>
+  await db
+    .select({
+      id: aiReviewRuns.id,
+      summary: aiReviewRuns.summary,
+      findings: aiReviewRuns.findings,
+      personaMode: aiReviewRuns.personaMode,
+      persona: aiReviewRuns.persona,
+      personaPasses: aiReviewRuns.personaPasses,
+      feedback: aiReviewRuns.feedback,
+      createdAt: aiReviewRuns.createdAt,
+      instanceUrl: aiReviewRuns.instanceUrl,
+      projectId: aiReviewRuns.projectId,
+      mergeRequestIid: aiReviewRuns.mergeRequestIid,
+    })
+    .from(aiReviewRuns)
+    .where(and(eq(aiReviewRuns.userId, userId), eq(aiReviewRuns.id, reviewId)))
+    .limit(1)
+
+const loadReviewPayload = async ({
+  userId,
+  row,
+  gateProfile,
+}: {
+  userId: string
+  row: ReviewRow
+  gateProfile: ReviewGateProfile
+}) => {
+  const gateResult = applyReviewGate({
+    findings: row.findings,
+    settings: gateProfile,
+  })
+  const integration = await commentPublish.resolveManagedIntegrationForScope({
+    userId,
+    instanceUrl: row.instanceUrl,
+    projectId: row.projectId,
+  })
+  const [commentFeedbackRows, commentPublishByKey] = await Promise.all([
+    db
+      .select({
+        commentKey: aiReviewCommentFeedback.commentKey,
+        feedback: aiReviewCommentFeedback.feedback,
+      })
+      .from(aiReviewCommentFeedback)
+      .where(
+        and(
+          eq(aiReviewCommentFeedback.reviewId, row.id),
+          eq(aiReviewCommentFeedback.userId, userId),
+        ),
+      ),
+    commentPublish.getCommentPublishByKeyForReview({
+      integrationId: integration?.id ?? null,
+      mergeRequestIid: row.mergeRequestIid,
+      findings: gateResult.filteredFindings as AiReviewFinding[],
+    }),
+  ])
+
+  return toPersistedReview({
+    row,
+    findings: gateResult.filteredFindings as AiReviewFinding[],
+    commentFeedbackByKey: Object.fromEntries(
+      commentFeedbackRows.map((entry) => [entry.commentKey, entry.feedback]),
+    ),
+    commentPublishByKey,
+    suppressedFindingsCount: gateResult.suppressedFindingsCount,
+    suppressedByReason: gateResult.suppressedByReason,
+  })
+}
+
+const loadGateProfile = async ({
+  userId,
+  instanceUrl,
+  projectId,
+}: {
+  userId: string
+  instanceUrl: string
+  projectId: string
+}) => {
+  const gatePreferences = await resolveReviewGatePreferences({
+    userId,
+    scope: {
+      instanceUrl,
+      projectId,
+    },
+  })
+
+  return buildGateProfile(normalizeReviewGateSettings(gatePreferences.effectiveSettings))
+}
+
+export const getLatestReviewReadModel = async ({
+  userId,
+  scope,
+}: {
+  userId: string
+  scope: ReviewReadScope
+}): Promise<LatestReviewReadModel> => {
+  const gateProfile = await loadGateProfile({
+    userId,
+    instanceUrl: scope.instanceUrl,
+    projectId: scope.projectId,
+  })
+  const rows = await loadLatestReviewRowForScope({ userId, scope })
+  const row = rows[0]
+  if (!row) {
+    return {
+      review: null,
+      suppressedFindingsCount: 0,
+      suppressedByReason: {
+        lowConfidence: 0,
+        missingEvidence: 0,
+      },
+      gateProfile,
+    }
+  }
+
+  const review = await loadReviewPayload({
+    userId,
+    row,
+    gateProfile,
+  })
+
+  return {
+    review: {
+      id: review.id,
+      summary: review.summary,
+      findings: review.findings,
+      personaMode: review.personaMode,
+      persona: review.persona,
+      personaPasses: review.personaPasses,
+      feedback: review.feedback,
+      commentFeedbackByKey: review.commentFeedbackByKey,
+      commentPublishByKey: review.commentPublishByKey,
+      createdAt: review.createdAt,
+    },
+    suppressedFindingsCount: review.suppressedFindingsCount,
+    suppressedByReason: review.suppressedByReason,
+    gateProfile,
+  }
+}
+
+export const getReviewReadModelById = async ({
+  userId,
+  reviewId,
+}: {
+  userId: string
+  reviewId: string
+}) => {
+  const rows = await loadReviewRowById({ userId, reviewId })
+  const row = rows[0]
+  if (!row) {
+    return null
+  }
+
+  const gateProfile = await loadGateProfile({
+    userId,
+    instanceUrl: row.instanceUrl,
+    projectId: row.projectId,
+  })
+  return await loadReviewPayload({
+    userId,
+    row,
+    gateProfile,
+  })
+}
+
+export const getReviewByIdReadModel = getReviewReadModelById
+
+export const getReviewFixQueue = async ({
+  userId,
+  scope,
+}: {
+  userId: string
+  scope: ReviewReadScope
+}): Promise<ReviewFixQueue> => {
+  const latest = await getLatestReviewReadModel({ userId, scope })
+  if (!latest.review) {
+    return {
+      reviewId: null,
+      reviewSummary: null,
+      items: [],
+    }
+  }
+
+  return {
+    reviewId: latest.review.id,
+    reviewSummary: latest.review.summary,
+    items: latest.review.findings.map((finding) => {
+      const commentKey = commentPublish.buildCommentKey(finding)
+      const publishState = latest.review?.commentPublishByKey[commentKey] ?? null
+
+      return {
+        reviewId: latest.review!.id,
+        commentKey,
+        title: finding.title,
+        body: finding.body,
+        severity: finding.severity,
+        confidence: finding.confidence,
+        file: finding.file,
+        line: finding.line,
+        side: finding.side,
+        evidence: finding.evidence,
+        status: publishState?.status ?? null,
+        discussionId: publishState?.discussionId ?? null,
+        noteId: publishState?.noteId ?? null,
+        updatedAt: publishState?.updatedAt ?? null,
+      }
+    }),
+  }
+}
