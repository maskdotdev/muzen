@@ -0,0 +1,231 @@
+import { afterEach, describe, expect, mock, test } from "bun:test"
+import { jsonb, pgTable, text, timestamp } from "drizzle-orm/pg-core"
+
+type ReviewRow = {
+  id: string
+  summary: string
+  findings: Array<{
+    file: string
+    line: number
+    side: "additions" | "deletions"
+    severity: "high" | "med" | "low"
+    title: string
+    body: string
+    confidence: number
+    evidence?: string
+  }>
+  personaMode: "disabled" | "single" | "multi"
+  persona: "generalist" | "security" | "performance" | "maintainability"
+  personaPasses: string[]
+  feedback: "up" | "down" | null
+  createdAt: Date
+}
+
+const loadModule = async (options?: {
+  reviewRows?: ReviewRow[]
+  commentFeedbackRows?: Array<{ commentKey: string; feedback: "up" | "down" }>
+}) => {
+  const reviewRows = options?.reviewRows ?? [
+    {
+      id: "review-1",
+      summary: "Found two issues.",
+      findings: [
+        {
+          file: "src/a.ts",
+          line: 10,
+          side: "additions",
+          severity: "high",
+          title: "Missing null guard",
+          body: "Guard this nullable access.",
+          confidence: 0.91,
+          evidence: "const value = maybe.value",
+        },
+      ],
+      personaMode: "single",
+      persona: "generalist",
+      personaPasses: ["generalist"],
+      feedback: null,
+      createdAt: new Date("2026-03-05T12:00:00.000Z"),
+    },
+  ]
+  const commentFeedbackRows = options?.commentFeedbackRows ?? [
+    { commentKey: "src/a.ts:additions:10:missing null guard", feedback: "up" as const },
+  ]
+
+  const reviewLimit = mock(async () => reviewRows)
+  const reviewOrderBy = mock(() => ({ limit: reviewLimit }))
+  const reviewWhere = mock(() => ({ orderBy: reviewOrderBy }))
+  const reviewFrom = mock(() => ({ where: reviewWhere }))
+
+  const feedbackWhere = mock(async () => commentFeedbackRows)
+  const feedbackFrom = mock(() => ({ where: feedbackWhere }))
+
+  const select = mock((selection: Record<string, unknown>) => {
+    if ("commentKey" in selection) {
+      return { from: feedbackFrom }
+    }
+    return { from: reviewFrom }
+  })
+
+  const aiReviewRuns = pgTable("ai_review_runs", {
+    id: text("id"),
+    userId: text("user_id"),
+    instanceUrl: text("instance_url"),
+    projectId: text("project_id"),
+    mergeRequestIid: text("merge_request_iid"),
+    summary: text("summary"),
+    findings: jsonb("findings"),
+    personaMode: text("persona_mode"),
+    persona: text("persona"),
+    personaPasses: jsonb("persona_passes"),
+    feedback: text("feedback"),
+    createdAt: timestamp("created_at", { withTimezone: true }),
+  })
+
+  mock.module("@/lib/db", () => ({ db: { select } }))
+  mock.module("@/lib/db/schema", () => ({
+    aiReviewRuns,
+    aiReviewCommentFeedback: {
+      reviewId: "review_id",
+      userId: "user_id",
+      commentKey: "comment_key",
+      feedback: "feedback",
+    },
+  }))
+  mock.module("@/lib/review/preferences", () => ({
+    resolveReviewGatePreferences: mock(async () => ({
+      globalSettings: {
+        personaMode: "single",
+        persona: "generalist",
+        strictness: "balanced",
+        requireEvidence: false,
+        securityBoost: false,
+        personaTemplates: {},
+      },
+      projectOverride: null,
+      effectiveSettings: {
+        personaMode: "single",
+        persona: "generalist",
+        strictness: "balanced",
+        requireEvidence: false,
+        securityBoost: false,
+        personaTemplates: {},
+        scopeSource: "global_default",
+      },
+    })),
+  }))
+  mock.module("@/lib/review/gate", () => ({
+    applyReviewGate: mock(({ findings }: { findings: ReviewRow["findings"] }) => ({
+      filteredFindings: findings,
+      suppressedFindingsCount: 0,
+      suppressedByReason: {
+        lowConfidence: 0,
+        missingEvidence: 0,
+      },
+    })),
+    getReviewPersonaPasses: mock(() => ["generalist"]),
+    normalizeReviewGateSettings: mock((value: unknown) => value),
+  }))
+  mock.module("@/lib/review/persona", () => ({
+    normalizeReviewPersona: mock((value: unknown) =>
+      typeof value === "string" ? value : "generalist",
+    ),
+    normalizeReviewPersonaMode: mock((value: unknown) =>
+      typeof value === "string" ? value : "single",
+    ),
+  }))
+  mock.module("@/lib/review/comment-publish", () => ({
+    buildCommentKey: mock(
+      ({ file, side, line, title }: { file: string; side: string; line: number; title: string }) =>
+        `${file}:${side}:${line}:${title.toLowerCase()}`,
+    ),
+    resolveManagedIntegrationForScope: mock(async () => ({ id: "integration-1" })),
+    getCommentPublishByKeyForReview: mock(async () => ({
+      "src/a.ts:additions:10:missing null guard": {
+        status: "succeeded",
+        attempts: 1,
+        lastError: "",
+        discussionId: "discussion-1",
+        noteId: "note-1",
+        updatedAt: "2026-03-05T12:05:00.000Z",
+      },
+    })),
+  }))
+  mock.module("drizzle-orm", () => ({
+    and: (...clauses: unknown[]) => clauses,
+    desc: (value: unknown) => value,
+    eq: (left: unknown, right: unknown) => ({ left, right }),
+  }))
+
+  return import(`@/lib/review/read-model.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+}
+
+afterEach(() => {
+  mock.restore()
+})
+
+describe("review read model", () => {
+  test("loads the latest gated review for a merge request scope", async () => {
+    const mod = await loadModule()
+
+    const result = await mod.getLatestReviewReadModel({
+      userId: "user-1",
+      scope: {
+        instanceUrl: "https://gitlab.example.com",
+        projectId: "123",
+        mergeRequestIid: "42",
+      },
+    })
+
+    expect(result.review?.id).toBe("review-1")
+    expect(result.review?.summary).toBe("Found two issues.")
+    expect(result.review?.commentFeedbackByKey).toEqual({
+      "src/a.ts:additions:10:missing null guard": "up",
+    })
+    expect(result.review?.commentPublishByKey).toEqual({
+      "src/a.ts:additions:10:missing null guard": {
+        status: "succeeded",
+        attempts: 1,
+        lastError: "",
+        discussionId: "discussion-1",
+        noteId: "note-1",
+        updatedAt: "2026-03-05T12:05:00.000Z",
+      },
+    })
+    expect(result.gateProfile.persona).toBe("generalist")
+  })
+
+  test("builds a fix queue from the latest review", async () => {
+    const mod = await loadModule()
+
+    const queue = await mod.getReviewFixQueue({
+      userId: "user-1",
+      scope: {
+        instanceUrl: "https://gitlab.example.com",
+        projectId: "123",
+        mergeRequestIid: "42",
+      },
+    })
+
+    expect(queue.reviewId).toBe("review-1")
+    expect(queue.reviewSummary).toBe("Found two issues.")
+    expect(queue.items).toEqual([
+      {
+        reviewId: "review-1",
+        commentKey: "src/a.ts:additions:10:missing null guard",
+        title: "Missing null guard",
+        body: "Guard this nullable access.",
+        severity: "high",
+        confidence: 0.91,
+        file: "src/a.ts",
+        line: 10,
+        side: "additions",
+        evidence: "const value = maybe.value",
+        status: "succeeded",
+        discussionId: "discussion-1",
+        noteId: "note-1",
+        updatedAt: "2026-03-05T12:05:00.000Z",
+      },
+    ])
+  })
+})
