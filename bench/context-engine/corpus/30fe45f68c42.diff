@@ -0,0 +1,132 @@
+import { NextResponse } from "next/server"
+import { z } from "zod"
+
+import { getUserIntegration } from "@/lib/gitlab/service"
+import { enqueuePlanJob } from "@/lib/indexing/job-queue"
+import { getSessionUserId } from "@/lib/session"
+import { logScopedError, runWithApiRequestLog } from "@/lib/utils/logger"
+
+const CONFIG_HASH_PATTERN = /^[A-Za-z0-9._-]{1,120}$/
+
+const reindexSchema = z.object({
+  branch: z
+    .string()
+    .trim()
+    .min(1)
+    .max(255)
+    .refine((value) => !/[\0\r\n\\]/.test(value), "Invalid branch name."),
+  configHash: z
+    .string()
+    .trim()
+    .regex(CONFIG_HASH_PATTERN, "Invalid config hash.")
+    .optional(),
+})
+
+export async function POST(
+  request: Request,
+  context: { params: Promise<{ integrationId: string }> },
+) {
+  const { integrationId } = await context.params
+
+  return runWithApiRequestLog({
+    request,
+    path: `/api/gitlab/integrations/${integrationId}/index/reindex`,
+    event: "api.gitlab.index.reindex",
+    context: { integrationId },
+    handler: async ({ logger }) => {
+      const userId = await getSessionUserId()
+      if (!userId) {
+        return {
+          status: 401,
+          outcome: "unauthorized",
+          response: NextResponse.json({ error: "Unauthorized" }, { status: 401 }),
+        }
+      }
+
+      const [integration, payload] = await Promise.all([
+        getUserIntegration(integrationId, userId),
+        request.json().catch(() => ({})),
+      ])
+
+      if (!integration) {
+        return {
+          status: 404,
+          outcome: "not_found",
+          response: NextResponse.json({ error: "Integration not found." }, { status: 404 }),
+        }
+      }
+
+      if (integration.status === "disabled") {
+        return {
+          status: 409,
+          outcome: "conflict",
+          response: NextResponse.json({ error: "Integration is disabled." }, { status: 409 }),
+        }
+      }
+
+      const parsed = reindexSchema.safeParse(payload)
+      if (!parsed.success) {
+        return {
+          status: 400,
+          outcome: "invalid_request",
+          response: NextResponse.json({ error: "Invalid reindex payload." }, { status: 400 }),
+        }
+      }
+
+      try {
+        const queuedJob = await enqueuePlanJob({
+          integrationId: integration.id,
+          branch: parsed.data.branch,
+          configHash: parsed.data.configHash,
+          forceReplan: true,
+        })
+
+        logger.set({
+          branch: parsed.data.branch,
+          configHash: parsed.data.configHash ?? null,
+          planJobId: queuedJob.id,
+          forced: true,
+        })
+
+        return {
+          status: 202,
+          outcome: "accepted",
+          response: NextResponse.json({
+            data: {
+              integrationId: integration.id,
+              branch: parsed.data.branch,
+              job: queuedJob,
+              runId: null,
+              expectedTransition: {
+                jobStatus: {
+                  from: queuedJob.status,
+                  to: "processing",
+                },
+                runStatus: {
+                  from: "planned",
+                  to: "ready",
+                  intermediate: ["ingesting", "indexing"],
+                },
+              },
+            },
+          }, { status: 202 }),
+        }
+      } catch (error) {
+        logScopedError(logger, error, {
+          code: "INDEX_REINDEX_ENQUEUE_FAILED",
+          why: "Failed to persist forced plan job for manual branch repair.",
+          fix: "Inspect indexing queue DB health and retry reindex request.",
+          details: {
+            integrationId: integration.id,
+            branch: parsed.data.branch,
+          },
+        })
+        return {
+          status: 500,
+          outcome: "error",
+          response: NextResponse.json({ error: "Failed to enqueue reindex job." }, { status: 500 }),
+        }
+      }
+    },
+  })
+}
