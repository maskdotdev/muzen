@@ -0,0 +1,172 @@
+import { describe, expect, mock, test } from "bun:test"
+
+type LoggerContext = Record<string, unknown>
+
+type ApiLogHandlerArgs = {
+  logger: {
+    set: (context: LoggerContext) => void
+  }
+  requestId: string
+}
+
+type ApiLogHandlerResult = {
+  response: Response
+  status: number
+  outcome?: string
+}
+
+type RunWithApiRequestLogArgs = {
+  request: Request
+  path: string
+  event: string
+  context: Record<string, unknown>
+  handler: (args: ApiLogHandlerArgs) => Promise<ApiLogHandlerResult>
+}
+
+const loadRouteModule = async (options?: {
+  userId?: string | null
+  integration?: { id: string; status: "active" | "disabled" } | null
+  enqueueResult?: { id: string; debounceKey: string; status: "pending" | "processing" }
+  enqueueError?: Error
+}) => {
+  const loggerContext: LoggerContext = {}
+  const runWithApiRequestLog = mock(async ({ handler }: RunWithApiRequestLogArgs) => {
+    const logger = {
+      set: (context: LoggerContext) => {
+        Object.assign(loggerContext, context)
+      },
+    }
+    const result = await handler({ logger, requestId: "req_1" })
+    return result.response
+  })
+
+  const getSessionUserId = mock(async () => options?.userId ?? "user-1")
+  const getUserIntegration = mock(async () => {
+    if (options?.integration === undefined) {
+      return {
+        id: "integration-1",
+        status: "active" as const,
+      }
+    }
+
+    return options.integration
+  })
+
+  const enqueuePlanJob = mock(async () => {
+    if (options?.enqueueError) {
+      throw options.enqueueError
+    }
+
+    return (
+      options?.enqueueResult ?? {
+        id: "job-1",
+        debounceKey: "plan-force:integration-1:main:default",
+        status: "pending" as const,
+      }
+    )
+  })
+  const logScopedError = mock(() => {})
+
+  mock.module("@/lib/session", () => ({ getSessionUserId }))
+  mock.module("@/lib/gitlab/service", () => ({ getUserIntegration }))
+  mock.module("@/lib/indexing/job-queue", () => ({ enqueuePlanJob }))
+  mock.module("@/lib/utils/logger", () => ({ runWithApiRequestLog, logScopedError }))
+
+  const routeModule = await import(`./route?cacheBust=${Math.random().toString(36).slice(2)}`)
+
+  return {
+    POST: routeModule.POST as (
+      request: Request,
+      context: { params: Promise<{ integrationId: string }> },
+    ) => Promise<Response>,
+    loggerContext,
+    getSessionUserId,
+    getUserIntegration,
+    enqueuePlanJob,
+    logScopedError,
+  }
+}
+
+describe("gitlab index reindex route", () => {
+  test("returns 202 and enqueues forced plan job", async () => {
+    const { POST, enqueuePlanJob, loggerContext } = await loadRouteModule()
+
+    const response = await POST(
+      new Request("http://localhost/api/gitlab/integrations/integration-1/index/reindex", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({
+          branch: "main",
+        }),
+      }),
+      {
+        params: Promise.resolve({ integrationId: "integration-1" }),
+      },
+    )
+
+    const body = await response.json()
+
+    expect(response.status).toBe(202)
+    expect(enqueuePlanJob).toHaveBeenCalledTimes(1)
+    expect(enqueuePlanJob).toHaveBeenCalledWith({
+      integrationId: "integration-1",
+      branch: "main",
+      configHash: undefined,
+      forceReplan: true,
+    })
+    expect(body).toEqual({
+      data: {
+        integrationId: "integration-1",
+        branch: "main",
+        job: {
+          id: "job-1",
+          debounceKey: "plan-force:integration-1:main:default",
+          status: "pending",
+        },
+        runId: null,
+        expectedTransition: {
+          jobStatus: {
+            from: "pending",
+            to: "processing",
+          },
+          runStatus: {
+            from: "planned",
+            to: "ready",
+            intermediate: ["ingesting", "indexing"],
+          },
+        },
+      },
+    })
+    expect(loggerContext).toMatchObject({
+      branch: "main",
+      planJobId: "job-1",
+      forced: true,
+    })
+  })
+
+  test("returns 500 and logs when enqueue fails", async () => {
+    const enqueueError = new Error("db write failed")
+    const { POST, logScopedError } = await loadRouteModule({ enqueueError })
+
+    const response = await POST(
+      new Request("http://localhost/api/gitlab/integrations/integration-1/index/reindex", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({
+          branch: "main",
+        }),
+      }),
+      {
+        params: Promise.resolve({ integrationId: "integration-1" }),
+      },
+    )
+
+    const body = await response.json()
+
+    expect(response.status).toBe(500)
+    expect(body).toEqual({
+      error: "Failed to enqueue reindex job.",
+    })
+    expect(logScopedError).toHaveBeenCalledTimes(1)
+  })
+})
