diff --git a/packages/review-server/src/worker-service.test.ts b/packages/review-server/src/worker-service.test.ts
new file mode 100644
index 00000000..ce59a971
--- /dev/null
+++ b/packages/review-server/src/worker-service.test.ts
@@ -0,0 +1,95 @@
+import { describe, expect, mock, test } from "bun:test"
+
+import {
+  createReviewWorkerRuntime,
+  createReviewWorkerRuntimeEnvironment,
+} from "./worker-service"
+import type { ReviewWorkerSignal } from "./worker-loop"
+
+const createLogger = () => ({
+  info: mock(() => undefined),
+  warn: mock(() => undefined),
+  error: mock(() => undefined),
+})
+
+const createSignalController = () => {
+  const handlers = new Map<ReviewWorkerSignal, () => void>()
+  return {
+    handlers,
+    signals: {
+      on: mock((signal: ReviewWorkerSignal, handler: () => void) => {
+        handlers.set(signal, handler)
+      }),
+      off: mock((signal: ReviewWorkerSignal, handler: () => void) => {
+        if (handlers.get(signal) === handler) {
+          handlers.delete(signal)
+        }
+      }),
+    },
+  }
+}
+
+const createCleanupSummary = () => ({
+  lock: "skipped" as const,
+  staleWorktreesPruned: 0,
+  staleWorktreeErrors: 0,
+  reposEvicted: 0,
+  repoEvictionErrors: 0,
+})
+
+describe("review worker service", () => {
+  test("initializes the worker loop with runtime settings and lease settings", async () => {
+    const signalController = createSignalController()
+    const initLogger = mock(() => undefined)
+    const runtime = createReviewWorkerRuntime({
+      environment: createReviewWorkerRuntimeEnvironment({
+        env: {
+          SERVICE_NAME: "review-worker-test",
+          REVIEW_WORKER_CONTINUOUS: "false",
+          REVIEW_WORKER_BATCH_SIZE: "3",
+          REVIEW_WORKER_CONCURRENCY: "2",
+          REVIEW_FLOW_RETENTION_DAYS: "14",
+          WORKER_LEASES_ENABLED: "true",
+          REVIEW_LEASE_MS: "60000",
+        },
+        defaultRetentionDays: 30,
+        gitCacheCleanupIntervalMs: 15_000,
+      }),
+      logger: createLogger(),
+      initLogger,
+      resolveReviewExecutionBackend: mock(() => "argus-agent"),
+      claimDueReviewRuns: mock(async () => []),
+      processClaimedRun: mock(async () => "succeeded" as const),
+      waitForReviewQueueNotification: mock(async () => "disabled"),
+      purgeReviewFlowRetentionData: mock(async () => undefined),
+      cleanupGitCache: mock(async () => createCleanupSummary()),
+      getReviewQueueSnapshot: mock(async () => ({
+        queuedRuns: 0,
+        activeRuns: 0,
+        oldestQueuedWaitMs: 0,
+      })),
+    })
+
+    await runtime.runReviewWorker({
+      signals: signalController.signals,
+    })
+
+    expect(initLogger).toHaveBeenCalledWith(
+      expect.objectContaining({
+        service: "review-worker-test",
+        initEvent: "review.worker.started",
+        initContext: expect.objectContaining({
+          reviewExecutionBackend: "argus-agent",
+          continuous: false,
+          batchSize: 3,
+          concurrency: 2,
+          retentionDays: 14,
+          gitCacheCleanupIntervalMs: 15_000,
+          leasesEnabled: true,
+          leaseMs: 60_000,
+        }),
+      }),
+    )
+    expect(signalController.signals.off).toHaveBeenCalledTimes(2)
+  })
+})
diff --git a/packages/review-server/src/worker-service.ts b/packages/review-server/src/worker-service.ts
new file mode 100644
index 00000000..4797ea86
--- /dev/null
+++ b/packages/review-server/src/worker-service.ts
@@ -0,0 +1,201 @@
+import { resolveWorkerLeaseSettings } from "@argus/shared-runtime/worker-lease"
+import type { ReviewExecutionBackend } from "@argus/contracts/review"
+
+import {
+  createReviewWorkerBatchRunner,
+  type ReviewWorkerBatchRunStatus,
+  type ReviewWorkerBatchSummary,
+} from "./worker-batch"
+import type { ReviewQueueSnapshot } from "./runtime-metrics"
+import {
+  runReviewWorkerLoop,
+  type ReviewWorkerLeaseSettings,
+  type ReviewWorkerLogger,
+  type ReviewWorkerSignalController,
+} from "./worker-loop"
+import {
+  resolveReviewWorkerRuntimeSettings,
+  type ReviewWorkerRuntimeSettings,
+} from "./worker-settings"
+
+type ReviewWorkerEnv = Record<string, string | undefined>
+
+type ReviewWorkerRuntimeEnvironmentArgs = {
+  env?: ReviewWorkerEnv
+  defaultRetentionDays: number
+  gitCacheCleanupIntervalMs: number
+}
+
+export type ReviewWorkerRuntimeEnvironment = {
+  env?: ReviewWorkerEnv
+  settings: ReviewWorkerRuntimeSettings
+  resolveLeaseSettings: () => ReviewWorkerLeaseSettings
+}
+
+export const createReviewWorkerRuntimeEnvironment = ({
+  env,
+  defaultRetentionDays,
+  gitCacheCleanupIntervalMs,
+}: ReviewWorkerRuntimeEnvironmentArgs): ReviewWorkerRuntimeEnvironment => {
+  const settings = resolveReviewWorkerRuntimeSettings({
+    env,
+    defaultRetentionDays,
+    gitCacheCleanupIntervalMs,
+  })
+
+  return {
+    env,
+    settings,
+    resolveLeaseSettings: () =>
+      resolveWorkerLeaseSettings({
+        env,
+        leaseMsEnv: "REVIEW_LEASE_MS",
+        staleReclaimIntervalMsEnv: "REVIEW_STALE_RECLAIM_INTERVAL_MS",
+        gracefulShutdownMsEnv: "REVIEW_WORKER_GRACEFUL_SHUTDOWN_MS",
+        defaults: {
+          leaseMs: settings.leaseMs,
+          staleReclaimIntervalMs: settings.staleReclaimIntervalMs,
+          gracefulShutdownMs: settings.gracefulShutdownMs,
+        },
+      }),
+  }
+}
+
+type ReviewWorkerRuntimeCleanupSummary = {
+  lock: "acquired" | "skipped"
+  staleWorktreesPruned: number
+  staleWorktreeErrors: number
+  reposEvicted: number
+  repoEvictionErrors: number
+}
+
+type ReviewWorkerRuntimeLoggerInit = (args: {
+  service: string
+  initEvent: string
+  initContext: Record<string, unknown>
+}) => void
+
+export type ReviewWorkerRuntimeDeps<TRun> = {
+  environment: ReviewWorkerRuntimeEnvironment
+  logger: ReviewWorkerLogger
+  initLogger: ReviewWorkerRuntimeLoggerInit
+  resolveReviewExecutionBackend: () => ReviewExecutionBackend
+  claimDueReviewRuns: (args: { batchSize: number }) => Promise<TRun[]>
+  processClaimedRun: (
+    run: TRun,
+    maxAttempts: number,
+  ) => Promise<ReviewWorkerBatchRunStatus>
+  waitForReviewQueueNotification: (pollMs: number) => Promise<unknown>
+  purgeReviewFlowRetentionData: (args: { retentionDays: number }) => Promise<unknown>
+  cleanupGitCache: () => Promise<ReviewWorkerRuntimeCleanupSummary>
+  getReviewQueueSnapshot: () => Promise<ReviewQueueSnapshot>
+}
+
+export type RunReviewWorkerBatchArgs = {
+  batchSize?: number
+  concurrency?: number
+  maxAttempts?: number
+  retentionDays?: number
+  shouldStopClaiming?: () => boolean
+}
+
+export type RunReviewWorkerArgs = {
+  serviceName?: string
+  signals: ReviewWorkerSignalController
+}
+
+const sleep = (ms: number) =>
+  new Promise<void>((resolve) => {
+    setTimeout(resolve, Math.max(0, ms))
+  })
+
+const resolveServiceName = (
+  env: ReviewWorkerEnv | undefined,
+  serviceName: string | undefined,
+) => serviceName?.trim() || env?.SERVICE_NAME?.trim() || "review-worker"
+
+export const createReviewWorkerRuntime = <TRun>({
+  environment,
+  logger,
+  initLogger,
+  resolveReviewExecutionBackend,
+  claimDueReviewRuns,
+  processClaimedRun,
+  waitForReviewQueueNotification,
+  purgeReviewFlowRetentionData,
+  cleanupGitCache,
+  getReviewQueueSnapshot,
+}: ReviewWorkerRuntimeDeps<TRun>) => {
+  const { settings } = environment
+  const runReviewWorkerBatchRunner = createReviewWorkerBatchRunner({
+    claimDueReviewRuns,
+    processClaimedRun,
+    waitForMoreRuns: async () => {
+      const waitResult = await waitForReviewQueueNotification(settings.pollMs)
+      if (waitResult === "disabled") {
+        await sleep(settings.pollMs)
+      }
+    },
+    purgeReviewFlowRetentionData,
+    cleanupGitCache,
+    gitCacheCleanupIntervalMs: settings.gitCacheCleanupIntervalMs,
+  })
+
+  const runReviewWorkerBatch = async (
+    args: RunReviewWorkerBatchArgs = {},
+  ): Promise<ReviewWorkerBatchSummary> => {
+    const batchSize = Math.max(1, Math.min(args.batchSize ?? settings.batchSize, 200))
+    const concurrency = Math.max(1, Math.min(args.concurrency ?? settings.concurrency, 50))
+    const maxAttempts = Math.max(1, args.maxAttempts ?? settings.maxAttempts)
+    return runReviewWorkerBatchRunner({
+      batchSize,
+      concurrency,
+      maxAttempts,
+      retentionDays: args.retentionDays ?? settings.retentionDays,
+      shouldStopClaiming: args.shouldStopClaiming,
+    })
+  }
+
+  const runReviewWorker = async ({ serviceName, signals }: RunReviewWorkerArgs) => {
+    const leaseSettings = environment.resolveLeaseSettings()
+    const reviewExecutionBackend = resolveReviewExecutionBackend()
+    initLogger({
+      service: resolveServiceName(environment.env, serviceName),
+      initEvent: "review.worker.started",
+      initContext: {
+        reviewExecutionBackend,
+        continuous: settings.continuous,
+        pollMs: settings.pollMs,
+        batchSize: settings.batchSize,
+        concurrency: settings.concurrency,
+        maxAttempts: settings.maxAttempts,
+        retentionDays: settings.retentionDays,
+        gitCacheCleanupIntervalMs: settings.gitCacheCleanupIntervalMs,
+        leasesEnabled: leaseSettings.enabled,
+        leaseMs: leaseSettings.leaseMs,
+        staleReclaimIntervalMs: leaseSettings.staleReclaimIntervalMs,
+        gracefulShutdownMs: leaseSettings.gracefulShutdownMs,
+      },
+    })
+
+    await runReviewWorkerLoop({
+      settings,
+      leaseSettings,
+      logger,
+      signals,
+      runBatch: ({ shouldStopClaiming }) =>
+        runReviewWorkerBatch({
+          shouldStopClaiming,
+        }),
+      getReviewQueueSnapshot,
+      waitForReviewQueueNotification,
+    })
+  }
+
+  return {
+    settings,
+    resolveLeaseSettings: environment.resolveLeaseSettings,
+    runReviewWorkerBatch,
+    runReviewWorker,
+  }
+}
