+import {
+  index,
+  integer,
+  jsonb,
+  pgEnum,
+  pgTable,
+  text,
+  timestamp,
+  unique,
+  uuid,
+} from "drizzle-orm/pg-core";
+import { user } from "./auth";
+
+export const gitlabIntegrationStatusEnum = pgEnum("gitlab_integration_status", [
+  "active",
+  "degraded",
+  "disabled",
+]);
+
+export const gitlabWebhookEventTypeEnum = pgEnum("gitlab_webhook_event_type", [
+  "push",
+  "merge_request",
+  "ignored",
+]);
+
+export const gitlabJobStatusEnum = pgEnum("gitlab_job_status", [
+  "pending",
+  "processing",
+  "failed",
+  "succeeded",
+  "dead",
+]);
+
+export const gitlabJobTypeEnum = pgEnum("gitlab_job_type", [
+  "push",
+  "merge_request",
+  "hook_sync",
+]);
+
+export type JsonRecord = Record<string, unknown>;
+
+export const gitlabIntegrations = pgTable(
+  "gitlab_integrations",
+  {
+    id: uuid("id").defaultRandom().primaryKey(),
+    instanceUrl: text("instance_url").notNull(),
+    projectId: text("project_id").notNull(),
+    projectPath: text("project_path").notNull(),
+    projectName: text("project_name").notNull(),
+    hookId: text("hook_id"),
+    webhookUrl: text("webhook_url").notNull(),
+    webhookSecretHash: text("webhook_secret_hash"),
+    tokenCiphertext: text("token_ciphertext"),
+    tokenIv: text("token_iv"),
+    tokenAuthTag: text("token_auth_tag"),
+    status: gitlabIntegrationStatusEnum("status").notNull().default("degraded"),
+    lastHookSyncAt: timestamp("last_hook_sync_at", { withTimezone: true }),
+    lastWebhookReceivedAt: timestamp("last_webhook_received_at", {
+      withTimezone: true,
+    }),
+    lastError: text("last_error"),
+    createdAt: timestamp("created_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+    updatedAt: timestamp("updated_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+  },
+  (table) => ({
+    instanceProjectUnique: unique("gitlab_integrations_instance_project_uq").on(
+      table.instanceUrl,
+      table.projectId,
+    ),
+    statusIdx: index("gitlab_integrations_status_idx").on(table.status),
+    updatedAtIdx: index("gitlab_integrations_updated_at_idx").on(
+      table.updatedAt,
+    ),
+  }),
+);
+
+export const gitlabIntegrationMemberships = pgTable(
+  "gitlab_integration_memberships",
+  {
+    integrationId: uuid("integration_id")
+      .notNull()
+      .references(() => gitlabIntegrations.id, { onDelete: "cascade" }),
+    userId: text("user_id")
+      .notNull()
+      .references(() => user.id, { onDelete: "cascade" }),
+    createdAt: timestamp("created_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+  },
+  (table) => ({
+    membershipUnique: unique("gitlab_integration_memberships_unique").on(
+      table.integrationId,
+      table.userId,
+    ),
+    integrationIdx: index(
+      "gitlab_integration_memberships_integration_id_idx",
+    ).on(table.integrationId),
+    userIdx: index("gitlab_integration_memberships_user_id_idx").on(
+      table.userId,
+    ),
+  }),
+);
+
+export const gitlabWebhookDeliveries = pgTable(
+  "gitlab_webhook_deliveries",
+  {
+    id: uuid("id").defaultRandom().primaryKey(),
+    integrationId: uuid("integration_id")
+      .notNull()
+      .references(() => gitlabIntegrations.id, { onDelete: "cascade" }),
+    eventUuid: text("event_uuid").notNull(),
+    eventName: text("event_name").notNull(),
+    eventType: gitlabWebhookEventTypeEnum("event_type").notNull(),
+    ref: text("ref"),
+    payload: jsonb("payload").$type<JsonRecord>(),
+    receivedAt: timestamp("received_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+  },
+  (table) => ({
+    integrationEventUnique: unique(
+      "gitlab_webhook_deliveries_integration_event_uq",
+    ).on(table.integrationId, table.eventUuid),
+    integrationReceivedIdx: index(
+      "gitlab_webhook_deliveries_integration_received_idx",
+    ).on(table.integrationId, table.receivedAt),
+    eventTypeIdx: index("gitlab_webhook_deliveries_event_type_idx").on(
+      table.eventType,
+    ),
+  }),
+);
+
+export const gitlabJobs = pgTable(
+  "gitlab_jobs",
+  {
+    id: uuid("id").defaultRandom().primaryKey(),
+    integrationId: uuid("integration_id")
+      .notNull()
+      .references(() => gitlabIntegrations.id, { onDelete: "cascade" }),
+    deliveryId: uuid("delivery_id").references(
+      () => gitlabWebhookDeliveries.id,
+      {
+        onDelete: "set null",
+      },
+    ),
+    jobType: gitlabJobTypeEnum("job_type").notNull(),
+    status: gitlabJobStatusEnum("status").notNull().default("pending"),
+    attempts: integer("attempts").notNull().default(0),
+    nextAttemptAt: timestamp("next_attempt_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+    startedAt: timestamp("started_at", { withTimezone: true }),
+    finishedAt: timestamp("finished_at", { withTimezone: true }),
+    lastError: text("last_error"),
+    normalizedPayload: jsonb("normalized_payload").$type<JsonRecord>(),
+    result: jsonb("result").$type<JsonRecord>(),
+    createdAt: timestamp("created_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+    updatedAt: timestamp("updated_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+  },
+  (table) => ({
+    deliveryUnique: unique("gitlab_jobs_delivery_id_uq").on(table.deliveryId),
+    statusNextAttemptIdx: index("gitlab_jobs_status_next_attempt_idx").on(
+      table.status,
+      table.nextAttemptAt,
+    ),
+    integrationIdx: index("gitlab_jobs_integration_id_idx").on(
+      table.integrationId,
+    ),
+    jobTypeIdx: index("gitlab_jobs_job_type_idx").on(table.jobType),
+  }),
+);
