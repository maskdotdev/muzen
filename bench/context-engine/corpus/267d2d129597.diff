+++ b/src/lib/gitlab/env.ts
@@ -0,0 +1,92 @@
+import { Buffer } from "node:buffer"
+import { GITLAB_DEFAULT_JOB_BATCH_SIZE } from "@/lib/gitlab/constants"
+
+const isLikelyBase64 = (value: string) => /^[A-Za-z0-9+/=_-]+$/.test(value)
+
+const parseEncryptionKey = (value: string) => {
+  const trimmed = value.trim()
+  if (!trimmed) {
+    throw new Error("GITLAB_TOKEN_ENCRYPTION_KEY is required.")
+  }
+
+  if (/^[0-9a-fA-F]{64}$/.test(trimmed)) {
+    return Buffer.from(trimmed, "hex")
+  }
+
+  if (isLikelyBase64(trimmed)) {
+    const normalized = trimmed.replace(/-/g, "+").replace(/_/g, "/")
+    try {
+      const decoded = Buffer.from(normalized, "base64")
+      if (decoded.length === 32) {
+        return decoded
+      }
+    } catch {
+    }
+  }
+
+  const utf8 = Buffer.from(trimmed, "utf8")
+  if (utf8.length === 32) {
+    return utf8
+  }
+
+  throw new Error(
+    "GITLAB_TOKEN_ENCRYPTION_KEY must decode to exactly 32 bytes (raw/base64/base64url/hex).",
+  )
+}
+
+const normalizePublicUrl = (value: string) => {
+  const trimmed = value.trim()
+  if (!trimmed) {
+    throw new Error("APP_PUBLIC_URL is required.")
+  }
+
+  let parsed: URL
+  try {
+    parsed = new URL(trimmed)
+  } catch {
+    throw new Error("APP_PUBLIC_URL must be a valid absolute URL.")
+  }
+
+  if (!/^https?:$/i.test(parsed.protocol)) {
+    throw new Error("APP_PUBLIC_URL must use http or https.")
+  }
+
+  parsed.hash = ""
+  parsed.search = ""
+  const pathname = parsed.pathname.replace(/\/+$/, "")
+  return pathname ? `${parsed.origin}${pathname}` : parsed.origin
+}
+
+const parseBatchSize = (value: string | undefined) => {
+  if (!value) {
+    return GITLAB_DEFAULT_JOB_BATCH_SIZE
+  }
+
+  const parsed = Number.parseInt(value, 10)
+  if (!Number.isFinite(parsed) || parsed <= 0) {
+    throw new Error("GITLAB_JOB_BATCH_SIZE must be a positive integer when set.")
+  }
+
+  return Math.min(parsed, 200)
+}
+
+const readNonEmpty = (name: string, value: string | undefined) => {
+  if (!value || !value.trim()) {
+    throw new Error(`${name} is required.`)
+  }
+  return value.trim()
+}
+
+const appPublicUrl = normalizePublicUrl(readNonEmpty("APP_PUBLIC_URL", process.env.APP_PUBLIC_URL))
+const tokenEncryptionKey = parseEncryptionKey(
+  readNonEmpty("GITLAB_TOKEN_ENCRYPTION_KEY", process.env.GITLAB_TOKEN_ENCRYPTION_KEY),
+)
+const internalRunnerKey = readNonEmpty("INTERNAL_RUNNER_KEY", process.env.INTERNAL_RUNNER_KEY)
+const jobBatchSize = parseBatchSize(process.env.GITLAB_JOB_BATCH_SIZE)
+
+export const gitlabEnv = {
+  appPublicUrl,
+  internalRunnerKey,
+  jobBatchSize,
+  tokenEncryptionKey,
+} as const
