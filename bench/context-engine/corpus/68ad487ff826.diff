index 00000000..2bb25e11
--- /dev/null
+++ b/packages/review/server/src/review-impact-service.ts
@@ -0,0 +1,805 @@
+import {
+  buildReviewCommentFeedbackKey,
+  type ReviewFinding as AiReviewFinding,
+} from "@argus/contracts/review"
+import { computeImpactLevel, computeImpactScore } from "@argus/review-domain/impact-score"
+import { errorMessage } from "@argus/shared-runtime/core-error"
+
+export type ReviewImpactGraphInfo = {
+  indexRunId: string
+  generatedAt: string
+} | null
+
+export type ReviewFindingImpactResult = {
+  commentKey: string
+  status: "pending" | "succeeded" | "failed"
+  scope: "symbol" | "file" | null
+  sourceNodeId?: string | null
+  sourceFile?: string
+  sourceLine?: number
+  impactLevel: "low" | "med" | "high" | null
+  impactScore: number | null
+  callersCount: number
+  calleesCount: number
+  dependentsCount: number
+  dependenciesCount: number
+  affectedFilesCount: number
+  affectedSymbolsCount: number
+  topImpactedFiles: Array<{ filePath: string; count: number }>
+  error: string | null
+}
+
+export type ReviewImpactStatus =
+  | "not_started"
+  | "in_progress"
+  | "completed"
+  | "partial"
+  | "failed"
+  | "pending_graph"
+
+export type ReviewImpactTelemetry = {
+  graphBackend: "kitedb_fs"
+  graphResolutionStatus: "ready" | "pending_graph" | "error" | "not_checked"
+  graphPendingReason: string | null
+  branch: string | null
+  integrationId: string | null
+}
+
+export type ReviewImpactResponse = {
+  reviewId: string
+  status: ReviewImpactStatus
+  impactByKey: Record<string, ReviewFindingImpactResult>
+  graph: ReviewImpactGraphInfo
+  pendingReason: string | null
+  telemetry: ReviewImpactTelemetry
+}
+
+export type ReviewImpactComputeResponse = ReviewImpactResponse & {
+  computedCount: number
+  failedCount: number
+}
+
+export class ReviewImpactServiceError extends Error {
+  readonly code: "not_found"
+
+  constructor(code: "not_found", message: string) {
+    super(message)
+    this.code = code
+  }
+}
+
+export type ReviewImpactReviewRow = {
+  id: string
+  findings: AiReviewFinding[]
+  instanceUrl: string
+  projectId: string
+  integrationId: string | null
+  sourceBranch: string | null
+}
+
+export type ReviewImpactRow = {
+  reviewId: string
+  commentKey: string
+  status: "pending" | "succeeded" | "failed"
+  scope: "symbol" | "file" | null
+  sourceNodeId: string | null
+  sourceFile: string
+  sourceLine: number
+  impactScore: number | null
+  impactLevel: "low" | "med" | "high" | null
+  callersCount: number
+  calleesCount: number
+  dependentsCount: number
+  dependenciesCount: number
+  affectedFilesCount: number
+  affectedSymbolsCount: number
+  topImpactedFiles: unknown
+  indexRunId: string | null
+  graphGeneratedAt: Date | null
+  error: string | null
+}
+
+export type PersistImpactRowInput = {
+  reviewId: string
+  commentKey: string
+  status: "pending" | "succeeded" | "failed"
+  scope: "symbol" | "file" | null
+  sourceNodeId: string | null
+  sourceFile: string
+  sourceLine: number
+  impactScore: number | null
+  impactLevel: "low" | "med" | "high" | null
+  callersCount: number
+  calleesCount: number
+  dependentsCount: number
+  dependenciesCount: number
+  affectedFilesCount: number
+  affectedSymbolsCount: number
+  topImpactedFiles: Array<{ filePath: string; count: number }>
+  indexRunId: string | null
+  graphGeneratedAt: Date | null
+  error: string | null
+}
+
+export type ReviewImpactGraphPendingReason =
+  | "missing_integration_id"
+  | "missing_source_branch"
+  | "branch_state_not_found"
+  | "no_ready_run"
+  | "ready_run_not_found"
+  | "graph_build_failed"
+  | "graph_build_skipped"
+  | "missing_artifacts"
+
+export type ReviewImpactGraphSnapshotReady = {
+  status: "ready"
+  backend: "kitedb_fs"
+  integrationId: string | null
+  branch: string | null
+  indexRunId: string
+  generatedAt: string
+  graphStorePath: string | null
+  nodesPath: string | null
+  edgesPath: string | null
+}
+
+export type ReviewImpactGraphSnapshotPending = {
+  status: "pending_graph"
+  backend: "kitedb_fs"
+  integrationId: string | null
+  branch: string | null
+  reason: ReviewImpactGraphPendingReason
+  message: string
+}
+
+export type ReviewImpactGraphSnapshotError = {
+  status: "error"
+  backend: "kitedb_fs"
+  integrationId: string | null
+  branch: string | null
+  error: string
+}
+
+export type ReviewImpactGraphSnapshotResolution =
+  | ReviewImpactGraphSnapshotReady
+  | ReviewImpactGraphSnapshotPending
+  | ReviewImpactGraphSnapshotError
+
+export type ReviewImpactGraphNodeMatch = {
+  nodeId: string
+  scope: "symbol" | "file"
+  sourceFile: string
+  sourceLine: number
+}
+
+export type ReviewImpactGraphSummary = {
+  callersCount: number
+  calleesCount: number
+  dependentsCount: number
+  dependenciesCount: number
+  affectedFilesCount: number
+  affectedSymbolsCount: number
+  topImpactedFiles: Array<{ filePath: string; count: number }>
+}
+
+export type ReviewImpactGraphBackend = {
+  kind: "kitedb_fs"
+  resolveSnapshot: (args: {
+    integrationId: string | null
+    sourceBranch: string | null
+  }) => Promise<ReviewImpactGraphSnapshotResolution>
+  matchFindingLocation: (args: {
+    snapshot: ReviewImpactGraphSnapshotReady
+    filePath: string
+    line: number
+    title?: string
+    body?: string
+    evidence?: string
+  }) => Promise<ReviewImpactGraphNodeMatch | null>
+  summarizeImpact: (args: {
+    snapshot: ReviewImpactGraphSnapshotReady
+    nodeId: string
+  }) => Promise<ReviewImpactGraphSummary>
+}
+
+export type ReviewImpactServiceDeps = {
+  getAccessibleReview: (args: {
+    userId: string
+    reviewId: string
+  }) => Promise<ReviewImpactReviewRow | null>
+  getPersistedRows: (reviewId: string) => Promise<ReviewImpactRow[]>
+  findScopedIntegration: (args: {
+    instanceUrl: string
+    projectId: string
+  }) => Promise<{ id: string } | null>
+  findScopedMembership: (args: {
+    integrationId: string
+    userId: string
+  }) => Promise<{ integrationId: string } | null>
+  persistImpactRow: (row: PersistImpactRowInput) => Promise<void>
+  createBackend: () => ReviewImpactGraphBackend
+}
+
+const normalizeTopImpactedFiles = (value: unknown) => {
+  if (!Array.isArray(value)) {
+    return [] as Array<{ filePath: string; count: number }>
+  }
+
+  const next: Array<{ filePath: string; count: number }> = []
+  for (const item of value) {
+    if (!item || typeof item !== "object" || Array.isArray(item)) {
+      continue
+    }
+    const record = item as Record<string, unknown>
+    const filePath = String(record.filePath ?? "").trim()
+    const count = Number(record.count)
+    if (!filePath) {
+      continue
+    }
+    next.push({
+      filePath,
+      count: Number.isFinite(count) ? Math.max(0, Math.floor(count)) : 0,
+    })
+  }
+
+  return next
+}
+
+const toImpactResult = (row: ReviewImpactRow): ReviewFindingImpactResult => ({
+  commentKey: row.commentKey,
+  status: row.status,
+  scope: row.scope,
+  sourceNodeId: row.sourceNodeId,
+  sourceFile: row.sourceFile,
+  sourceLine: row.sourceLine,
+  impactLevel: row.impactLevel,
+  impactScore: row.impactScore,
+  callersCount: row.callersCount,
+  calleesCount: row.calleesCount,
+  dependentsCount: row.dependentsCount,
+  dependenciesCount: row.dependenciesCount,
+  affectedFilesCount: row.affectedFilesCount,
+  affectedSymbolsCount: row.affectedSymbolsCount,
+  topImpactedFiles: normalizeTopImpactedFiles(row.topImpactedFiles),
+  error: row.error,
+})
+
+const buildCommentKey = (finding: AiReviewFinding) =>
+  buildReviewCommentFeedbackKey({
+    file: finding.file,
+    side: finding.side,
+    line: finding.line,
+    title: finding.title,
+  })
+
+const toFindingsByCommentKey = (findings: AiReviewFinding[]) => {
+  const next = new Map<string, AiReviewFinding>()
+  for (const finding of findings) {
+    next.set(buildCommentKey(finding), finding)
+  }
+  return next
+}
+
+const getAccessibleReview = async ({
+  userId,
+  reviewId,
+  deps,
+}: {
+  userId: string
+  reviewId: string
+  deps: ReviewImpactServiceDeps
+}): Promise<ReviewImpactReviewRow> => {
+  const review = await deps.getAccessibleReview({ userId, reviewId })
+  if (!review) {
+    throw new ReviewImpactServiceError("not_found", "Review not found.")
+  }
+  return {
+    id: review.id,
+    findings: Array.isArray(review.findings) ? (review.findings as AiReviewFinding[]) : [],
+    instanceUrl: review.instanceUrl,
+    projectId: review.projectId,
+    integrationId: review.integrationId,
+    sourceBranch: review.sourceBranch,
+  }
+}
+
+const resolveGraphInfoFromRows = (
+  rows: ReviewImpactRow[],
+): ReviewImpactGraphInfo => {
+  let selected: ReviewImpactRow | null = null
+
+  for (const row of rows) {
+    if (!row.indexRunId || !row.graphGeneratedAt) {
+      continue
+    }
+    if (!selected) {
+      selected = row
+      continue
+    }
+
+    if (row.graphGeneratedAt.getTime() > selected.graphGeneratedAt!.getTime()) {
+      selected = row
+    }
+  }
+
+  if (!selected?.indexRunId || !selected.graphGeneratedAt) {
+    return null
+  }
+
+  return {
+    indexRunId: selected.indexRunId,
+    generatedAt: selected.graphGeneratedAt.toISOString(),
+  }
+}
+
+const resolveReviewImpactStatus = ({
+  rows,
+  expectedCount,
+}: {
+  rows: ReviewImpactRow[]
+  expectedCount: number
+}): Exclude<ReviewImpactStatus, "pending_graph"> => {
+  if (expectedCount === 0) {
+    return "completed"
+  }
+  if (rows.length === 0) {
+    return "not_started"
+  }
+
+  const uniqueRowCount = new Set(rows.map((row) => row.commentKey)).size
+  let succeededCount = 0
+  let failedCount = 0
+  let pendingCount = 0
+  for (const row of rows) {
+    if (row.status === "succeeded") {
+      succeededCount += 1
+      continue
+    }
+    if (row.status === "failed") {
+      failedCount += 1
+      continue
+    }
+    pendingCount += 1
+  }
+
+  if (pendingCount > 0 || uniqueRowCount < expectedCount) {
+    return "in_progress"
+  }
+
+  if (succeededCount > 0 && failedCount > 0) {
+    return "partial"
+  }
+  if (succeededCount >= expectedCount) {
+    return "completed"
+  }
+  if (failedCount >= expectedCount) {
+    return "failed"
+  }
+
+  return "in_progress"
+}
+
+const isImpactRowCurrentForSnapshot = ({
+  row,
+  snapshot,
+}: {
+  row: ReviewImpactRow
+  snapshot: ReviewImpactGraphSnapshotResolution | null
+}) => {
+  if (snapshot?.status !== "ready") {
+    return true
+  }
+
+  return row.indexRunId === snapshot.indexRunId
+}
+
+const selectRowsForSnapshot = ({
+  rows,
+  snapshot,
+}: {
+  rows: ReviewImpactRow[]
+  snapshot: ReviewImpactGraphSnapshotResolution | null
+}) => {
+  if (snapshot?.status !== "ready") {
+    return rows
+  }
+
+  return rows.filter((row) => isImpactRowCurrentForSnapshot({ row, snapshot }))
+}
+
+const buildFailedImpactRow = (args: {
+  reviewId: string
+  commentKey: string
+  finding: AiReviewFinding
+  error: string
+  indexRunId: string | null
+  graphGeneratedAt: Date | null
+}): PersistImpactRowInput => ({
+  reviewId: args.reviewId,
+  commentKey: args.commentKey,
+  status: "failed",
+  scope: null,
+  sourceNodeId: null,
+  sourceFile: args.finding.file,
+  sourceLine: args.finding.line,
+  impactScore: null,
+  impactLevel: null,
+  callersCount: 0,
+  calleesCount: 0,
+  dependentsCount: 0,
+  dependenciesCount: 0,
+  affectedFilesCount: 0,
+  affectedSymbolsCount: 0,
+  topImpactedFiles: [],
+  indexRunId: args.indexRunId,
+  graphGeneratedAt: args.graphGeneratedAt,
+  error: args.error,
+})
+
+const basePendingImpactForFinding = (
+  commentKey: string,
+): ReviewFindingImpactResult => ({
+  commentKey,
+  status: "pending",
+  scope: null,
+  impactLevel: null,
+  impactScore: null,
+  callersCount: 0,
+  calleesCount: 0,
+  dependentsCount: 0,
+  dependenciesCount: 0,
+  affectedFilesCount: 0,
+  affectedSymbolsCount: 0,
+  topImpactedFiles: [],
+  error: null,
+})
+
+const buildImpactByKeyWithPending = ({
+  findingsByKey,
+  rows,
+}: {
+  findingsByKey: Map<string, AiReviewFinding>
+  rows: ReviewImpactRow[]
+}) => {
+  const impactByKey = Object.fromEntries(
+    rows.map((row) => [row.commentKey, toImpactResult(row)]),
+  )
+  for (const commentKey of findingsByKey.keys()) {
+    if (commentKey in impactByKey) {
+      continue
+    }
+    impactByKey[commentKey] = basePendingImpactForFinding(commentKey)
+  }
+  return impactByKey
+}
+
+const resolveGraphInfo = ({
+  rows,
+  snapshot,
+}: {
+  rows: ReviewImpactRow[]
+  snapshot: ReviewImpactGraphSnapshotResolution | null
+}): ReviewImpactGraphInfo => {
+  const fromRows = resolveGraphInfoFromRows(rows)
+  if (fromRows) {
+    return fromRows
+  }
+
+  if (snapshot?.status === "ready") {
+    return {
+      indexRunId: snapshot.indexRunId,
+      generatedAt: snapshot.generatedAt,
+    }
+  }
+
+  return null
+}
+
+const toScopeValue = (value: unknown) =>
+  String(value ?? "")
+    .trim()
+    .replace(/\/+$/, "")
+
+const resolveReviewGraphScope = async ({
+  userId,
+  review,
+  deps,
+}: {
+  userId: string
+  review: ReviewImpactReviewRow
+  deps: ReviewImpactServiceDeps
+}) => {
+  if (review.integrationId) {
+    return {
+      integrationId: review.integrationId,
+      sourceBranch: review.sourceBranch,
+    }
+  }
+
+  const instanceUrl = toScopeValue(review.instanceUrl)
+  const projectId = String(review.projectId ?? "").trim()
+  if (!instanceUrl || !projectId) {
+    return {
+      integrationId: null,
+      sourceBranch: review.sourceBranch,
+    }
+  }
+
+  const integration = await deps.findScopedIntegration({ instanceUrl, projectId })
+  if (!integration?.id) {
+    return {
+      integrationId: null,
+      sourceBranch: review.sourceBranch,
+    }
+  }
+
+  const membership = await deps.findScopedMembership({
+    integrationId: integration.id,
+    userId,
+  })
+  if (!membership?.integrationId) {
+    return {
+      integrationId: null,
+      sourceBranch: review.sourceBranch,
+    }
+  }
+
+  return {
+    integrationId: integration.id,
+    sourceBranch: review.sourceBranch,
+  }
+}
+
+const toTelemetry = ({
+  backend,
+  snapshot,
+  graphScope,
+}: {
+  backend: ReviewImpactGraphBackend
+  snapshot: ReviewImpactGraphSnapshotResolution | null
+  graphScope: {
+    integrationId: string | null
+    sourceBranch: string | null
+  }
+}): ReviewImpactTelemetry => ({
+  graphBackend: backend.kind,
+  graphResolutionStatus: snapshot?.status ?? "not_checked",
+  graphPendingReason: snapshot?.status === "pending_graph" ? snapshot.reason : null,
+  branch: graphScope.sourceBranch,
+  integrationId: graphScope.integrationId,
+})
+
+export const loadPersistedReviewImpactsWithDeps = async (args: {
+  userId: string
+  reviewId: string
+  deps: ReviewImpactServiceDeps
+}): Promise<ReviewImpactResponse> => {
+  const review = await getAccessibleReview({
+    userId: args.userId,
+    reviewId: args.reviewId,
+    deps: args.deps,
+  })
+  const findingsByKey = toFindingsByCommentKey(review.findings)
+  const rows = await args.deps.getPersistedRows(review.id)
+
+  const backend = args.deps.createBackend()
+  const graphScope = await resolveReviewGraphScope({
+    userId: args.userId,
+    review,
+    deps: args.deps,
+  })
+  let snapshot: ReviewImpactGraphSnapshotResolution | null = null
+  if (findingsByKey.size > 0) {
+    snapshot = await backend.resolveSnapshot({
+      integrationId: graphScope.integrationId,
+      sourceBranch: graphScope.sourceBranch,
+    })
+  }
+  const currentRows = selectRowsForSnapshot({ rows, snapshot })
+
+  const baseStatus = resolveReviewImpactStatus({
+    rows: currentRows,
+    expectedCount: findingsByKey.size,
+  })
+
+  const pendingSnapshot = snapshot?.status === "pending_graph" ? snapshot : null
+  const shouldMarkPendingGraph =
+    pendingSnapshot !== null &&
+    (baseStatus === "not_started" || baseStatus === "in_progress")
+
+  return {
+    reviewId: review.id,
+    status: shouldMarkPendingGraph ? "pending_graph" : baseStatus,
+    impactByKey: shouldMarkPendingGraph
+      ? buildImpactByKeyWithPending({ findingsByKey, rows: currentRows })
+      : Object.fromEntries(
+          currentRows.map((row) => [row.commentKey, toImpactResult(row)]),
+        ),
+    graph: resolveGraphInfo({ rows: currentRows, snapshot }),
+    pendingReason: shouldMarkPendingGraph ? pendingSnapshot.reason : null,
+    telemetry: toTelemetry({ backend, snapshot, graphScope }),
+  }
+}
+
+export const computeAndPersistReviewImpactsWithDeps = async (args: {
+  userId: string
+  reviewId: string
+  force: boolean
+  deps: ReviewImpactServiceDeps
+}): Promise<ReviewImpactComputeResponse> => {
+  const review = await getAccessibleReview({
+    userId: args.userId,
+    reviewId: args.reviewId,
+    deps: args.deps,
+  })
+  const findingsByKey = toFindingsByCommentKey(review.findings)
+  const backend = args.deps.createBackend()
+  const graphScope = await resolveReviewGraphScope({
+    userId: args.userId,
+    review,
+    deps: args.deps,
+  })
+
+  if (findingsByKey.size === 0) {
+    return {
+      reviewId: review.id,
+      status: "completed",
+      computedCount: 0,
+      failedCount: 0,
+      impactByKey: {},
+      graph: null,
+      pendingReason: null,
+      telemetry: toTelemetry({ backend, snapshot: null, graphScope }),
+    }
+  }
+
+  const existingRows = await args.deps.getPersistedRows(review.id)
+  const existingByKey = new Map(
+    existingRows.map((row) => [row.commentKey, row]),
+  )
+  const snapshot = await backend.resolveSnapshot({
+    integrationId: graphScope.integrationId,
+    sourceBranch: graphScope.sourceBranch,
+  })
+
+  if (snapshot.status === "pending_graph") {
+    const impactByKey = buildImpactByKeyWithPending({
+      findingsByKey,
+      rows: existingRows,
+    })
+    const failedCount = Object.values(impactByKey).filter(
+      (impact) => impact.status === "failed",
+    ).length
+
+    return {
+      reviewId: review.id,
+      status: "pending_graph",
+      computedCount: 0,
+      failedCount,
+      impactByKey,
+      graph: resolveGraphInfo({ rows: existingRows, snapshot }),
+      pendingReason: snapshot.reason,
+      telemetry: toTelemetry({ backend, snapshot, graphScope }),
+    }
+  }
+
+  const graphErrorMessage = snapshot.status === "error" ? snapshot.error : null
+  let computedCount = 0
+
+  for (const [commentKey, finding] of findingsByKey.entries()) {
+    const existing = existingByKey.get(commentKey)
+    if (
+      !args.force &&
+      existing &&
+      existing.status !== "pending" &&
+      isImpactRowCurrentForSnapshot({ row: existing, snapshot })
+    ) {
+      continue
+    }
+
+    computedCount += 1
+
+    if (graphErrorMessage) {
+      await args.deps.persistImpactRow(
+        buildFailedImpactRow({
+          reviewId: review.id,
+          commentKey,
+          finding,
+          error: graphErrorMessage,
+          indexRunId: null,
+          graphGeneratedAt: null,
+        }),
+      )
+      continue
+    }
+
+    if (snapshot.status !== "ready") {
+      continue
+    }
+
+    try {
+      const match = await backend.matchFindingLocation({
+        snapshot,
+        filePath: finding.file,
+        line: finding.line,
+        title: finding.title,
+        body: finding.body,
+        evidence: finding.evidence,
+      })
+      if (!match) {
+        await args.deps.persistImpactRow(
+          buildFailedImpactRow({
+            reviewId: review.id,
+            commentKey,
+            finding,
+            error: "No graph node matched this finding location.",
+            indexRunId: snapshot.indexRunId,
+            graphGeneratedAt: new Date(snapshot.generatedAt),
+          }),
+        )
+        continue
+      }
+
+      const impact = await backend.summarizeImpact({
+        snapshot,
+        nodeId: match.nodeId,
+      })
+
+      const impactScore = computeImpactScore({
+        callersCount: impact.callersCount,
+        calleesCount: impact.calleesCount,
+        dependentsCount: impact.dependentsCount,
+        dependenciesCount: impact.dependenciesCount,
+        affectedFilesCount: impact.affectedFilesCount,
+      })
+
+      await args.deps.persistImpactRow({
+        reviewId: review.id,
+        commentKey,
+        status: "succeeded",
+        scope: match.scope,
+        sourceNodeId: match.nodeId,
+        sourceFile: match.sourceFile,
+        sourceLine: match.sourceLine,
+        impactScore,
+        impactLevel: computeImpactLevel(impactScore),
+        callersCount: impact.callersCount,
+        calleesCount: impact.calleesCount,
+        dependentsCount: impact.dependentsCount,
+        dependenciesCount: impact.dependenciesCount,
+        affectedFilesCount: impact.affectedFilesCount,
+        affectedSymbolsCount: impact.affectedSymbolsCount,
+        topImpactedFiles: impact.topImpactedFiles,
+        indexRunId: snapshot.indexRunId,
+        graphGeneratedAt: new Date(snapshot.generatedAt),
+        error: null,
+      })
+    } catch (error) {
+      await args.deps.persistImpactRow(
+        buildFailedImpactRow({
+          reviewId: review.id,
+          commentKey,
+          finding,
+          error: errorMessage(error),
+          indexRunId: snapshot.indexRunId,
+          graphGeneratedAt: new Date(snapshot.generatedAt),
+        }),
+      )
+    }
+  }
+
+  const loaded = await loadPersistedReviewImpactsWithDeps({
+    userId: args.userId,
+    reviewId: review.id,
+    deps: args.deps,
+  })
+  const failedCount = Object.values(loaded.impactByKey).filter(
+    (impact) => impact.status === "failed",
+  ).length
+
+  return {
+    ...loaded,
+    computedCount,
+    failedCount,
+  }
+}
