@@ -0,0 +1,211 @@
+import { describe, expect, mock, test } from "bun:test"
+
+import {
+  indexBranchStates,
+  indexFileStates,
+  indexRunFileChanges,
+  indexRuns,
+} from "@/lib/db/schema"
+
+type FinalizeRun = {
+  id: string
+  branchStateId: string
+  baseSha: string | null
+  headSha: string
+  status: string
+}
+
+const loadFinalizeModule = async (dbMock: unknown) => {
+  mock.module("@/lib/db", () => ({ db: dbMock }))
+  return import(`./finalize.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+}
+
+const createFinalizeDbMock = (args: {
+  run: FinalizeRun | null
+  casSuccess: boolean
+  stagedChanges?: Array<{
+    path: string
+    changeType: "upsert" | "delete"
+    fileId: string | null
+    sizeBytes: number | null
+    skipReason: string | null
+  }>
+}) => {
+  const calls = {
+    deleteCalls: 0,
+    insertCalls: 0,
+    runUpdates: [] as Array<Record<string, unknown>>,
+  }
+
+  const tx = {
+    select: () => ({
+      from: (table: unknown) => {
+        if (table === indexRuns) {
+          return {
+            where: () => ({
+              limit: () => Promise.resolve(args.run ? [args.run] : []),
+            }),
+          }
+        }
+
+        if (table === indexRunFileChanges) {
+          return {
+            where: () => Promise.resolve(args.stagedChanges ?? []),
+          }
+        }
+
+        throw new Error("Unexpected select table in finalize test.")
+      },
+    }),
+    update: (table: unknown) => ({
+      set: (values: Record<string, unknown>) => {
+        if (table === indexRuns) {
+          calls.runUpdates.push(values)
+          return {
+            where: () => Promise.resolve([]),
+          }
+        }
+
+        if (table === indexBranchStates) {
+          return {
+            where: () => ({
+              returning: () => Promise.resolve(args.casSuccess ? [{ id: "branch-state-1" }] : []),
+            }),
+          }
+        }
+
+        throw new Error("Unexpected update table in finalize test.")
+      },
+    }),
+    delete: (table: unknown) => {
+      if (table !== indexFileStates) {
+        throw new Error("Unexpected delete table in finalize test.")
+      }
+
+      return {
+        where: () => {
+          calls.deleteCalls += 1
+          return Promise.resolve([])
+        },
+      }
+    },
+    insert: (table: unknown) => {
+      if (table !== indexFileStates) {
+        throw new Error("Unexpected insert table in finalize test.")
+      }
+
+      return {
+        values: () => ({
+          onConflictDoUpdate: () => {
+            calls.insertCalls += 1
+            return Promise.resolve([])
+          },
+        }),
+      }
+    },
+  }
+
+  const db = {
+    transaction: async <T>(callback: (txArg: typeof tx) => Promise<T>) => callback(tx),
+    update: () => ({
+      set: () => ({
+        where: () => Promise.resolve([]),
+      }),
+    }),
+  }
+
+  return { db, calls }
+}
+
+describe("finalizeIndexRun", () => {
+  test("applies staged changes and marks ready when CAS succeeds", async () => {
+    const dbMock = createFinalizeDbMock({
+      run: {
+        id: "run-1",
+        branchStateId: "branch-state-1",
+        baseSha: "base-sha-1",
+        headSha: "head-sha-1",
+        status: "indexing",
+      },
+      casSuccess: true,
+      stagedChanges: [
+        {
+          path: "deleted.ts",
+          changeType: "delete",
+          fileId: null,
+          sizeBytes: null,
+          skipReason: "deleted",
+        },
+        {
+          path: "new.ts",
+          changeType: "upsert",
+          fileId: "file-1",
+          sizeBytes: 123,
+          skipReason: null,
+        },
+      ],
+    })
+
+    const mod = await loadFinalizeModule(dbMock.db)
+    const result = await mod.finalizeIndexRun("run-1")
+
+    expect(result.status).toBe("ready")
+    expect(dbMock.calls.deleteCalls).toBe(1)
+    expect(dbMock.calls.insertCalls).toBe(1)
+    expect(
+      dbMock.calls.runUpdates.some((entry) => entry.status === "ready"),
+    ).toBe(true)
+  })
+
+  test("marks run superseded and skips file mutations on CAS miss", async () => {
+    const dbMock = createFinalizeDbMock({
+      run: {
+        id: "run-2",
+        branchStateId: "branch-state-1",
+        baseSha: "base-sha-1",
+        headSha: "head-sha-2",
+        status: "ingesting",
+      },
+      casSuccess: false,
+      stagedChanges: [
+        {
+          path: "new.ts",
+          changeType: "upsert",
+          fileId: "file-2",
+          sizeBytes: 456,
+          skipReason: null,
+        },
+      ],
+    })
+
+    const mod = await loadFinalizeModule(dbMock.db)
+    const result = await mod.finalizeIndexRun("run-2")
+
+    expect(result.status).toBe("superseded")
+    expect(dbMock.calls.deleteCalls).toBe(0)
+    expect(dbMock.calls.insertCalls).toBe(0)
+    expect(
+      dbMock.calls.runUpdates.some((entry) => entry.status === "superseded"),
+    ).toBe(true)
+  })
+
+  test("returns invalid_state for non-finalizable statuses", async () => {
+    const dbMock = createFinalizeDbMock({
+      run: {
+        id: "run-3",
+        branchStateId: "branch-state-1",
+        baseSha: null,
+        headSha: "head-sha-3",
+        status: "ready",
+      },
+      casSuccess: true,
+    })
+
+    const mod = await loadFinalizeModule(dbMock.db)
+    const result = await mod.finalizeIndexRun("run-3")
+
+    expect(result.status).toBe("invalid_state")
+    expect(dbMock.calls.deleteCalls).toBe(0)
+    expect(dbMock.calls.insertCalls).toBe(0)
+  })
+})
