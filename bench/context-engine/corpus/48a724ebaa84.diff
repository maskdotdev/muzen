+import { beforeEach, describe, expect, mock, test } from "bun:test"
+
+import { indexBranchStates, indexRunFileChanges, indexRuns } from "@/lib/db/schema"
+
+const loadIngestModule = async (deps: {
+  db: unknown
+  runSnapshotIngest: ReturnType<typeof mock>
+  runDeltaIngest: ReturnType<typeof mock>
+  finalizeIndexRun: ReturnType<typeof mock>
+  markIndexRunFailed: ReturnType<typeof mock>
+}) => {
+  mock.module("@/lib/db", () => ({ db: deps.db }))
+  mock.module("@/lib/indexing/snapshot", () => ({
+    runSnapshotIngest: deps.runSnapshotIngest,
+  }))
+  mock.module("@/lib/indexing/delta", () => ({
+    runDeltaIngest: deps.runDeltaIngest,
+    DeltaSnapshotFallbackError,
+  }))
+  mock.module("@/lib/indexing/finalize", () => ({
+    finalizeIndexRun: deps.finalizeIndexRun,
+    markIndexRunFailed: deps.markIndexRunFailed,
+  }))
+
+  return import(`./ingest.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+}
+
+type IngestRun = {
+  id: string
+  status: string
+  mode: "snapshot" | "delta"
+  branchStateId: string
+  baseSha: string | null
+  headSha: string
+  artifactsPrefix: string
+  configHash: string
+  integrationId: string
+}
+
+class DeltaSnapshotFallbackError extends Error {
+  readonly reason: string
+
+  constructor(reason: string) {
+    super(`Delta ingest fallback required: ${reason}`)
+    this.reason = reason
+    this.name = "DeltaSnapshotFallbackError"
+  }
+}
+
+const createIngestDbMock = (args: {
+  run: IngestRun | null
+  stagedChanges?: Array<{
+    path: string
+    changeType: "upsert" | "delete"
+    fileId: string | null
+  }>
+}) => {
+  const calls = {
+    updates: [] as Array<Record<string, unknown>>,
+  }
+
+  const db = {
+    select: () => ({
+      from: (table: unknown) => {
+        if (table === indexRuns) {
+          return {
+            innerJoin: (_joinTable: unknown) => {
+              if (_joinTable !== indexBranchStates) {
+                throw new Error("Unexpected join table in ingest test.")
+              }
+              return {
+                where: () => ({
+                  limit: () => Promise.resolve(args.run ? [args.run] : []),
+                }),
+              }
+            },
+          }
+        }
+
+        if (table === indexRunFileChanges) {
+          return {
+            where: () => Promise.resolve(args.stagedChanges ?? []),
+          }
+        }
+
+        throw new Error("Unexpected select table in ingest test.")
+      },
+    }),
+    update: () => ({
+      set: (values: Record<string, unknown>) => {
+        calls.updates.push(values)
+        return {
+          where: () => Promise.resolve([]),
+        }
+      },
+    }),
+  }
+
+  return {
+    db,
+    calls,
+  }
+}
+
+const createVectorStoreMock = () => ({
+  upsertChunks: async () => {},
+  queryCandidates: async () => [],
+  deleteStaleByPath: mock(async () => {}),
+})
+
+beforeEach(() => {
+  delete process.env.INDEXER_ARTIFACTS_BACKEND
+})
+
+describe("processIngestJob", () => {
+  test("returns skipped when run does not exist", async () => {
+    const ingestDb = createIngestDbMock({
+      run: null,
+    })
+    const runSnapshotIngest = mock(async () => ({ stats: { filesIndexed: 0 } }))
+    const runDeltaIngest = mock(async () => ({ stats: { filesIndexed: 0 } }))
+    const finalizeIndexRun = mock(async () => ({ runId: "x", status: "ready" as const }))
+    const markIndexRunFailed = mock(async () => {})
+    const mod = await loadIngestModule({
+      db: ingestDb.db,
+      runSnapshotIngest,
+      runDeltaIngest,
+      finalizeIndexRun,
+      markIndexRunFailed,
+    })
+
+    const vectorStore = createVectorStoreMock()
+    const result = await mod.processIngestJob(
+      { runId: "missing" },
+      {
+        source: {} as never,
+        vectorStore,
+        artifactStore: {} as never,
+      },
+    )
+
+    expect(result.status).toBe("skipped")
+    expect(runSnapshotIngest).toHaveBeenCalledTimes(0)
+    expect(runDeltaIngest).toHaveBeenCalledTimes(0)
+    expect(finalizeIndexRun).toHaveBeenCalledTimes(0)
+  })
+
+  test("marks failed when snapshot ingest throws", async () => {
+    const ingestDb = createIngestDbMock({
+      run: {
+        id: "run-1",
+        status: "planned",
+        mode: "snapshot",
+        branchStateId: "branch-state-1",
+        baseSha: null,
+        headSha: "head-sha-1",
+        artifactsPrefix: "integrations/x/runs/default/main/head/run-1",
+        configHash: "default-v1",
+        integrationId: "integration-1",
+      },
+    })
+    const runSnapshotIngest = mock(async () => {
+      throw new Error("boom")
+    })
+    const runDeltaIngest = mock(async () => ({ stats: { filesIndexed: 0 } }))
+    const finalizeIndexRun = mock(async () => ({ runId: "run-1", status: "ready" as const }))
+    const markIndexRunFailed = mock(async () => {})
+    const mod = await loadIngestModule({
+      db: ingestDb.db,
+      runSnapshotIngest,
+      runDeltaIngest,
+      finalizeIndexRun,
+      markIndexRunFailed,
+    })
+
+    const vectorStore = createVectorStoreMock()
+    const result = await mod.processIngestJob(
+      { runId: "run-1" },
+      {
+        source: {} as never,
+        vectorStore,
+        artifactStore: {} as never,
+      },
+    )
+
+    expect(result.status).toBe("failed")
+    expect(markIndexRunFailed).toHaveBeenCalledTimes(1)
+    expect(runDeltaIngest).toHaveBeenCalledTimes(0)
+    expect(finalizeIndexRun).toHaveBeenCalledTimes(0)
+  })
+
+  test("uses delta path for delta-mode runs and cleans stale vectors when ready", async () => {
+    const ingestDb = createIngestDbMock({
+      run: {
+        id: "run-2",
+        status: "planned",
+        mode: "delta",
+        branchStateId: "branch-state-1",
+        baseSha: "base-sha-1",
+        headSha: "head-sha-2",
+        artifactsPrefix: "integrations/x/runs/default/main/head/run-2",
+        configHash: "default-v1",
+        integrationId: "integration-1",
+      },
+      stagedChanges: [
+        {
+          path: "src/a.ts",
+          changeType: "upsert",
+          fileId: "file-a",
+        },
+        {
+          path: "src/b.ts",
+          changeType: "delete",
+          fileId: null,
+        },
+      ],
+    })
+    const runSnapshotIngest = mock(async () => ({
+      stats: {
+        filesScanned: 10,
+      },
+    }))
+    const runDeltaIngest = mock(async () => ({
+      stats: {
+        filesFetched: 2,
+      },
+    }))
+    const finalizeIndexRun = mock(async () => ({ runId: "run-2", status: "ready" as const }))
+    const markIndexRunFailed = mock(async () => {})
+    const mod = await loadIngestModule({
+      db: ingestDb.db,
+      runSnapshotIngest,
+      runDeltaIngest,
+      finalizeIndexRun,
+      markIndexRunFailed,
+    })
+
+    const vectorStore = createVectorStoreMock()
+    const result = await mod.processIngestJob(
+      { runId: "run-2" },
+      {
+        source: {} as never,
+        vectorStore,
+        artifactStore: {} as never,
+      },
+    )
+
+    expect(result.status).toBe("ready")
+    expect(runDeltaIngest).toHaveBeenCalledTimes(1)
+    expect(runSnapshotIngest).toHaveBeenCalledTimes(0)
+    expect(finalizeIndexRun).toHaveBeenCalledTimes(1)
+    expect(vectorStore.deleteStaleByPath).toHaveBeenCalledTimes(2)
+    expect(vectorStore.deleteStaleByPath).toHaveBeenNthCalledWith(1, {
+      branchStateId: "branch-state-1",
+      path: "src/a.ts",
+      keepFileId: "file-a",
+    })
+    expect(vectorStore.deleteStaleByPath).toHaveBeenNthCalledWith(2, {
+      branchStateId: "branch-state-1",
+      path: "src/b.ts",
+      keepFileId: null,
+    })
+
+    const statsUpdate = ingestDb.calls.updates.find(
+      (entry) => typeof entry.stats === "object" && entry.stats !== null,
+    )
+    expect(statsUpdate?.stats).toMatchObject({
+      filesFetched: 2,
+      ingestMode: "delta",
+      modeFallback: null,
+    })
+  })
+
+  test("falls back from delta to snapshot when delta ingest requests fallback", async () => {
+    const ingestDb = createIngestDbMock({
+      run: {
+        id: "run-22",
+        status: "planned",
+        mode: "delta",
+        branchStateId: "branch-state-1",
+        baseSha: "base-sha-1",
+        headSha: "head-sha-22",
+        artifactsPrefix: "integrations/x/runs/default/main/head/run-22",
+        configHash: "default-v1",
+        integrationId: "integration-1",
+      },
+    })
+    const runSnapshotIngest = mock(async () => ({
+      stats: {
+        filesScanned: 4,
+      },
+    }))
+    const runDeltaIngest = mock(async () => {
+      throw new DeltaSnapshotFallbackError("compare_invalid")
+    })
+    const finalizeIndexRun = mock(async () => ({ runId: "run-22", status: "ready" as const }))
+    const markIndexRunFailed = mock(async () => {})
+    const mod = await loadIngestModule({
+      db: ingestDb.db,
+      runSnapshotIngest,
+      runDeltaIngest,
+      finalizeIndexRun,
+      markIndexRunFailed,
+    })
+
+    const vectorStore = createVectorStoreMock()
+    const result = await mod.processIngestJob(
+      { runId: "run-22" },
+      {
+        source: {} as never,
+        vectorStore,
+        artifactStore: {} as never,
+      },
+    )
+
+    expect(result.status).toBe("ready")
+    expect(runDeltaIngest).toHaveBeenCalledTimes(1)
+    expect(runSnapshotIngest).toHaveBeenCalledTimes(1)
+    expect(finalizeIndexRun).toHaveBeenCalledTimes(1)
+
+    const statsUpdate = ingestDb.calls.updates.find(
+      (entry) => typeof entry.stats === "object" && entry.stats !== null,
+    )
+    expect(statsUpdate?.stats).toMatchObject({
+      filesScanned: 4,
+      ingestMode: "delta",
+      modeFallback: "snapshot",
+      modeFallbackReason: "compare_invalid",
+    })
+  })
+
+  test("does not run stale-vector cleanup when finalize is superseded", async () => {
+    const ingestDb = createIngestDbMock({
+      run: {
+        id: "run-3",
+        status: "planned",
+        mode: "snapshot",
+        branchStateId: "branch-state-1",
+        baseSha: null,
+        headSha: "head-sha-3",
+        artifactsPrefix: "integrations/x/runs/default/main/head/run-3",
+        configHash: "default-v1",
+        integrationId: "integration-1",
+      },
+      stagedChanges: [
+        {
+          path: "src/c.ts",
+          changeType: "upsert",
+          fileId: "file-c",
+        },
+      ],
+    })
+    const runSnapshotIngest = mock(async () => ({ stats: { filesScanned: 1 } }))
+    const runDeltaIngest = mock(async () => ({ stats: { filesScanned: 1 } }))
+    const finalizeIndexRun = mock(async () => ({ runId: "run-3", status: "superseded" as const }))
+    const markIndexRunFailed = mock(async () => {})
+    const mod = await loadIngestModule({
+      db: ingestDb.db,
+      runSnapshotIngest,
+      runDeltaIngest,
+      finalizeIndexRun,
+      markIndexRunFailed,
+    })
+
+    const vectorStore = createVectorStoreMock()
+    const result = await mod.processIngestJob(
+      { runId: "run-3" },
+      {
+        source: {} as never,
+        vectorStore,
+        artifactStore: {} as never,
+      },
+    )
+
+    expect(result.status).toBe("superseded")
+    expect(runDeltaIngest).toHaveBeenCalledTimes(0)
+    expect(vectorStore.deleteStaleByPath).toHaveBeenCalledTimes(0)
+  })
+})
