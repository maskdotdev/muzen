+import { execFile } from "node:child_process"
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+import { promisify } from "node:util"
+import { describe, expect, mock, test } from "bun:test"
+
+import { indexFileStates, indexRunFileChanges } from "@/lib/db/schema"
+import { sha256Hex } from "@/lib/utils/hash"
+
+const execFileAsync = promisify(execFile)
+
+const loadSnapshotModule = async (deps: {
+  db: unknown
+  buildVectorChunks: ReturnType<typeof mock>
+  embedVectorChunks: ReturnType<typeof mock>
+}) => {
+  mock.module("@/lib/db", () => ({ db: deps.db }))
+  mock.module("@/lib/indexing/chunker", () => ({
+    buildVectorChunks: deps.buildVectorChunks,
+  }))
+  mock.module("@/lib/indexing/embedder", () => ({
+    embedVectorChunks: deps.embedVectorChunks,
+  }))
+
+  return import(`./snapshot.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+}
+
+const createArchive = async (files: Record<string, string>) => {
+  const root = await mkdtemp(path.join(os.tmpdir(), "argus-snapshot-test-"))
+  const repoDir = path.join(root, "repo")
+  await mkdir(repoDir, { recursive: true })
+
+  for (const [relativePath, content] of Object.entries(files)) {
+    const absolutePath = path.join(repoDir, relativePath)
+    await mkdir(path.dirname(absolutePath), { recursive: true })
+    await writeFile(absolutePath, content, "utf8")
+  }
+
+  const archivePath = path.join(root, "repo.tar.gz")
+  await execFileAsync("tar", ["-czf", archivePath, "-C", root, "repo"])
+  return {
+    root,
+    archivePath,
+  }
+}
+
+const createSnapshotDbMock = (args: {
+  existingStates: Array<{ path: string; fileId: string }>
+}) => {
+  const staged = new Map<
+    string,
+    {
+      runId: string
+      path: string
+      changeType: "upsert" | "delete"
+      fileId: string | null
+      sizeBytes: number | null
+      skipReason: string | null
+    }
+  >()
+
+  const db = {
+    select: () => ({
+      from: (table: unknown) => {
+        if (table !== indexFileStates) {
+          throw new Error("Unexpected select table in snapshot test.")
+        }
+        return {
+          where: () => Promise.resolve(args.existingStates),
+        }
+      },
+    }),
+    delete: (table: unknown) => {
+      if (table !== indexRunFileChanges) {
+        throw new Error("Unexpected delete table in snapshot test.")
+      }
+      return {
+        where: () => {
+          staged.clear()
+          return Promise.resolve([])
+        },
+      }
+    },
+    insert: (table: unknown) => {
+      if (table !== indexRunFileChanges) {
+        throw new Error("Unexpected insert table in snapshot test.")
+      }
+      return {
+        values: (value: {
+          runId: string
+          path: string
+          changeType: "upsert" | "delete"
+          fileId: string | null
+          sizeBytes: number | null
+          skipReason: string | null
+        }) => ({
+          onConflictDoUpdate: () => {
+            staged.set(value.path, value)
+            return Promise.resolve([])
+          },
+        }),
+      }
+    },
+  }
+
+  return {
+    db,
+    staged,
+  }
+}
+
+describe("runSnapshotIngest", () => {
+  test("stages only changed files and deletes removed paths", async () => {
+    const sameContent = "const same = 1\n"
+    const changedContent = "export const changed = true\n"
+
+    const archive = await createArchive({
+      "same.ts": sameContent,
+      "change.ts": changedContent,
+    })
+
+    try {
+      const dbMock = createSnapshotDbMock({
+        existingStates: [
+          {
+            path: "same.ts",
+            fileId: sha256Hex(Buffer.from(sameContent, "utf8")),
+          },
+          {
+            path: "gone.ts",
+            fileId: "gone-file-id",
+          },
+        ],
+      })
+
+      const buildVectorChunks = mock(async ({ path: filePath, content }: { path: string; content: string }) => [
+        {
+          chunkIndex: 0,
+          chunkId: `${filePath}-chunk-0`,
+          content,
+          metadata: { path: filePath },
+        },
+      ])
+      const embedVectorChunks = mock(async (chunks: Array<Record<string, unknown>>) =>
+        chunks.map((chunk) => ({
+          ...chunk,
+          embedding: [0.1, 0.2, 0.3],
+        })),
+      )
+
+      const mod = await loadSnapshotModule({
+        db: dbMock.db,
+        buildVectorChunks,
+        embedVectorChunks,
+      })
+
+      const vectorStore = {
+        upsertChunks: mock(async () => {}),
+        queryCandidates: async () => [],
+        deleteStaleByPath: async () => {},
+      }
+      const artifactStore = {
+        writeManifest: mock(async () => {}),
+        writeChangedFiles: mock(async () => {}),
+        writeRunJson: mock(async () => {}),
+      }
+      const source = {
+        resolveHeadSha: async () => "head-sha-1",
+        compare: async () => ({ valid: true, incomplete: false, changes: [] }),
+        fetchFile: async () => ({ path: "x.ts", content: Buffer.from("x") }),
+        downloadArchive: async () => ({ archivePath: archive.archivePath }),
+      }
+
+      const result = await mod.runSnapshotIngest({
+        run: {
+          runId: "run-1",
+          branchStateId: "branch-state-1",
+          integrationId: "integration-1",
+          configHash: "default-v1",
+          headSha: "head-sha-1",
+          artifactsPrefix: "integrations/x/runs/default/main/head-sha-1/run-1",
+        },
+        source,
+        vectorStore,
+        artifactStore,
+      })
+
+      expect(result.stats).toMatchObject({
+        filesScanned: 2,
+        filesUnchanged: 1,
+        filesIndexed: 1,
+        filesDeleted: 1,
+      })
+
+      expect(dbMock.staged.get("change.ts")).toMatchObject({
+        changeType: "upsert",
+      })
+      expect(dbMock.staged.get("gone.ts")).toMatchObject({
+        changeType: "delete",
+        skipReason: "deleted",
+      })
+      expect(dbMock.staged.has("same.ts")).toBe(false)
+      expect(vectorStore.upsertChunks).toHaveBeenCalledTimes(1)
+      expect(artifactStore.writeManifest).toHaveBeenCalledTimes(1)
+      expect(artifactStore.writeChangedFiles).toHaveBeenCalledTimes(1)
+      expect(artifactStore.writeRunJson).toHaveBeenCalledTimes(1)
+    } finally {
+      await rm(archive.root, { recursive: true, force: true })
+    }
+  })
+})
