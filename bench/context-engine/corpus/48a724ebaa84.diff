+import { beforeEach, describe, expect, mock, test } from "bun:test"
+
+import { indexBranchStates, indexConfigs, indexRuns } from "@/lib/db/schema"
+import type { GitLabSource, PlanJob } from "@/lib/indexing/contracts"
+
+const withEnv = async <T>(
+  overrides: Partial<NodeJS.ProcessEnv>,
+  fn: () => Promise<T> | T,
+) => {
+  const previous = new Map<string, string | undefined>()
+  for (const [key, value] of Object.entries(overrides)) {
+    previous.set(key, process.env[key])
+    if (value === undefined) {
+      delete process.env[key]
+    } else {
+      process.env[key] = value
+    }
+  }
+
+  try {
+    return await fn()
+  } finally {
+    for (const [key, value] of previous.entries()) {
+      if (value === undefined) {
+        delete process.env[key]
+      } else {
+        process.env[key] = value
+      }
+    }
+  }
+}
+
+type PlanDbOptions = {
+  lastReadySha: string | null
+  insertedRun?: {
+    id: string
+    branchStateId: string
+    headSha: string
+    baseSha: string | null
+    mode: "snapshot" | "delta"
+  } | null
+}
+
+const createPlanDbMock = (options: PlanDbOptions) => {
+  const calls: {
+    configInsert?: Record<string, unknown>
+    branchInsert?: Record<string, unknown>
+    runInsert?: Record<string, unknown>
+    runUpdate?: Record<string, unknown>
+  } = {}
+
+  const db = {
+    insert: (table: unknown) => ({
+      values: (values: Record<string, unknown>) => {
+        if (table === indexConfigs) {
+          calls.configInsert = values
+          return {
+            onConflictDoUpdate: () => Promise.resolve([]),
+          }
+        }
+
+        if (table === indexBranchStates) {
+          calls.branchInsert = values
+          return {
+            onConflictDoUpdate: () => ({
+              returning: () =>
+                Promise.resolve([
+                  {
+                    id: "branch-state-1",
+                    lastReadySha: options.lastReadySha,
+                  },
+                ]),
+            }),
+          }
+        }
+
+        if (table === indexRuns) {
+          calls.runInsert = values
+          return {
+            onConflictDoNothing: () => ({
+              returning: () =>
+                Promise.resolve(
+                  options.insertedRun
+                    ? [options.insertedRun]
+                    : [],
+                ),
+            }),
+          }
+        }
+
+        throw new Error("Unexpected insert table in plan test.")
+      },
+    }),
+    select: () => ({
+      from: (table: unknown) => {
+        if (table !== indexRuns) {
+          throw new Error("Unexpected select table in plan test.")
+        }
+
+        return {
+          where: () => ({
+            limit: () =>
+              Promise.resolve([
+                {
+                  id: "existing-run-id",
+                  branchStateId: "branch-state-1",
+                  headSha: "head-sha-123",
+                  baseSha: options.lastReadySha,
+                  mode: "snapshot" as const,
+                },
+              ]),
+          }),
+        }
+      },
+    }),
+    update: (table: unknown) => ({
+      set: (values: Record<string, unknown>) => {
+        if (table === indexRuns) {
+          calls.runUpdate = values
+        }
+        return {
+          where: () => Promise.resolve([]),
+        }
+      },
+    }),
+  }
+
+  return {
+    db,
+    calls,
+  }
+}
+
+const createSourceMock = (args?: {
+  headSha?: string
+  compare?: {
+    valid: boolean
+    incomplete: boolean
+    changes: Array<{ oldPath: string | null; newPath: string | null; type: "added" | "modified" | "deleted" | "renamed" }>
+  }
+}) => {
+  const resolveHeadSha = mock(async () => args?.headSha ?? "head-sha-123")
+  const compare = mock(async () => args?.compare ?? { valid: true, incomplete: false, changes: [] })
+
+  const source = {
+    resolveHeadSha,
+    compare,
+    fetchFile: async () => ({ path: "x.ts", content: Buffer.from("x") }),
+    downloadArchive: async () => ({ archivePath: "/tmp/archive.tar.gz" }),
+  } satisfies GitLabSource
+
+  return {
+    source,
+    resolveHeadSha,
+    compare,
+  }
+}
+
+const loadPlanModule = async (dbMock: unknown) => {
+  mock.module("@/lib/db", () => ({ db: dbMock }))
+  return import(`./plan.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+}
+
+const baseJob: PlanJob = {
+  integrationId: "11111111-1111-1111-1111-111111111111",
+  branch: "main",
+}
+
+beforeEach(() => {
+  delete process.env.INDEXER_ENABLE_DELTA
+  delete process.env.INDEXER_DELTA_FALLBACK_THRESHOLD
+})
+
+describe("processPlanJob", () => {
+  test("uses snapshot mode when branch has no last ready sha", async () =>
+    withEnv(
+      {
+        INDEXER_ENABLE_DELTA: "1",
+      },
+      async () => {
+        const planDb = createPlanDbMock({
+          lastReadySha: null,
+          insertedRun: {
+            id: "run-1",
+            branchStateId: "branch-state-1",
+            headSha: "head-sha-123",
+            baseSha: null,
+            mode: "snapshot",
+          },
+        })
+        const sourceMock = createSourceMock()
+        const mod = await loadPlanModule(planDb.db)
+
+        const result = await mod.processPlanJob(baseJob, { source: sourceMock.source })
+
+        expect(result.mode).toBe("snapshot")
+        expect(planDb.calls.runInsert?.mode).toBe("snapshot")
+        expect(sourceMock.compare).toHaveBeenCalledTimes(0)
+      },
+    ))
+
+  test("uses delta mode when compare is valid and below fallback threshold", async () =>
+    withEnv(
+      {
+        INDEXER_ENABLE_DELTA: "1",
+        INDEXER_DELTA_FALLBACK_THRESHOLD: "5",
+      },
+      async () => {
+        const planDb = createPlanDbMock({
+          lastReadySha: "base-sha-456",
+          insertedRun: {
+            id: "run-2",
+            branchStateId: "branch-state-1",
+            headSha: "head-sha-123",
+            baseSha: "base-sha-456",
+            mode: "delta",
+          },
+        })
+        const sourceMock = createSourceMock({
+          compare: {
+            valid: true,
+            incomplete: false,
+            changes: [{ oldPath: "a.ts", newPath: "a.ts", type: "modified" }],
+          },
+        })
+        const mod = await loadPlanModule(planDb.db)
+
+        const result = await mod.processPlanJob(baseJob, { source: sourceMock.source })
+
+        expect(result.mode).toBe("delta")
+        expect(planDb.calls.runInsert?.mode).toBe("delta")
+        expect(sourceMock.compare).toHaveBeenCalledTimes(1)
+      },
+    ))
+
+  test("falls back to snapshot when compare is invalid or too large", async () =>
+    withEnv(
+      {
+        INDEXER_ENABLE_DELTA: "1",
+        INDEXER_DELTA_FALLBACK_THRESHOLD: "2",
+      },
+      async () => {
+        const planDb = createPlanDbMock({
+          lastReadySha: "base-sha-456",
+          insertedRun: {
+            id: "run-3",
+            branchStateId: "branch-state-1",
+            headSha: "head-sha-123",
+            baseSha: "base-sha-456",
+            mode: "snapshot",
+          },
+        })
+        const sourceMock = createSourceMock({
+          compare: {
+            valid: true,
+            incomplete: false,
+            changes: [
+              { oldPath: "a.ts", newPath: "a.ts", type: "modified" },
+              { oldPath: "b.ts", newPath: "b.ts", type: "modified" },
+              { oldPath: "c.ts", newPath: "c.ts", type: "modified" },
+            ],
+          },
+        })
+        const mod = await loadPlanModule(planDb.db)
+
+        const result = await mod.processPlanJob(baseJob, { source: sourceMock.source })
+
+        expect(result.mode).toBe("snapshot")
+        expect(planDb.calls.runInsert?.mode).toBe("snapshot")
+      },
+    ))
+
+  test("rejects invalid config hash", async () => {
+    const planDb = createPlanDbMock({
+      lastReadySha: null,
+      insertedRun: null,
+    })
+    const sourceMock = createSourceMock()
+    const mod = await loadPlanModule(planDb.db)
+
+    await expect(
+      mod.processPlanJob(
+        {
+          ...baseJob,
+          configHash: "../bad",
+        },
+        { source: sourceMock.source },
+      ),
+    ).rejects.toThrow("Invalid config hash.")
+  })
+})
