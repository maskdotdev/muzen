+import { getCurrentActiveReviewDiff } from "@/features/review/server/diff/review-diff"
+import { runWithAuthenticatedApiRoute } from "@/server/api/authenticated-route"
+
+export const runtime = "nodejs"
+
+export async function GET(request: Request) {
+  return runWithAuthenticatedApiRoute({
+    request,
+    path: "/api/review/diff/active",
+    event: "api.review.diff.active",
+    handler: async ({ userId, logger }) => {
+      return getCurrentActiveReviewDiff({
+        request,
+        userId,
+        logger,
+      })
+    },
+  })
+}
