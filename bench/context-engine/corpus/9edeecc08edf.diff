+export async function getCurrentActiveReviewDiff({
+  request,
+  userId,
+  logger,
+  deps,
+}: {
+  request: Request
+  userId: string
+  logger: {
+    set: (context: Record<string, unknown>) => void
+  }
+  deps?: ActiveReviewDeps
+}) {
+  const activeReviewDeps = deps ?? (await buildReviewDiffActiveDeps())
+  const scope = resolveReviewScopeFromSearchParams(new URL(request.url).searchParams)
+  if (!scope) {
+    return {
+      status: 400,
+      outcome: "invalid_request",
+      response: NextResponse.json(
+        { error: "instanceUrl, projectId, and mergeRequestIid are required." },
+        { status: 400 },
+      ),
+    }
+  }
+
+  const latestActiveRun = await activeReviewDeps.getLatestActiveReviewFlowRunForScope({
+    userId,
+    scope,
+  })
+
+  let activeRun: ReturnType<typeof resolveCurrentActiveRun> | null = null
+  if (latestActiveRun?.status === "in_progress") {
+    try {
+      const currentComparison = await resolveCurrentReviewComparison({
+        userId,
+        scope,
+        source: latestActiveRun.source,
+        integrationId: null,
+        deps: activeReviewDeps,
+      })
+      activeRun = resolveCurrentActiveRun({
+        activeRun: latestActiveRun,
+        currentComparison,
+      })
+    } catch {
+      activeRun = null
+    }
+  }
+
+  logger.set({
+    activeRunFound: Boolean(activeRun),
+    activeRunTraceId: activeRun?.traceId ?? null,
+    activeRunStage: activeRun?.stage ?? null,
+  })
+
+  return {
+    status: 200,
+    outcome: "success",
+    response: NextResponse.json({
+      data: {
+        activeRun,
+      },
+    }),
+  }
+}
