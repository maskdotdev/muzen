+import { afterEach, describe, expect, mock, test } from "bun:test"
+
+import { mockAuthenticatedApiRoute } from "@/app/api/_test/authenticated-route-harness"
+
+afterEach(() => {
+  mock.restore()
+})
+
+describe("review diff active route", () => {
+  test("returns 401 when unauthenticated", async () => {
+    mockAuthenticatedApiRoute({ userId: null })
+    mock.module("@/features/review/server/diff/review-diff", () => ({
+      getCurrentActiveReviewDiff: mock(async () => ({
+        status: 200,
+        outcome: "success",
+        response: Response.json({ data: { activeRun: null } }),
+      })),
+    }))
+
+    const routeModule = await import(`./route?cacheBust=${Math.random().toString(36).slice(2)}`)
+    const response = await routeModule.GET(
+      new Request(
+        "http://localhost/api/review/diff/active?instanceUrl=https%3A%2F%2Fgitlab.example.com&projectId=123&mergeRequestIid=42",
+      ),
+    )
+
+    expect(response.status).toBe(401)
+    expect(await response.json()).toEqual({ error: "Unauthorized" })
+  })
+})
