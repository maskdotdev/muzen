+        let mut client = self.lock_client()?;
+        let sql =
+            format!("SELECT {REVIEW_SESSION_COLUMNS} FROM muzen_review_sessions WHERE id = $1");
+        let row = client
+            .query_opt(&sql, &[&id.as_str()])
+            .map_err(postgres_store_error)?;
