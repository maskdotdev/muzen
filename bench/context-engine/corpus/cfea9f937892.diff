index 00000000..1ef99a70
--- /dev/null
+++ b/apps/review-worker/src/issue-service.ts
@@ -0,0 +1,152 @@
+import { GitLabApiError, getProjectIssue } from "@argus/adapters/gitlab/api-client"
+import { fetchGitLabIssueWithDeps } from "@argus/adapters/issues/providers/gitlab"
+import { fetchJiraIssueWithDeps } from "@argus/adapters/issues/providers/jira"
+import {
+  fetchIssueWithDeps,
+  resolveIssuesFromMergeRequestWithDeps,
+} from "@argus/adapters/issues/issue-service"
+import type {
+  IssueFetchInput,
+  IssueLookupContext,
+  ResolvedIssueRef,
+} from "@argus/adapters/issues/types"
+import { getJiraIssueByKey, JiraClientError } from "@argus/adapters/jira/api-client"
+import {
+  decryptToken,
+  parseAes256GcmKey,
+  type EncryptedToken,
+} from "@argus/shared-runtime/encrypted-token"
+
+import { pool } from "./db"
+import {
+  getIntegrationById,
+  resolveManagedIntegrationToken,
+} from "./gitlab-integrations"
+
+type QueryResult = {
+  rows: Record<string, unknown>[]
+}
+
+type JiraCredentialsRow = {
+  baseUrl: string
+  tokenCiphertext: string
+  tokenIv: string
+  tokenAuthTag: string
+}
+
+type ReviewWorkerIssueQueryExecutor = (
+  query: string,
+  values?: unknown[],
+) => Promise<QueryResult>
+
+const query: ReviewWorkerIssueQueryExecutor = async (text, values) => {
+  const result = await pool.query(text, values)
+  return { rows: result.rows }
+}
+
+const decryptStoredToken = (encrypted: EncryptedToken) =>
+  decryptToken(
+    encrypted,
+    parseAes256GcmKey(
+      process.env.GITLAB_TOKEN_ENCRYPTION_KEY ?? "",
+      "GITLAB_TOKEN_ENCRYPTION_KEY",
+    ),
+  )
+
+const toJiraCredentialsRow = (row: Record<string, unknown> | undefined) => {
+  if (!row) {
+    return null
+  }
+
+  const credentials: JiraCredentialsRow = {
+    baseUrl: String(row.baseUrl ?? ""),
+    tokenCiphertext: String(row.tokenCiphertext ?? ""),
+    tokenIv: String(row.tokenIv ?? ""),
+    tokenAuthTag: String(row.tokenAuthTag ?? ""),
+  }
+
+  return credentials.baseUrl &&
+    credentials.tokenCiphertext &&
+    credentials.tokenIv &&
+    credentials.tokenAuthTag
+    ? credentials
+    : null
+}
+
+export const getStoredJiraCredentials = async (userId: string) => {
+  const result = await query(
+    `
+      select
+        base_url as "baseUrl",
+        token_ciphertext as "tokenCiphertext",
+        token_iv as "tokenIv",
+        token_auth_tag as "tokenAuthTag"
+      from jira_credentials
+      where user_id = $1
+      limit 1
+    `,
+    [userId],
+  )
+  const row = toJiraCredentialsRow(result.rows[0])
+  if (!row) {
+    return null
+  }
+
+  return {
+    baseUrl: row.baseUrl,
+    token: decryptStoredToken({
+      ciphertext: row.tokenCiphertext,
+      iv: row.tokenIv,
+      authTag: row.tokenAuthTag,
+    }),
+  }
+}
+
+export const fetchGitLabIssue = (args: {
+  ref: ResolvedIssueRef
+  context: IssueLookupContext
+}) =>
+  fetchGitLabIssueWithDeps(args, {
+    getProjectIssue,
+    isGitLabApiError: (error): error is GitLabApiError => error instanceof GitLabApiError,
+    resolveGitLabTokenForRequest: async ({ context }) => {
+      const integrationId = context.integrationId?.trim()
+      if (!integrationId) {
+        throw new Error("GitLab integration is required for issue lookup.")
+      }
+
+      const integration = await getIntegrationById(integrationId)
+      if (!integration) {
+        throw new Error(`GitLab integration ${integrationId} not found.`)
+      }
+
+      return {
+        token: await resolveManagedIntegrationToken({ integration }),
+      }
+    },
+  })
+
+export const fetchJiraIssue = (args: {
+  ref: ResolvedIssueRef
+  context: IssueLookupContext
+}) =>
+  fetchJiraIssueWithDeps(args, {
+    getJiraIssueByKey,
+    getStoredJiraCredentials,
+    isJiraClientError: (error): error is JiraClientError => error instanceof JiraClientError,
+  })
+
+const issueServiceDeps = {
+  fetchGitLabIssue,
+  fetchJiraIssue,
+}
+
+export const fetchIssue = (
+  input: IssueFetchInput | ResolvedIssueRef,
+  context: IssueLookupContext,
+) => fetchIssueWithDeps(input, context, issueServiceDeps)
+
+export const resolveIssuesFromMergeRequest = (
+  metadata: Parameters<typeof resolveIssuesFromMergeRequestWithDeps>[0],
+  context: IssueLookupContext,
+) => resolveIssuesFromMergeRequestWithDeps(metadata, context, issueServiceDeps)
diff --git a/apps/review-worker/src/review-argus-agent.ts b/apps/review-worker/src/review-argus-agent.ts
