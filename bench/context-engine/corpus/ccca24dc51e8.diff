+const splitPatchIntoFileChunks = (patchText: string) => {
+  const splitByFile = patchText.split(/^diff --git /m)
+  if (splitByFile.length <= 1) {
+    return []
+  }
+
+  const metadataPrefix = splitByFile[0].trim()
+
+  return splitByFile
+    .slice(1)
+    .map((part, index) => {
+      const chunk = `diff --git ${part}`.trim()
+      if (!chunk) {
+        return ""
+      }
+      if (index === 0 && metadataPrefix) {
+        return `${metadataPrefix}\n${chunk}`
+      }
+      return chunk
+    })
