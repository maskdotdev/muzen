diff --git a/src/app/api/jira/route.ts b/src/app/api/jira/route.ts
new file mode 100644
index 00000000..6371bef7
--- /dev/null
+++ b/src/app/api/jira/route.ts
@@ -0,0 +1,88 @@
+import { NextResponse } from "next/server"
+import { z } from "zod"
+
+import {
+  getJiraErrorStatus,
+  listJiraBoards,
+  listJiraIssuesForSprint,
+  listJiraSprints,
+  testJiraConnection,
+  validateJiraCredentials,
+} from "@/lib/jira/client"
+import { getSessionUserId } from "@/lib/session"
+
+const credentialsSchema = z.object({
+  baseUrl: z.string().min(1),
+  email: z.string().min(1),
+  token: z.string().min(1),
+})
+
+const actionSchema = z.discriminatedUnion("action", [
+  z.object({
+    action: z.literal("validate"),
+    ...credentialsSchema.shape,
+  }),
+  z.object({
+    action: z.literal("test-connection"),
+    ...credentialsSchema.shape,
+  }),
+  z.object({
+    action: z.literal("boards"),
+    ...credentialsSchema.shape,
+  }),
+  z.object({
+    action: z.literal("sprints"),
+    ...credentialsSchema.shape,
+    boardId: z.number().int().positive(),
+  }),
+  z.object({
+    action: z.literal("issues"),
+    ...credentialsSchema.shape,
+    sprintId: z.number().int().positive(),
+  }),
+])
+
+export async function POST(request: Request) {
+  const [userId, payload] = await Promise.all([
+    getSessionUserId(),
+    request.json().catch(() => null),
+  ])
+
+  if (!userId) {
+    return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
+  }
+
+  const parsed = actionSchema.safeParse(payload)
+  if (!parsed.success) {
+    return NextResponse.json({ error: "Invalid Jira request payload." }, { status: 400 })
+  }
+
+  try {
+    if (parsed.data.action === "validate") {
+      const result = await validateJiraCredentials(parsed.data)
+      return NextResponse.json({ data: result })
+    }
+
+    if (parsed.data.action === "test-connection") {
+      const result = await testJiraConnection(parsed.data)
+      return NextResponse.json({ data: result })
+    }
+
+    if (parsed.data.action === "boards") {
+      const boards = await listJiraBoards(parsed.data)
+      return NextResponse.json({ data: boards })
+    }
+
+    if (parsed.data.action === "sprints") {
+      const sprints = await listJiraSprints(parsed.data)
+      return NextResponse.json({ data: sprints })
+    }
+
+    const issues = await listJiraIssuesForSprint(parsed.data)
+    return NextResponse.json({ data: issues })
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "Jira request failed."
+    const status = getJiraErrorStatus(error)
+    return NextResponse.json({ error: message }, { status })
+  }
+}
diff --git a/src/components/integrations/jira-integration-card.tsx b/src/components/integrations/jira-integration-card.tsx
new file mode 100644
index 00000000..cc149d22
