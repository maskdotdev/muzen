diff --git a/apps/web/src/features/review/components/diff/file-tree.tsx b/apps/web/src/features/review/components/diff/file-tree.tsx
new file mode 100644
index 00000000..56f04fea
--- /dev/null
+++ b/apps/web/src/features/review/components/diff/file-tree.tsx
@@ -0,0 +1,260 @@
+"use client"
+
+import type { FileDiffMetadata } from "@pierre/diffs"
+import {
+  ChevronLeftIcon,
+  ChevronRightIcon,
+  FilesIcon,
+} from "lucide-react"
+import { useCallback, useEffect, useMemo, useRef, useState } from "react"
+import type { CSSProperties } from "react"
+import { preparePresortedFileTreeInput, type GitStatusEntry } from "@pierre/trees"
+import {
+  FileTree,
+  useFileTree,
+} from "@pierre/trees/react"
+
+import { Button } from "@/components/ui/button"
+import { cn } from "@/lib/utils"
+
+type MergeRequestDiffFileTreeProps = {
+  files: FileDiffMetadata[]
+  getFileKey: (file: FileDiffMetadata) => string
+  onSelectFileKey: (fileKey: string) => void
+}
+
+const COLLAPSED_TREE_WIDTH = 44
+const DEFAULT_TREE_WIDTH = 288
+const MIN_TREE_WIDTH = 220
+const MAX_TREE_WIDTH = 520
+
+const TREE_STYLE = {
+  "--trees-bg-override": "transparent",
+  "--trees-bg-muted-override": "hsl(var(--muted) / 0.45)",
+  "--trees-fg-override": "hsl(var(--foreground))",
+  "--trees-fg-muted-override": "hsl(var(--muted-foreground))",
+  "--trees-accent-override": "hsl(var(--accent))",
+  "--trees-border-color-override": "hsl(var(--border))",
+  "--trees-focus-ring-color-override": "hsl(var(--ring))",
+  "--trees-selected-bg-override": "hsl(var(--accent))",
+  "--trees-selected-fg-override": "hsl(var(--accent-foreground))",
+} as CSSProperties
+
+const TREE_STATUS_ONLY_GIT_CSS = `
+  [data-item-git-status] > [data-item-section='icon'] > :where(:not([data-icon-name='file-tree-icon-chevron'])),
+  [data-item-git-status] > [data-item-section='content'] {
+    color: var(--trees-fg);
+  }
+`
+
+const getDiffFileTreePath = (file: FileDiffMetadata) =>
+  (file.name || file.prevName || "").trim()
+
+const toGitStatus = (file: FileDiffMetadata): GitStatusEntry["status"] => {
+  if (file.type === "new") return "added"
+  if (file.type === "deleted") return "deleted"
+  if (file.type === "rename-pure" || file.type === "rename-changed") {
+    return "renamed"
+  }
+  return "modified"
+}
+
+export function MergeRequestDiffFileTree({
+  files,
+  getFileKey,
+  onSelectFileKey,
+}: MergeRequestDiffFileTreeProps) {
+  const [isCollapsed, setIsCollapsed] = useState(false)
+  const [treeWidth, setTreeWidth] = useState(DEFAULT_TREE_WIDTH)
+  const treeRef = useRef<HTMLElement | null>(null)
+
+  const treeInput = useMemo(() => {
+    const nextPaths: string[] = []
+    const seen = new Set<string>()
+    const nextPathToFileKey = new Map<string, string>()
+
+    for (const file of files) {
+      const path = getDiffFileTreePath(file)
+      if (!path || seen.has(path)) {
+        continue
+      }
+
+      seen.add(path)
+      nextPaths.push(path)
+      nextPathToFileKey.set(path, getFileKey(file))
+    }
+
+    return {
+      pathToFileKey: nextPathToFileKey,
+      paths: nextPaths,
+    }
+  }, [files, getFileKey])
+  const { pathToFileKey, paths } = treeInput
+  const pathToFileKeyRef = useRef(pathToFileKey)
+  const onSelectFileKeyRef = useRef(onSelectFileKey)
+
+  const preparedInput = useMemo(() => preparePresortedFileTreeInput(paths), [paths])
+  const gitStatus = useMemo<GitStatusEntry[]>(
+    () =>
+      files
+        .map((file) => {
+          const path = getDiffFileTreePath(file)
+          return path ? { path, status: toGitStatus(file) } : null
+        })
+        .filter((entry): entry is GitStatusEntry => entry !== null),
+    [files],
+  )
+
+  useEffect(() => {
+    onSelectFileKeyRef.current = onSelectFileKey
+  }, [onSelectFileKey])
+
+  useEffect(() => {
+    pathToFileKeyRef.current = pathToFileKey
+  }, [pathToFileKey])
+
+  const handleSelectionChange = useCallback((selectedPaths: readonly string[]) => {
+    const selectedPath = selectedPaths.at(-1)
+    if (!selectedPath) {
+      return
+    }
+
+    const fileKey = pathToFileKeyRef.current.get(selectedPath)
+    if (fileKey) {
+      onSelectFileKeyRef.current(fileKey)
+    }
+  }, [])
+
+  const { model } = useFileTree({
+    density: "compact",
+    fileTreeSearchMode: "hide-non-matches",
+    flattenEmptyDirectories: true,
+    gitStatus,
+    icons: {
+      colored: false,
+      set: "standard",
+    },
+    initialExpansion: "open",
+    onSelectionChange: handleSelectionChange,
+    paths,
+    preparedInput,
+    search: true,
+    stickyFolders: true,
+    unsafeCSS: TREE_STATUS_ONLY_GIT_CSS,
+  })
+
+  useEffect(() => {
+    model.resetPaths(paths, { preparedInput })
+    model.setGitStatus(gitStatus)
+  }, [gitStatus, model, paths, preparedInput])
+
+  const handleResizePointerDown = useCallback(
+    (event: React.PointerEvent<HTMLButtonElement>) => {
+      if (isCollapsed || event.button !== 0) {
+        return
+      }
+
+      event.preventDefault()
+      event.currentTarget.setPointerCapture(event.pointerId)
+    },
+    [isCollapsed],
+  )
+
+  const handleResizePointerMove = useCallback(
+    (event: React.PointerEvent<HTMLButtonElement>) => {
+      if (isCollapsed || !event.currentTarget.hasPointerCapture(event.pointerId)) {
+        return
+      }
+
+      const treeLeft = treeRef.current?.getBoundingClientRect().left
+      if (treeLeft == null) {
+        return
+      }
+
+      const nextWidth = event.clientX - treeLeft
+      setTreeWidth(Math.min(MAX_TREE_WIDTH, Math.max(MIN_TREE_WIDTH, nextWidth)))
+    },
+    [isCollapsed],
+  )
+
+  const handleResizePointerUp = useCallback(
+    (event: React.PointerEvent<HTMLButtonElement>) => {
+      if (event.currentTarget.hasPointerCapture(event.pointerId)) {
+        event.currentTarget.releasePointerCapture(event.pointerId)
+      }
+    },
+    [],
+  )
+
+  return (
+    <aside
+      ref={treeRef}
+      data-diff-file-tree={isCollapsed ? "collapsed" : "expanded"}
+      className={cn(
+        "relative flex min-h-0 shrink-0 flex-col overflow-hidden rounded-lg border border-border/70 bg-background/95",
+        isCollapsed && "transition-[width] duration-200",
+      )}
+      style={{ width: isCollapsed ? COLLAPSED_TREE_WIDTH : treeWidth }}
+    >
+      <div
+        className={cn(
+          "flex h-11 shrink-0 items-center border-b border-border/70 px-2",
+          isCollapsed ? "justify-center" : "gap-2",
+        )}
+      >
+        {!isCollapsed ? (
+          <>
+            <FilesIcon className="size-4 shrink-0 text-muted-foreground" />
+            <span className="min-w-0 flex-1 truncate text-xs font-semibold uppercase text-muted-foreground">
+              Files
+            </span>
+          </>
+        ) : null}
+        <Button
+          type="button"
+          variant="ghost"
+          size="icon"
+          className={cn("size-7 shrink-0", !isCollapsed && "ml-auto")}
+          onClick={() => setIsCollapsed((current) => !current)}
+        >
+          {isCollapsed ? (
+            <ChevronRightIcon className="size-4" />
+          ) : (
+            <ChevronLeftIcon className="size-4" />
+          )}
+          <span className="sr-only">
+            {isCollapsed ? "Expand file tree" : "Collapse file tree"}
+          </span>
+        </Button>
+      </div>
+
+      {isCollapsed ? null : (
+        <div className="min-h-0 flex-1 overflow-hidden px-1.5 py-2">
+          {paths.length > 0 ? (
+            <FileTree
+              model={model}
+              className="h-full w-full overflow-hidden"
+              style={TREE_STYLE}
+            />
+          ) : (
+            <div className="px-2 py-3 text-xs text-muted-foreground">
+              No files
+            </div>
+          )}
+        </div>
+      )}
+
+      {!isCollapsed ? (
+        <button
+          type="button"
+          aria-label="Resize file tree"
+          className="absolute inset-y-0 right-[-4px] z-10 w-2 cursor-col-resize touch-none bg-transparent outline-none transition-colors hover:bg-primary/20 focus-visible:bg-primary/25"
+          onPointerDown={handleResizePointerDown}
+          onPointerMove={handleResizePointerMove}
+          onPointerUp={handleResizePointerUp}
+          onPointerCancel={handleResizePointerUp}
+        />
+      ) : null}
+    </aside>
+  )
+}
