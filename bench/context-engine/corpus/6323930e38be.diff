diff --git a/scripts/indexing-benchmark-compare.ts b/scripts/indexing-benchmark-compare.ts
new file mode 100644
index 00000000..532bdf8f
--- /dev/null
+++ b/scripts/indexing-benchmark-compare.ts
@@ -0,0 +1,186 @@
+import { readFile, readdir } from 'node:fs/promises'
+import path from 'node:path'
+
+type BenchmarkScenarioResult = {
+  scenario: string
+  ingestMs: number
+}
+
+type BenchmarkSummary = {
+  fallbackRate: number
+}
+
+type BenchmarkReport = {
+  results: BenchmarkScenarioResult[]
+  summary: BenchmarkSummary
+}
+
+const DEFAULT_REPORTS_DIR = path.join(process.cwd(), '.benchmarks', 'indexing')
+const DEFAULT_BASELINE_PATH = path.join(DEFAULT_REPORTS_DIR, 'phase2-baseline.json')
+const DEFAULT_MAX_FALLBACK_RATE = 0.05
+const DEFAULT_MAX_REGRESSION = 0.15
+
+const parsePositiveNumber = (raw: string | undefined, fallback: number): number => {
+  if (!raw) {
+    return fallback
+  }
+
+  const value = Number.parseFloat(raw)
+  if (!Number.isFinite(value) || value < 0) {
+    return fallback
+  }
+  return value
+}
+
+const getArgValue = (flag: string): string | null => {
+  const args = process.argv.slice(2)
+  const index = args.indexOf(flag)
+  if (index < 0) {
+    return null
+  }
+
+  const next = args[index + 1]
+  if (!next || next.startsWith('--')) {
+    return null
+  }
+
+  return next
+}
+
+const listReportFiles = async (reportsDir: string): Promise<string[]> => {
+  const entries = await readdir(reportsDir, { withFileTypes: true })
+  return entries
+    .filter((entry) => entry.isFile())
+    .map((entry) => entry.name)
+    .filter((name) => /^phase2-.*\.json$/.test(name) && name !== 'phase2-baseline.json')
+    .sort()
+}
+
+const resolveLatestReportPath = async (reportsDir: string): Promise<string> => {
+  const reportFiles = await listReportFiles(reportsDir)
+  const latest = reportFiles[reportFiles.length - 1]
+  if (!latest) {
+    throw new Error(`No benchmark reports found in ${reportsDir}. Run bench:indexing:phase2 first.`)
+  }
+
+  return path.join(reportsDir, latest)
+}
+
+const readReport = async (filePath: string): Promise<BenchmarkReport> => {
+  const payload = JSON.parse(await readFile(filePath, 'utf8')) as unknown
+  if (!payload || typeof payload !== 'object') {
+    throw new Error(`Invalid benchmark report: ${filePath}`)
+  }
+
+  const report = payload as Partial<BenchmarkReport>
+  if (!Array.isArray(report.results) || !report.summary || typeof report.summary !== 'object') {
+    throw new Error(`Benchmark report missing required fields: ${filePath}`)
+  }
+
+  return report as BenchmarkReport
+}
+
+const main = async () => {
+  const reportsDir = process.env.INDEXING_BENCH_REPORTS_DIR?.trim() || DEFAULT_REPORTS_DIR
+  const baselinePath = process.env.INDEXING_BENCH_BASELINE_PATH?.trim() || DEFAULT_BASELINE_PATH
+  const candidateArg = getArgValue('--candidate')
+
+  const candidatePath = candidateArg
+    ? path.resolve(candidateArg)
+    : await resolveLatestReportPath(reportsDir)
+
+  const maxFallbackRate = parsePositiveNumber(
+    process.env.INDEXING_BENCH_MAX_FALLBACK_RATE,
+    DEFAULT_MAX_FALLBACK_RATE,
+  )
+  const maxRegression = parsePositiveNumber(
+    process.env.INDEXING_BENCH_MAX_REGRESSION,
+    DEFAULT_MAX_REGRESSION,
+  )
+
+  const baseline = await readReport(baselinePath)
+  const candidate = await readReport(candidatePath)
+
+  const baselineByScenario = new Map(
+    baseline.results.map((result) => [result.scenario, result]),
+  )
+  const candidateByScenario = new Map(
+    candidate.results.map((result) => [result.scenario, result]),
+  )
+
+  const scenarioRows = Array.from(baselineByScenario.keys()).map((scenario) => {
+    const base = baselineByScenario.get(scenario)
+    const next = candidateByScenario.get(scenario)
+    if (!base || !next) {
+      return {
+        scenario,
+        baselineIngestMs: base?.ingestMs ?? null,
+        candidateIngestMs: next?.ingestMs ?? null,
+        regressionPct: null,
+        status: 'missing',
+      }
+    }
+
+    const regression =
+      base.ingestMs > 0
+        ? (next.ingestMs - base.ingestMs) / base.ingestMs
+        : next.ingestMs === 0
+          ? 0
+          : Number.POSITIVE_INFINITY
+
+    return {
+      scenario,
+      baselineIngestMs: Number(base.ingestMs.toFixed(2)),
+      candidateIngestMs: Number(next.ingestMs.toFixed(2)),
+      regressionPct: Number((regression * 100).toFixed(2)),
+      status: regression <= maxRegression ? 'pass' : 'fail',
+    }
+  })
+
+  const missingScenarios = scenarioRows.filter((row) => row.status === 'missing')
+  const failedScenarios = scenarioRows.filter((row) => row.status === 'fail')
+  const fallbackRate = Number(candidate.summary.fallbackRate ?? 0)
+  const fallbackRateFailed = fallbackRate > maxFallbackRate
+
+  console.log(`Baseline: ${baselinePath}`)
+  console.log(`Candidate: ${candidatePath}`)
+  console.table(
+    scenarioRows.map((row) => ({
+      scenario: row.scenario,
+      baselineMs: row.baselineIngestMs ?? '-',
+      candidateMs: row.candidateIngestMs ?? '-',
+      regressionPct: row.regressionPct ?? '-',
+      status: row.status,
+    })),
+  )
+  console.log(
+    `Fallback rate: ${(fallbackRate * 100).toFixed(2)}% (max ${(maxFallbackRate * 100).toFixed(2)}%)`,
+  )
+  console.log(`Max allowed regression: ${(maxRegression * 100).toFixed(2)}%`)
+
+  if (missingScenarios.length > 0 || failedScenarios.length > 0 || fallbackRateFailed) {
+    if (missingScenarios.length > 0) {
+      console.error(
+        `Missing scenarios in candidate report: ${missingScenarios.map((row) => row.scenario).join(', ')}`,
+      )
+    }
+    if (failedScenarios.length > 0) {
+      console.error(
+        `Regression failures: ${failedScenarios.map((row) => row.scenario).join(', ')}`,
+      )
+    }
+    if (fallbackRateFailed) {
+      console.error(
+        `Fallback rate ${fallbackRate.toFixed(4)} exceeded max ${maxFallbackRate.toFixed(4)}.`,
+      )
+    }
+    process.exit(1)
+  }
+
+  console.log('Benchmark comparison passed.')
+}
+
+main().catch((error) => {
+  console.error('[indexing-benchmark:compare] failed', error)
+  process.exit(1)
+})
