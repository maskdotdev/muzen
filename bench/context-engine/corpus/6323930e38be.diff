+import { copyFile, mkdir, readdir } from 'node:fs/promises'
+import path from 'node:path'
+
+const DEFAULT_REPORTS_DIR = path.join(process.cwd(), '.benchmarks', 'indexing')
+const DEFAULT_BASELINE_PATH = path.join(DEFAULT_REPORTS_DIR, 'phase2-baseline.json')
+
+const getArgValue = (flag: string): string | null => {
+  const args = process.argv.slice(2)
+  const index = args.indexOf(flag)
+  if (index < 0) {
+    return null
+  }
+
+  const next = args[index + 1]
+  if (!next || next.startsWith('--')) {
+    return null
+  }
+
+  return next
+}
+
+const listReportFiles = async (reportsDir: string): Promise<string[]> => {
+  const entries = await readdir(reportsDir, { withFileTypes: true })
+  return entries
+    .filter((entry) => entry.isFile())
+    .map((entry) => entry.name)
+    .filter((name) => /^phase2-.*\.json$/.test(name) && name !== 'phase2-baseline.json')
+    .sort()
+}
+
+const resolveLatestReportPath = async (reportsDir: string): Promise<string> => {
+  const reportFiles = await listReportFiles(reportsDir)
+  const latest = reportFiles[reportFiles.length - 1]
+  if (!latest) {
+    throw new Error(`No benchmark reports found in ${reportsDir}. Run bench:indexing:phase2 first.`)
+  }
+
+  return path.join(reportsDir, latest)
+}
+
+const main = async () => {
+  const reportsDir = process.env.INDEXING_BENCH_REPORTS_DIR?.trim() || DEFAULT_REPORTS_DIR
+  const baselinePath = process.env.INDEXING_BENCH_BASELINE_PATH?.trim() || DEFAULT_BASELINE_PATH
+  const explicitSource = getArgValue('--source')
+
+  await mkdir(path.dirname(baselinePath), { recursive: true })
+
+  const sourcePath = explicitSource
+    ? path.resolve(explicitSource)
+    : await resolveLatestReportPath(reportsDir)
+
+  await copyFile(sourcePath, baselinePath)
+  console.log(`Baseline updated: ${baselinePath}`)
+  console.log(`Source report: ${sourcePath}`)
+}
+
+main().catch((error) => {
+  console.error('[indexing-benchmark:set-baseline] failed', error)
+  process.exit(1)
+})
diff --git a/scripts/indexing-benchmark.ts b/scripts/indexing-benchmark.ts
new file mode 100644
index 00000000..393b5932
--- /dev/null
+++ b/scripts/indexing-benchmark.ts
@@ -0,0 +1,443 @@
+import { randomUUID } from 'node:crypto'
+import { execFile } from 'node:child_process'
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+import { performance } from 'node:perf_hooks'
+import { promisify } from 'node:util'
+
+import { eq, sql } from 'drizzle-orm'
+
+import { db } from '@/lib/db'
+import {
+  gitlabIntegrations,
+  indexBranchStates,
+  indexFileStates,
+  indexRuns,
+} from '@/lib/db/schema'
+import type { GitLabCompareChange, GitLabSource } from '@/lib/indexing/contracts'
+import { FsArtifactStore } from '@/lib/indexing/stores/artifact-store.fs'
+import { createPostgresVectorStore } from '@/lib/indexing/stores/vector-store.pg'
+import { sha256Hex } from '@/lib/utils/hash'
+
+const execFileAsync = promisify(execFile)
+
+type Scenario = {
+  name: string
+  baseFiles: Record<string, string>
+  headFiles: Record<string, string>
+  changes: GitLabCompareChange[]
+  expectedPaths: string[]
+}
+
+type BenchmarkResult = {
+  scenario: string
+  compareChanges: number
+  plannedMode: string
+  runStatus: string
+  fallback: string | null
+  planMs: number
+  ingestMs: number
+  totalMs: number
+}
+
+const slugify = (value: string) =>
+  value
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+
+const createSnapshotArchive = async (files: Record<string, string>) => {
+  const root = await mkdtemp(path.join(os.tmpdir(), 'argus-indexing-bench-archive-'))
+  const repoDir = path.join(root, 'repo')
+  await mkdir(repoDir, { recursive: true })
+
+  for (const [relativePath, content] of Object.entries(files)) {
+    const absolutePath = path.join(repoDir, relativePath)
+    await mkdir(path.dirname(absolutePath), { recursive: true })
+    await writeFile(absolutePath, content, 'utf8')
+  }
+
+  const archivePath = path.join(root, 'repo.tar.gz')
+  await execFileAsync('tar', ['-czf', archivePath, '-C', root, 'repo'])
+  return {
+    root,
+    archivePath,
+  }
+}
+
+const toRecord = (value: unknown): Record<string, unknown> => {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return {}
+  }
+  return value as Record<string, unknown>
+}
+
+const ensureDatabaseReady = async () => {
+  try {
+    await db.execute(sql`select 1 from ${indexBranchStates} limit 1`)
+  } catch (error) {
+    throw new Error(
+      `Database is not ready for indexing benchmark. Run db bootstrap + migrations first. ${error instanceof Error ? error.message : ''}`.trim(),
+    )
+  }
+}
+
+const buildScenarios = (): Scenario[] => {
+  const oneFileBase = {
+    'src/a.ts': 'export const a = 1\n',
+    'src/b.ts': 'export const b = 1\n',
+  }
+
+  const renameBase = {
+    'src/rename-old.ts': 'export const renamed = 1\n',
+    'src/keep.ts': 'export const keep = 1\n',
+  }
+
+  const deleteBase = {
+    'src/delete.ts': 'export const deleted = 1\n',
+    'src/keep.ts': 'export const keep = 1\n',
+  }
+
+  const bulkEntries = Array.from({ length: 300 }, (_, index) => {
+    const filePath = `src/bulk/file-${index}.ts`
+    return [
+      filePath,
+      `export const value${index} = 1\n`,
+    ] as const
+  })
+
+  const bulkBase = Object.fromEntries(bulkEntries)
+  const bulkHead = Object.fromEntries(
+    bulkEntries.map(([filePath], index) => [
+      filePath,
+      `export const value${index} = 2\n`,
+    ]),
+  )
+
+  return [
+    {
+      name: '1-file change',
+      baseFiles: oneFileBase,
+      headFiles: {
+        ...oneFileBase,
+        'src/b.ts': 'export const b = 2\n',
+      },
+      changes: [
+        { oldPath: 'src/b.ts', newPath: 'src/b.ts', type: 'modified' },
+      ],
+      expectedPaths: Object.keys(oneFileBase).sort(),
+    },
+    {
+      name: 'rename',
+      baseFiles: renameBase,
+      headFiles: {
+        'src/rename-new.ts': 'export const renamed = 1\n',
+        'src/keep.ts': 'export const keep = 1\n',
+      },
+      changes: [
+        { oldPath: 'src/rename-old.ts', newPath: 'src/rename-new.ts', type: 'renamed' },
+      ],
+      expectedPaths: ['src/keep.ts', 'src/rename-new.ts'],
+    },
+    {
+      name: 'delete',
+      baseFiles: deleteBase,
+      headFiles: {
+        'src/keep.ts': 'export const keep = 1\n',
+      },
+      changes: [
+        { oldPath: 'src/delete.ts', newPath: null, type: 'deleted' },
+      ],
+      expectedPaths: ['src/keep.ts'],
+    },
+    {
+      name: '300-file change',
+      baseFiles: bulkBase,
+      headFiles: bulkHead,
+      changes: Object.keys(bulkBase).map((filePath) => ({
+        oldPath: filePath,
+        newPath: filePath,
+        type: 'modified' as const,
+      })),
+      expectedPaths: Object.keys(bulkBase).sort(),
+    },
+  ]
+}
+
+const runScenario = async (args: {
+  scenario: Scenario
+  artifactsRoot: string
+  processPlanJob: (job: {
+    integrationId: string
+    branch: string
+    hintedHeadSha: string
+    configHash: string
+  }, deps: { source: GitLabSource }) => Promise<{ runId: string; mode: string }>
+  processIngestJob: (job: { runId: string }, deps: {
+    source: GitLabSource
+    vectorStore: ReturnType<typeof createPostgresVectorStore>
+    artifactStore: FsArtifactStore
+  }) => Promise<{ status: string }>
+}): Promise<BenchmarkResult> => {
+  const integrationId = randomUUID()
+  const branchStateId = randomUUID()
+  const baseSha = `${slugify(args.scenario.name)}-base-${randomUUID().slice(0, 8)}`
+  const headSha = `${slugify(args.scenario.name)}-head-${randomUUID().slice(0, 8)}`
+  const configHash = `bench-${slugify(args.scenario.name)}-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`
+  const archive = await createSnapshotArchive(args.scenario.headFiles)
+  let integrationInserted = false
+  const now = new Date()
+
+  const source: GitLabSource = {
+    resolveHeadSha: async () => headSha,
+    compare: async () => ({
+      valid: true,
+      incomplete: false,
+      changes: args.scenario.changes,
+    }),
+    fetchFile: async ({ path: filePath }) => {
+      const content = args.scenario.headFiles[filePath]
+      if (typeof content !== 'string') {
+        throw new Error(`[${args.scenario.name}] missing head content for ${filePath}`)
+      }
+
+      return {
+        path: filePath,
+        content: Buffer.from(content, 'utf8'),
+      }
+    },
+    downloadArchive: async () => ({
+      archivePath: archive.archivePath,
+    }),
+  }
+
+  try {
+    await db.insert(gitlabIntegrations).values({
+      id: integrationId,
+      instanceUrl: 'https://gitlab.example.com',
+      projectId: `benchmark-${integrationId}`,
+      projectPath: 'benchmark/project',
+      projectName: 'benchmark-project',
+      webhookUrl: 'https://argus.example.com/api/webhooks/gitlab',
+      status: 'active',
+      createdAt: now,
+      updatedAt: now,
+    })
+    integrationInserted = true
+
+    await db.insert(indexBranchStates).values({
+      id: branchStateId,
+      integrationId,
+      branch: 'main',
+      configHash,
+      lastReadySha: baseSha,
+      lastReadyRunId: null,
+      servingUpdatedAt: now,
+      createdAt: now,
+      updatedAt: now,
+    })
+
+    const baseStateRows = Object.entries(args.scenario.baseFiles).map(([filePath, content]) => ({
+      branchStateId,
+      path: filePath,
+      fileId: sha256Hex(Buffer.from(content, 'utf8')),
+      sizeBytes: Buffer.byteLength(content, 'utf8'),
+      skipReason: null,
+      lastReadySha: baseSha,
+      createdAt: now,
+      updatedAt: now,
+    }))
+
+    if (baseStateRows.length > 0) {
+      await db.insert(indexFileStates).values(baseStateRows)
+    }
+
+    const planStart = performance.now()
+    const planned = await args.processPlanJob(
+      {
+        integrationId,
+        branch: 'main',
+        hintedHeadSha: headSha,
+        configHash,
+      },
+      { source },
+    )
+    const planMs = performance.now() - planStart
+
+    const ingestStart = performance.now()
+    const ingestResult = await args.processIngestJob(
+      { runId: planned.runId },
+      {
+        source,
+        vectorStore: createPostgresVectorStore(),
+        artifactStore: new FsArtifactStore(),
+      },
+    )
+    const ingestMs = performance.now() - ingestStart
+
+    if (ingestResult.status !== 'ready') {
+      throw new Error(`[${args.scenario.name}] ingest status ${ingestResult.status}`)
+    }
+
+    const [run] = await db
+      .select({
+        status: indexRuns.status,
+        mode: indexRuns.mode,
+        stats: indexRuns.stats,
+      })
+      .from(indexRuns)
+      .where(eq(indexRuns.id, planned.runId))
+      .limit(1)
+
+    if (!run) {
+      throw new Error(`[${args.scenario.name}] run not found after ingest`)
+    }
+
+    const finalPaths = await db
+      .select({
+        path: indexFileStates.path,
+      })
+      .from(indexFileStates)
+      .where(eq(indexFileStates.branchStateId, branchStateId))
+
+    const receivedPaths = finalPaths.map((row) => row.path).sort()
+    const expectedPaths = [...args.scenario.expectedPaths].sort()
+    if (JSON.stringify(receivedPaths) !== JSON.stringify(expectedPaths)) {
+      throw new Error(
+        `[${args.scenario.name}] file state mismatch. expected=${expectedPaths.join(',')} received=${receivedPaths.join(',')}`,
+      )
+    }
+
+    const stats = toRecord(run.stats)
+    const fallback =
+      typeof stats.modeFallback === 'string' && stats.modeFallback.length > 0
+        ? stats.modeFallback
+        : null
+
+    return {
+      scenario: args.scenario.name,
+      compareChanges: args.scenario.changes.length,
+      plannedMode: planned.mode,
+      runStatus: run.status,
+      fallback,
+      planMs,
+      ingestMs,
+      totalMs: planMs + ingestMs,
+    }
+  } finally {
+    if (integrationInserted) {
+      await db
+        .delete(gitlabIntegrations)
+        .where(eq(gitlabIntegrations.id, integrationId))
+    }
+
+    await rm(archive.root, { recursive: true, force: true })
+  }
+}
+
+const main = async () => {
+  const databaseUrl = process.env.DATABASE_URL?.trim()
+  if (!databaseUrl) {
+    throw new Error('DATABASE_URL is required.')
+  }
+
+  await ensureDatabaseReady()
+
+  if (!process.env.INDEXER_ENABLE_DELTA) {
+    process.env.INDEXER_ENABLE_DELTA = '1'
+  }
+  if (!process.env.INDEXER_EMBEDDING_PROVIDER) {
+    process.env.INDEXER_EMBEDDING_PROVIDER = 'deterministic'
+  }
+  process.env.INDEXER_ARTIFACTS_BACKEND = 'fs'
+
+  const previousArtifactsDir = process.env.INDEXER_ARTIFACTS_DIR
+  const artifactsRoot = await mkdtemp(path.join(os.tmpdir(), 'argus-indexing-bench-artifacts-'))
+  process.env.INDEXER_ARTIFACTS_DIR = artifactsRoot
+
+  try {
+    const cacheBust = Math.random().toString(36).slice(2)
+    const { processPlanJob } = await import(`@/lib/indexing/processors/plan.ts?cacheBust=${cacheBust}`)
+    const { processIngestJob } = await import(`@/lib/indexing/processors/ingest.ts?cacheBust=${cacheBust}`)
+    const scenarios = buildScenarios()
+    const startedAt = new Date().toISOString()
+    const results: BenchmarkResult[] = []
+
+    for (const scenario of scenarios) {
+      const result = await runScenario({
+        scenario,
+        artifactsRoot,
+        processPlanJob,
+        processIngestJob,
+      })
+      results.push(result)
+    }
+
+    const fallbackCount = results.filter((entry) => entry.fallback !== null).length
+    const totalIngestMs = results.reduce((sum, entry) => sum + entry.ingestMs, 0)
+    const summary = {
+      scenarioCount: results.length,
+      fallbackCount,
+      fallbackRate: results.length > 0 ? fallbackCount / results.length : 0,
+      avgIngestMs: results.length > 0 ? totalIngestMs / results.length : 0,
+    }
+
+    const payload = {
+      startedAt,
+      finishedAt: new Date().toISOString(),
+      env: {
+        indexerEnableDelta: process.env.INDEXER_ENABLE_DELTA,
+        embeddingProvider: process.env.INDEXER_EMBEDDING_PROVIDER,
+      },
+      results: results.map((entry) => ({
+        ...entry,
+        planMs: Number(entry.planMs.toFixed(2)),
+        ingestMs: Number(entry.ingestMs.toFixed(2)),
+        totalMs: Number(entry.totalMs.toFixed(2)),
+      })),
+      summary: {
+        ...summary,
+        fallbackRate: Number(summary.fallbackRate.toFixed(4)),
+        avgIngestMs: Number(summary.avgIngestMs.toFixed(2)),
+      },
+    }
+
+    const outputDir = path.join(process.cwd(), '.benchmarks', 'indexing')
+    await mkdir(outputDir, { recursive: true })
+    const outputPath = path.join(
+      outputDir,
+      `phase2-${new Date().toISOString().replace(/[:.]/g, '-')}.json`,
+    )
+    await writeFile(outputPath, `${JSON.stringify(payload, null, 2)}\n`, 'utf8')
+
+    console.table(
+      payload.results.map((entry) => ({
+        scenario: entry.scenario,
+        compareChanges: entry.compareChanges,
+        plannedMode: entry.plannedMode,
+        fallback: entry.fallback ?? '-',
+        ingestMs: entry.ingestMs,
+        totalMs: entry.totalMs,
+      })),
+    )
+    console.log(
+      `Fallback rate: ${(payload.summary.fallbackRate * 100).toFixed(2)}% (${payload.summary.fallbackCount}/${payload.summary.scenarioCount})`,
+    )
+    console.log(`Average ingest: ${payload.summary.avgIngestMs.toFixed(2)}ms`)
+    console.log(`Saved benchmark report: ${outputPath}`)
+  } finally {
+    if (previousArtifactsDir === undefined) {
+      delete process.env.INDEXER_ARTIFACTS_DIR
+    } else {
+      process.env.INDEXER_ARTIFACTS_DIR = previousArtifactsDir
+    }
+
+    await rm(artifactsRoot, { recursive: true, force: true })
+  }
+}
+
+main().catch((error) => {
+  console.error('[indexing-benchmark] failed', error)
+  process.exit(1)
+})
