index 00000000..1a9a5a1c
--- /dev/null
+++ b/src/app/api/review/diff/route.ts
@@ -0,0 +1,306 @@
+import { NextResponse } from "next/server"
+
+import { getSessionUserId } from "@/lib/session"
+
+const MAX_PATCH_CHARS = 120_000
+const MAX_FINDINGS = 32
+const CHAT_TIMEOUT_MS = 35_000
+const DEFAULT_AI_API_URL = "https://api.openai.com/v1"
+const DEFAULT_AI_MODEL = "gpt-4o-mini"
+
+type ReviewRequestPayload = {
+  patch?: unknown
+  apiUrl?: unknown
+  model?: unknown
+}
+
+type ReviewFinding = {
+  file: string
+  line: number
+  side: "additions" | "deletions"
+  severity: "high" | "med" | "low"
+  title: string
+  body: string
+  confidence: number
+}
+
+type ChatCompletionsResponse = {
+  choices?: Array<{
+    message?: {
+      content?: unknown
+    }
+  }>
+}
+
+const isNonEmptyString = (value: unknown): value is string =>
+  typeof value === "string" && value.trim().length > 0
+
+const normalizeApiUrl = (value: string) => value.trim().replace(/\/+$/, "")
+
+const pickFirstNonEmpty = (...values: Array<string | undefined>) => {
+  for (const value of values) {
+    if (isNonEmptyString(value)) {
+      return value.trim()
+    }
+  }
+  return ""
+}
+
+const getEnvApiUrl = () =>
+  pickFirstNonEmpty(
+    process.env.AI_API_URL,
+    process.env.OPENAI_BASE_URL,
+    process.env.NEXT_PUBLIC_AI_API_URL,
+    process.env.NEXT_PUBLIC_OPENAI_BASE_URL,
+  ) || DEFAULT_AI_API_URL
+
+const getEnvModel = () =>
+  pickFirstNonEmpty(
+    process.env.AI_MODEL,
+    process.env.OPENAI_MODEL,
+    process.env.NEXT_PUBLIC_AI_MODEL,
+    process.env.NEXT_PUBLIC_OPENAI_MODEL,
+  ) || DEFAULT_AI_MODEL
+
+const getEnvToken = () =>
+  pickFirstNonEmpty(
+    process.env.AI_API_TOKEN,
+    process.env.OPENAI_API_KEY,
+  )
+
+const toReviewSide = (value: unknown): ReviewFinding["side"] => {
+  const normalized = String(value ?? "")
+    .trim()
+    .toLowerCase()
+
+  if (
+    normalized === "deletions" ||
+    normalized === "deletion" ||
+    normalized === "removed" ||
+    normalized === "left"
+  ) {
+    return "deletions"
+  }
+
+  return "additions"
+}
+
+const toReviewSeverity = (value: unknown): ReviewFinding["severity"] => {
+  const normalized = String(value ?? "")
+    .trim()
+    .toLowerCase()
+  if (normalized === "high") {
+    return "high"
+  }
+  if (normalized === "medium" || normalized === "med") {
+    return "med"
+  }
+  return "low"
+}
+
+const toConfidence = (value: unknown) => {
+  if (typeof value !== "number" || !Number.isFinite(value)) {
+    return 0.7
+  }
+
+  return Math.max(0, Math.min(1, value))
+}
+
+const sanitizeAssistantContent = (content: string) => {
+  const trimmed = content.trim()
+  const fenced = trimmed.match(/```(?:json)?\s*([\s\S]*?)```/i)
+  const candidate = (fenced?.[1] ?? trimmed).trim()
+  const firstBrace = candidate.indexOf("{")
+  const lastBrace = candidate.lastIndexOf("}")
+
+  if (firstBrace >= 0 && lastBrace > firstBrace) {
+    return candidate.slice(firstBrace, lastBrace + 1)
+  }
+
+  return candidate
+}
+
+const parseFindings = (content: unknown): ReviewFinding[] => {
+  if (!isNonEmptyString(content)) {
+    return []
+  }
+
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(sanitizeAssistantContent(content))
+  } catch {
+    return []
+  }
+
+  const rawFindings = (() => {
+    if (Array.isArray(parsed)) {
+      return parsed
+    }
+    if (parsed && typeof parsed === "object") {
+      const maybeFindings = (parsed as { findings?: unknown }).findings
+      if (Array.isArray(maybeFindings)) {
+        return maybeFindings
+      }
+    }
+    return []
+  })()
+
+  const normalized = rawFindings
+    .map((value) => {
+      if (!value || typeof value !== "object") {
+        return null
+      }
+
+      const finding = value as Record<string, unknown>
+      const line = Number(finding.line)
+      const file = String(finding.file ?? "").trim()
+      const title = String(finding.title ?? "").trim()
+      const body = String(finding.body ?? finding.explanation ?? "").trim()
+
+      if (!file || !title || !body || !Number.isFinite(line) || line < 1) {
+        return null
+      }
+
+      return {
+        file,
+        line: Math.floor(line),
+        side: toReviewSide(finding.side),
+        severity: toReviewSeverity(finding.severity),
+        title,
+        body,
+        confidence: toConfidence(finding.confidence),
+      } satisfies ReviewFinding
+    })
+    .filter((finding): finding is ReviewFinding => finding !== null)
+
+  return normalized.slice(0, MAX_FINDINGS)
+}
+
+const getChatCompletionsUrl = (apiUrl: string) => {
+  const normalized = normalizeApiUrl(apiUrl)
+  if (/\/chat\/completions$/i.test(normalized)) {
+    return normalized
+  }
+  return `${normalized}/chat/completions`
+}
+
+const readProviderError = async (response: Response) => {
+  const bodyText = await response.text().catch(() => "")
+  return bodyText.slice(0, 400)
+}
+
+const buildSystemPrompt = () =>
+  [
+    "You are a senior software code reviewer.",
+    "Review a git patch and identify likely real issues only.",
+    "Focus on syntax, logic bugs, regressions, null/async issues, and security risks.",
+    "Avoid style-only feedback unless it materially affects maintainability or correctness.",
+    "Return strictly JSON with shape:",
+    '{"findings":[{"file":"path","line":1,"side":"additions|deletions","severity":"high|med|low","title":"short","body":"why it matters + fix hint","confidence":0.0}]}',
+    "Use only file paths and changed line numbers from the patch.",
+    `Limit findings to ${MAX_FINDINGS}.`,
+  ].join("\n")
+
+const requestReview = async ({
+  patch,
+  apiUrl,
+  model,
+  token,
+}: {
+  patch: string
+  apiUrl: string
+  model: string
+  token: string
+}) => {
+  const controller = new AbortController()
+  const timeout = setTimeout(() => {
+    controller.abort()
+  }, CHAT_TIMEOUT_MS)
+
+  try {
+    const response = await fetch(getChatCompletionsUrl(apiUrl), {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        authorization: `Bearer ${token}`,
+      },
+      body: JSON.stringify({
+        model,
+        temperature: 0.1,
+        messages: [
+          { role: "system", content: buildSystemPrompt() },
+          { role: "user", content: `Review this patch:\n\n${patch}` },
+        ],
+      }),
+      signal: controller.signal,
+    })
+
+    if (!response.ok) {
+      const providerError = await readProviderError(response)
+      throw new Error(
+        `AI provider request failed (${response.status})${providerError ? `: ${providerError}` : ""}`,
+      )
+    }
+
+    const payload = (await response.json()) as ChatCompletionsResponse
+    const content = payload.choices?.[0]?.message?.content
+    return parseFindings(content)
+  } catch (error) {
+    if (error instanceof Error && error.name === "AbortError") {
+      throw new Error("AI review timed out.")
+    }
+    throw error
+  } finally {
+    clearTimeout(timeout)
+  }
+}
+
+export async function POST(request: Request) {
+  const userId = await getSessionUserId()
+  if (!userId) {
+    return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
+  }
+
+  const payload = (await request.json().catch(() => null)) as
+    | ReviewRequestPayload
+    | null
+
+  const patch = isNonEmptyString(payload?.patch) ? payload.patch : ""
+  const apiUrl = normalizeApiUrl(
+    isNonEmptyString(payload?.apiUrl) ? payload.apiUrl : getEnvApiUrl(),
+  )
+  const model = isNonEmptyString(payload?.model)
+    ? payload.model.trim()
+    : getEnvModel()
+  const token = getEnvToken()
+
+  if (!patch) {
+    return NextResponse.json({ error: "Patch is required." }, { status: 400 })
+  }
+  if (!apiUrl || !model || !token) {
+    return NextResponse.json(
+      { error: "AI token missing. Set AI_API_TOKEN or OPENAI_API_KEY on the server." },
+      { status: 400 },
+    )
+  }
+  if (patch.length > MAX_PATCH_CHARS) {
+    return NextResponse.json(
+      { error: `Diff too large for AI review. Limit is ${MAX_PATCH_CHARS.toLocaleString()} characters.` },
+      { status: 413 },
+    )
+  }
+
+  try {
+    const findings = await requestReview({
+      patch,
+      apiUrl,
+      model,
+      token,
+    })
+
+    return NextResponse.json({ data: { findings } })
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "AI review failed."
+    return NextResponse.json({ error: message }, { status: 502 })
+  }
+}
