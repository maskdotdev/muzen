index 00000000..d6814c50
--- /dev/null
+++ b/src/app/api/review/diff/route.test.ts
@@ -0,0 +1,96 @@
+import { describe, expect, test } from "bun:test"
+
+import {
+  resolveReviewRequestInput,
+  resolveServerApiUrl,
+  type ReviewRequestPayload,
+} from "./route"
+
+const withEnv = async <T>(
+  overrides: Partial<NodeJS.ProcessEnv>,
+  fn: () => Promise<T> | T,
+) => {
+  const previous = new Map<string, string | undefined>()
+  for (const [key, value] of Object.entries(overrides)) {
+    previous.set(key, process.env[key])
+    if (value === undefined) {
+      delete process.env[key]
+    } else {
+      process.env[key] = value
+    }
+  }
+
+  try {
+    return await fn()
+  } finally {
+    for (const [key, value] of previous.entries()) {
+      if (value === undefined) {
+        delete process.env[key]
+      } else {
+        process.env[key] = value
+      }
+    }
+  }
+}
+
+describe("review diff provider config", () => {
+  test("normalizes server API URL", async () =>
+    withEnv(
+      {
+        AI_API_URL: "https://api.openai.com/v1/?x=1#frag",
+        OPENAI_BASE_URL: undefined,
+      },
+      () => {
+        expect(resolveServerApiUrl()).toBe("https://api.openai.com/v1")
+      },
+    ))
+
+  test("rejects invalid provider URLs", async () => {
+    await withEnv(
+      {
+        AI_API_URL: "file:///tmp/provider",
+        OPENAI_BASE_URL: undefined,
+      },
+      () => {
+        expect(() => resolveServerApiUrl()).toThrow("AI provider URL must use http or https.")
+      },
+    )
+
+    await withEnv(
+      {
+        AI_API_URL: "https://user:pass@example.com/v1",
+        OPENAI_BASE_URL: undefined,
+      },
+      () => {
+        expect(() => resolveServerApiUrl()).toThrow(
+          "AI provider URL must not include credentials.",
+        )
+      },
+    )
+  })
+
+  test("ignores client provider overrides in payload", async () =>
+    withEnv(
+      {
+        AI_API_URL: "https://api.openai.com/v1",
+        AI_MODEL: "gpt-4o-mini",
+        AI_API_TOKEN: "server-secret-token",
+        OPENAI_BASE_URL: undefined,
+        OPENAI_MODEL: undefined,
+        OPENAI_API_KEY: undefined,
+      },
+      () => {
+        const payload = {
+          patch: "diff --git a/x b/x",
+          apiUrl: "https://attacker.example",
+          model: "malicious-model",
+        } as unknown as ReviewRequestPayload
+
+        const resolved = resolveReviewRequestInput(payload)
+        expect(resolved.patch).toBe("diff --git a/x b/x")
+        expect(resolved.apiUrl).toBe("https://api.openai.com/v1")
+        expect(resolved.model).toBe("gpt-4o-mini")
+        expect(resolved.token).toBe("server-secret-token")
+      },
+    ))
+})
