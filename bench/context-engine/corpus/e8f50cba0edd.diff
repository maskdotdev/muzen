@@ -0,0 +1,52 @@
+import { mkdtemp, readFile, rm } from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+import { describe, expect, test } from "bun:test"
+
+import { FsArtifactStore } from "./artifact-store.fs"
+
+const withArtifactsRoot = async <T>(fn: (root: string) => Promise<T>) => {
+  const root = await mkdtemp(path.join(os.tmpdir(), "argus-artifacts-test-"))
+  const previous = process.env.INDEXER_ARTIFACTS_DIR
+  process.env.INDEXER_ARTIFACTS_DIR = root
+
+  try {
+    return await fn(root)
+  } finally {
+    if (previous === undefined) {
+      delete process.env.INDEXER_ARTIFACTS_DIR
+    } else {
+      process.env.INDEXER_ARTIFACTS_DIR = previous
+    }
+    await rm(root, { recursive: true, force: true })
+  }
+}
+
+describe("FsArtifactStore", () => {
+  test("writes artifacts under the configured root", async () =>
+    withArtifactsRoot(async (root) => {
+      const store = new FsArtifactStore()
+      const prefix = "integrations/a/runs/default/main/sha/run-1"
+
+      await store.writeRunJson({
+        artifactsPrefix: prefix,
+        run: { id: "run-1", status: "ready" },
+      })
+
+      const runJsonPath = path.join(root, prefix, "run.json")
+      const payload = await readFile(runJsonPath, "utf8")
+      expect(payload).toContain('"id": "run-1"')
+    }))
+
+  test("rejects traversal prefixes that escape root", async () =>
+    withArtifactsRoot(async () => {
+      const store = new FsArtifactStore()
+
+      await expect(
+        store.writeRunJson({
+          artifactsPrefix: "../../outside-root",
+          run: { id: "bad" },
+        }),
+      ).rejects.toThrow("Invalid artifacts prefix path.")
+    }))
+})
