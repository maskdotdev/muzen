+import { describe, expect, test } from "bun:test"
+
+const loadNormalizer = async (allowPrivateHosts?: string) => {
+  const previous = process.env.GITLAB_ALLOW_PRIVATE_HOSTS
+  if (allowPrivateHosts === undefined) {
+    delete process.env.GITLAB_ALLOW_PRIVATE_HOSTS
+  } else {
+    process.env.GITLAB_ALLOW_PRIVATE_HOSTS = allowPrivateHosts
+  }
+
+  try {
+    const mod = await import(`./instance.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+    return mod.normalizeGitLabInstanceUrl as (input: string) => string
+  } finally {
+    if (previous === undefined) {
+      delete process.env.GITLAB_ALLOW_PRIVATE_HOSTS
+    } else {
+      process.env.GITLAB_ALLOW_PRIVATE_HOSTS = previous
+    }
+  }
+}
+
