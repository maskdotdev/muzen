+      {
+        params: Promise.resolve({ integrationId: "integration-1" }),
+      },
+    )
+
+    const body = await response.json()
+
+    expect(response.status).toBe(200)
+    expect(body.reconcile).toEqual({
+      id: "reconcile-1",
+      status: "succeeded",
+      attempts: 1,
+      lastError: null,
+      checked: 2,
+      enqueued: 1,
+      branchChecksCount: 1,
+      createdAt: "2026-02-14T10:02:00.000Z",
+      updatedAt: "2026-02-14T10:03:00.000Z",
+      startedAt: "2026-02-14T10:02:10.000Z",
+      finishedAt: "2026-02-14T10:02:20.000Z",
+    })
+    expect(body.data).toHaveLength(1)
+    expect(body.data[0].lastRun?.id).toBe("run-1")
+    expect(body.data[0].reconcile).toEqual({
+      jobId: "reconcile-1",
+      status: "succeeded",
+      checkedAt: "2026-02-14T10:02:20.000Z",
+      wasChecked: true,
+      wasEnqueued: true,
+      headSha: "sha-new",
+      lastReadySha: "sha-old",
+    })
+    expect(loggerContext).toMatchObject({
+      count: 1,
+      latestReconcileStatus: "succeeded",
+    })
+  })
+})
