+import { describe, expect, mock, test } from "bun:test"
+
+import { indexBranchStates } from "@/lib/db/schema"
+import type { GitLabSource } from "@/lib/indexing/contracts"
+
+const loadModule = async (args: {
+  branches: Array<{
+    branch: string
+    configHash: string
+    lastReadySha: string | null
+  }>
+  headByBranch: Record<string, string>
+}) => {
+  const db = {
+    select: () => ({
+      from: (table: unknown) => {
+        if (table !== indexBranchStates) {
+          throw new Error("Unexpected table in reconcile test.")
+        }
+
+        return {
+          where: () => ({
+            limit: () => Promise.resolve(args.branches),
+          }),
+        }
+      },
+    }),
+  }
+
+  const resolveHeadSha = mock(
+    async ({ branch }: { integrationId: string; branch: string }) => args.headByBranch[branch],
+  )
+  const source: GitLabSource = {
+    resolveHeadSha,
+    compare: async () => ({ valid: true, incomplete: false, changes: [] }),
+    fetchFile: async () => ({ path: "x.ts", content: Buffer.from("x") }),
+    downloadArchive: async () => ({ archivePath: "/tmp/archive.tar.gz" }),
+  }
+
+  const enqueuePlanJob = mock(async () => ({ id: "plan-job-1" }))
+
+  mock.module("@/lib/db", () => ({ db }))
+  mock.module("@/lib/indexing/sources/gitlab-source", () => ({
+    createGitLabSource: () => source,
+  }))
+  mock.module("@/lib/indexing/job-queue", () => ({ enqueuePlanJob }))
+
+  const mod = await import(`@/lib/indexing/processors/reconcile.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+
+  return {
+    processReconcileJob: mod.processReconcileJob as (args: {
+      integrationId: string
+    }) => Promise<{
+      checked: number
+      enqueued: number
+      branchChecks: Array<{
+        branch: string
+        configHash: string
+        lastReadySha: string | null
+        headSha: string
+        enqueued: boolean
+      }>
+    }>,
+    resolveHeadSha,
+    enqueuePlanJob,
+  }
+}
+
+describe("processReconcileJob", () => {
+  test("records checked branch metadata and enqueues stale branches", async () => {
+    const { processReconcileJob, resolveHeadSha, enqueuePlanJob } = await loadModule({
+      branches: [
+        {
+          branch: "main",
+          configHash: "default",
+          lastReadySha: "sha-main-1",
+        },
+        {
+          branch: "release",
+          configHash: "default",
+          lastReadySha: "sha-release-1",
+        },
+      ],
+      headByBranch: {
+        main: "sha-main-1",
+        release: "sha-release-2",
+      },
+    })
+
+    const result = await processReconcileJob({
+      integrationId: "integration-1",
+    })
+
+    expect(resolveHeadSha).toHaveBeenCalledTimes(2)
+    expect(enqueuePlanJob).toHaveBeenCalledTimes(1)
+    expect(enqueuePlanJob).toHaveBeenCalledWith({
+      integrationId: "integration-1",
+      branch: "release",
+      configHash: "default",
+      hintedHeadSha: "sha-release-2",
+    })
+
