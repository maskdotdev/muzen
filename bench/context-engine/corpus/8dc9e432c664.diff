+    id: "integration-1",
+    status: "active" as const,
+  }))
+
+  let selectCall = 0
+  const db = {
+    select: () => {
+      selectCall += 1
+
+      if (selectCall === 1) {
+        return {
+          from: () => ({
+            where: () => ({
+              orderBy: () => ({
+                limit: () =>
+                  Promise.resolve([
+                    {
+                      id: "branch-state-1",
