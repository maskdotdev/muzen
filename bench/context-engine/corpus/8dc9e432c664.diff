+  const integrationLimit = resolveReconcileIntegrationLimit()
+  const query = sql<{ id: string }>`
+    with candidate_integrations as (
+      select distinct ${indexBranchStates.integrationId} as integration_id
+      from ${indexBranchStates}
+      inner join ${gitlabIntegrations}
+        on ${gitlabIntegrations.id} = ${indexBranchStates.integrationId}
+      where ${gitlabIntegrations.status} = 'active'
+    ),
+    due_integrations as (
+      select candidate_integrations.integration_id
+      from candidate_integrations
+      left join ${indexJobs}
+        on ${indexJobs.integrationId} = candidate_integrations.integration_id
+        and ${indexJobs.jobType} = 'reconcile'
+      where
+        ${indexJobs.id} is null
+        or (
+          ${indexJobs.status} in ('succeeded', 'failed', 'dead')
+          and coalesce(${indexJobs.finishedAt}, ${indexJobs.updatedAt}, ${indexJobs.createdAt}) <= ${dueBefore}
+        )
+      order by
+        coalesce(
+          ${indexJobs.finishedAt},
+          ${indexJobs.updatedAt},
+          ${indexJobs.createdAt},
+          'epoch'::timestamptz
+        ) asc,
+        candidate_integrations.integration_id asc
+      limit ${integrationLimit}
+    ),
+    upserted as (
+      insert into ${indexJobs} (
+        ${indexJobs.integrationId},
+        ${indexJobs.jobType},
+        ${indexJobs.debounceKey},
+        ${indexJobs.status},
+        ${indexJobs.attempts},
+        ${indexJobs.nextAttemptAt},
+        ${indexJobs.startedAt},
+        ${indexJobs.finishedAt},
+        ${indexJobs.lastError},
+        ${indexJobs.result},
+        ${indexJobs.createdAt},
+        ${indexJobs.updatedAt}
+      )
+      select
+        due_integrations.integration_id,
+        'reconcile',
