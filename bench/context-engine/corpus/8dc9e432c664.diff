+        'pending',
+        0,
+        ${now},
+        null,
+        null,
+        null,
+        null,
+        ${now},
+        ${now}
+      from due_integrations
+      on conflict (${indexJobs.debounceKey}) do update
+      set
+        ${indexJobs.integrationId} = excluded.integration_id,
+        ${indexJobs.jobType} = 'reconcile',
+        ${indexJobs.status} = 'pending',
+        ${indexJobs.attempts} = 0,
+        ${indexJobs.nextAttemptAt} = ${now},
+        ${indexJobs.startedAt} = null,
+        ${indexJobs.finishedAt} = null,
+        ${indexJobs.lastError} = null,
+        ${indexJobs.result} = null,
+        ${indexJobs.updatedAt} = ${now}
