+                      createdAt: new Date("2026-02-14T09:50:00.000Z"),
+                    },
+                  ]),
+              }),
+            }),
+          }),
+        }
+      }
+
+      if (selectCall === 2) {
+        return {
+          from: () => ({
+            where: () => ({
+              orderBy: () => ({
+                limit: () =>
+                  Promise.resolve([
+                    {
+                      id: "reconcile-1",
+                      status: "succeeded",
+                      attempts: 1,
+                      lastError: null,
+                      result: {
+                        checked: 2,
+                        enqueued: 1,
+                        branchChecks: [
+                          {
+                            branch: "main",
+                            configHash: "default",
+                            lastReadySha: "sha-old",
+                            headSha: "sha-new",
+                            enqueued: true,
+                          },
+                        ],
+                      },
+                      createdAt: new Date("2026-02-14T10:02:00.000Z"),
+                      updatedAt: new Date("2026-02-14T10:03:00.000Z"),
+                      startedAt: new Date("2026-02-14T10:02:10.000Z"),
+                      finishedAt: new Date("2026-02-14T10:02:20.000Z"),
+                    },
+                  ]),
+              }),
+            }),
+          }),
+        }
+      }
+
+      return {
+        from: () => ({
+          where: () => ({
+            orderBy: () =>
+              Promise.resolve([
+                {
+                  id: "run-1",
+                  branchStateId: "branch-state-1",
+                  headSha: "sha-new",
+                  baseSha: "sha-old",
+                  mode: "delta",
+                  status: "ready",
+                  stats: null,
+                  error: null,
+                  createdAt: new Date("2026-02-14T10:01:00.000Z"),
+                  updatedAt: new Date("2026-02-14T10:01:20.000Z"),
+                },
+              ]),
+          }),
