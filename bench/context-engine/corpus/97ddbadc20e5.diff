diff --git a/apps/web/src/lib/review/impact-graph-backend.test.ts b/apps/web/src/lib/review/impact-graph-backend.test.ts
new file mode 100644
index 00000000..b40d4f13
--- /dev/null
+++ b/apps/web/src/lib/review/impact-graph-backend.test.ts
@@ -0,0 +1,27 @@
+import { afterEach, describe, expect, test } from "bun:test"
+
+const ORIGINAL_BACKEND = process.env.IMPACT_GRAPH_BACKEND
+
+afterEach(() => {
+  if (ORIGINAL_BACKEND === undefined) {
+    delete process.env.IMPACT_GRAPH_BACKEND
+  } else {
+    process.env.IMPACT_GRAPH_BACKEND = ORIGINAL_BACKEND
+  }
+})
+
+describe("impact-graph-backend", () => {
+  test("defaults to kitedb_fs backend", async () => {
+    delete process.env.IMPACT_GRAPH_BACKEND
+    const mod = await import(`./impact-graph-backend.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+    const backend = mod.createImpactGraphBackend()
+    expect(backend.kind).toBe("kitedb_fs")
+  })
+
+  test("selects legacy backend when IMPACT_GRAPH_BACKEND=legacy_index_pack", async () => {
+    process.env.IMPACT_GRAPH_BACKEND = "legacy_index_pack"
+    const mod = await import(`./impact-graph-backend.ts?cacheBust=${Math.random().toString(36).slice(2)}`)
+    const backend = mod.createImpactGraphBackend()
+    expect(backend.kind).toBe("legacy_index_pack")
+  })
+})
diff --git a/apps/web/src/lib/review/impact-graph-backend.ts b/apps/web/src/lib/review/impact-graph-backend.ts
new file mode 100644
index 00000000..2d4b0c00
--- /dev/null
+++ b/apps/web/src/lib/review/impact-graph-backend.ts
@@ -0,0 +1,17 @@
+export type ImpactGraphBackendKind = "kitedb_fs" | "legacy_index_pack"
+
+export type ImpactGraphBackend = {
+  kind: ImpactGraphBackendKind
+}
+
+const normalizeBackend = (value: string | undefined): ImpactGraphBackendKind => {
+  const normalized = value?.trim().toLowerCase()
+  if (normalized === "legacy_index_pack") {
+    return "legacy_index_pack"
+  }
+  return "kitedb_fs"
+}
+
+export const createImpactGraphBackend = (): ImpactGraphBackend => ({
+  kind: normalizeBackend(process.env.IMPACT_GRAPH_BACKEND),
+})
