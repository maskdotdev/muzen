+import { mkdir, writeFile } from 'node:fs/promises'
+import path from 'node:path'
+
+import type { ArtifactStore } from '@/lib/indexing/contracts'
+
+const resolveArtifactsRoot = () =>
+  process.env.INDEXER_ARTIFACTS_DIR?.trim() || path.join(process.cwd(), '.indexer-artifacts')
+
+const writeLinesFile = async (filePath: string, lines: string[]) => {
+  const payload = lines.length > 0 ? `${lines.join('\n')}\n` : ''
+  await writeFile(filePath, payload, 'utf8')
+}
+
+export class FsArtifactStore implements ArtifactStore {
+  private readonly root = resolveArtifactsRoot()
+
+  private async ensureRunDir(prefix: string) {
+    const runDir = path.join(this.root, prefix)
+    await mkdir(runDir, { recursive: true })
+    return runDir
+  }
+
+  async writeRunJson(args: { artifactsPrefix: string; run: unknown }): Promise<void> {
+    const runDir = await this.ensureRunDir(args.artifactsPrefix)
+    await writeFile(path.join(runDir, 'run.json'), `${JSON.stringify(args.run, null, 2)}\n`, 'utf8')
+  }
+
+  async writeManifest(args: { artifactsPrefix: string; lines: string[] }): Promise<void> {
+    const runDir = await this.ensureRunDir(args.artifactsPrefix)
+    await writeLinesFile(path.join(runDir, 'manifest.jsonl'), args.lines)
+  }
+
+  async writeChangedFiles(args: { artifactsPrefix: string; lines: string[] }): Promise<void> {
+    const runDir = await this.ensureRunDir(args.artifactsPrefix)
+    await writeLinesFile(path.join(runDir, 'changed_files.jsonl'), args.lines)
+  }
+}
+
+export const createFsArtifactStore = () => new FsArtifactStore()
