@@ -0,0 +1,74 @@
+import path from 'node:path'
+
+const SKIP_DIRS = new Set(['.git', 'node_modules', 'vendor', 'dist', 'build'])
+
+const BINARY_EXTENSIONS = new Set([
+  '.png',
+  '.jpg',
+  '.jpeg',
+  '.gif',
+  '.webp',
+  '.ico',
+  '.pdf',
+  '.zip',
+  '.gz',
+  '.tar',
+  '.tgz',
+  '.7z',
+  '.exe',
+  '.dll',
+  '.so',
+  '.dylib',
+  '.woff',
+  '.woff2',
+  '.ttf',
+  '.otf',
+  '.mp3',
+  '.mp4',
+  '.mov',
+  '.avi',
+])
+
+export const DEFAULT_MAX_FILE_SIZE_BYTES = 512 * 1024
+
+export const shouldSkipPath = (relativePath: string): boolean => {
+  const normalized = relativePath.replace(/\\/g, '/').toLowerCase()
+  const segments = normalized.split('/').filter(Boolean)
+  return segments.some((segment) => SKIP_DIRS.has(segment))
+}
+
+export const isLikelyBinary = (relativePath: string, content: Buffer): boolean => {
+  const ext = path.extname(relativePath).toLowerCase()
+  if (BINARY_EXTENSIONS.has(ext)) {
+    return true
+  }
+
+  const checkLength = Math.min(content.length, 8_192)
+  for (let i = 0; i < checkLength; i += 1) {
+    if (content[i] === 0) {
+      return true
+    }
+  }
+
+  return false
+}
+
+export const classifySkipReason = (args: {
+  relativePath: string
+  content: Buffer
+  maxFileSizeBytes: number
+}): 'path_excluded' | 'binary' | 'file_too_large' | null => {
+  if (shouldSkipPath(args.relativePath)) {
+    return 'path_excluded'
+  }
+
+  if (args.content.length > args.maxFileSizeBytes) {
+    return 'file_too_large'
+  }
+
+  if (isLikelyBinary(args.relativePath, args.content)) {
+    return 'binary'
+  }
+
+  return null
+}
