diff --git a/src/lib/indexing/snapshot.ts b/src/lib/indexing/snapshot.ts
new file mode 100644
index 00000000..8ad13883
--- /dev/null
+++ b/src/lib/indexing/snapshot.ts
@@ -0,0 +1,395 @@
+import { execFile } from 'node:child_process'
+import { mkdtemp, readdir, readFile, rm } from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+import { promisify } from 'node:util'
+
+import { eq } from 'drizzle-orm'
+
+import { db } from '@/lib/db'
+import {
+  indexFileStates,
+  indexRunFileChanges,
+} from '@/lib/db/schema'
+import { buildVectorChunks } from '@/lib/indexing/chunker'
+import type {
+  ArtifactStore,
+  GitLabSource,
+  VectorStore,
+} from '@/lib/indexing/contracts'
+import { embedVectorChunks } from '@/lib/indexing/embedder'
+import { DEFAULT_MAX_FILE_SIZE_BYTES, classifySkipReason } from '@/lib/indexing/ignore'
+import { sha256Hex } from '@/lib/utils/hash'
+
+const execFileAsync = promisify(execFile)
+
+type SnapshotRunContext = {
+  runId: string
+  branchStateId: string
+  integrationId: string
+  configHash: string
+  headSha: string
+  artifactsPrefix: string
+}
+
+type SnapshotResult = {
+  stats: Record<string, number>
+}
+
+type ExistingFileState = {
+  path: string
+  fileId: string
+}
+
+const normalizeRelativePath = (relativePath: string) =>
+  relativePath.split(path.sep).join('/')
+
+const resolveMaxFileSizeBytes = () => {
+  const raw = process.env.INDEXER_MAX_FILE_SIZE_BYTES
+  if (!raw) {
+    return DEFAULT_MAX_FILE_SIZE_BYTES
+  }
+
+  const parsed = Number.parseInt(raw, 10)
+  if (!Number.isFinite(parsed) || parsed <= 0) {
+    return DEFAULT_MAX_FILE_SIZE_BYTES
+  }
+
+  return parsed
+}
+
+const findExtractedRoot = async (extractDir: string): Promise<string> => {
+  const entries = await readdir(extractDir, { withFileTypes: true })
+  const directories = entries.filter((entry) => entry.isDirectory())
+
+  if (directories.length === 1) {
+    return path.join(extractDir, directories[0].name)
+  }
+
+  return extractDir
+}
+
+const collectFiles = async (root: string): Promise<string[]> => {
+  const files: string[] = []
+
+  const walk = async (currentDir: string) => {
+    const entries = await readdir(currentDir, { withFileTypes: true })
+    for (const entry of entries) {
+      const fullPath = path.join(currentDir, entry.name)
+      if (entry.isDirectory()) {
+        await walk(fullPath)
+        continue
+      }
+
+      if (entry.isFile()) {
+        files.push(fullPath)
+      }
+    }
+  }
+
+  await walk(root)
+  return files
+}
+
+const clearStagedChanges = async (runId: string): Promise<void> => {
+  await db
+    .delete(indexRunFileChanges)
+    .where(eq(indexRunFileChanges.runId, runId))
+}
+
+const stageUpsert = async (args: {
+  runId: string
+  path: string
+  fileId: string
+  sizeBytes: number
+}) => {
+  const now = new Date()
+  await db
+    .insert(indexRunFileChanges)
+    .values({
+      runId: args.runId,
+      path: args.path,
+      changeType: 'upsert',
+      fileId: args.fileId,
+      sizeBytes: args.sizeBytes,
+      skipReason: null,
+      createdAt: now,
+      updatedAt: now,
+    })
+    .onConflictDoUpdate({
+      target: [indexRunFileChanges.runId, indexRunFileChanges.path],
+      set: {
+        changeType: 'upsert',
+        fileId: args.fileId,
+        sizeBytes: args.sizeBytes,
+        skipReason: null,
+        updatedAt: now,
+      },
+    })
+}
+
+const stageDelete = async (args: {
+  runId: string
+  path: string
+  skipReason?: string | null
+}) => {
+  const now = new Date()
+  await db
+    .insert(indexRunFileChanges)
+    .values({
+      runId: args.runId,
+      path: args.path,
+      changeType: 'delete',
+      fileId: null,
+      sizeBytes: null,
+      skipReason: args.skipReason ?? null,
+      createdAt: now,
+      updatedAt: now,
+    })
+    .onConflictDoUpdate({
+      target: [indexRunFileChanges.runId, indexRunFileChanges.path],
+      set: {
+        changeType: 'delete',
+        fileId: null,
+        sizeBytes: null,
+        skipReason: args.skipReason ?? null,
+        updatedAt: now,
+      },
+    })
+}
+
+const extractArchive = async (
+  archivePath: string,
+): Promise<{ extractDir: string; repoRoot: string }> => {
+  const extractDir = await mkdtemp(path.join(os.tmpdir(), 'argus-indexer-extract-'))
+  await execFileAsync('tar', ['-xzf', archivePath, '-C', extractDir])
+  const repoRoot = await findExtractedRoot(extractDir)
+  return { extractDir, repoRoot }
+}
+
+const loadExistingStates = async (branchStateId: string): Promise<Map<string, ExistingFileState>> => {
+  const rows = await db
+    .select({
+      path: indexFileStates.path,
+      fileId: indexFileStates.fileId,
+    })
+    .from(indexFileStates)
+    .where(eq(indexFileStates.branchStateId, branchStateId))
+
+  return new Map(rows.map((row) => [row.path, row]))
+}
+
+export const runSnapshotIngest = async (args: {
+  run: SnapshotRunContext
+  source: GitLabSource
+  vectorStore: VectorStore
+  artifactStore: ArtifactStore
+}): Promise<SnapshotResult> => {
+  const maxFileSizeBytes = resolveMaxFileSizeBytes()
+
+  const stats = {
+    filesScanned: 0,
+    filesUnchanged: 0,
+    filesIndexed: 0,
+    filesSkipped: 0,
+    filesDeleted: 0,
+    chunksUpserted: 0,
+  }
+
+  const manifestLines: string[] = []
+  const changedFileLines: string[] = []
+
+  const existingByPath = await loadExistingStates(args.run.branchStateId)
+  const seenPaths = new Set<string>()
+
+  await clearStagedChanges(args.run.runId)
+
+  const { archivePath } = await args.source.downloadArchive({
+    integrationId: args.run.integrationId,
+    sha: args.run.headSha,
+  })
+
+  let extractDir: string | null = null
+
+  try {
+    const extracted = await extractArchive(archivePath)
+    extractDir = extracted.extractDir
+    const absoluteFiles = await collectFiles(extracted.repoRoot)
+
+    for (const absolutePath of absoluteFiles) {
+      const relativePath = normalizeRelativePath(
+        path.relative(extracted.repoRoot, absolutePath),
+      )
+      if (!relativePath) {
+        continue
+      }
+
+      stats.filesScanned += 1
+
+      const content = await readFile(absolutePath)
+      const skipReason = classifySkipReason({
+        relativePath,
+        content,
+        maxFileSizeBytes,
+      })
+
+      if (skipReason) {
+        stats.filesSkipped += 1
+        manifestLines.push(
+          JSON.stringify({ path: relativePath, status: 'skipped', skipReason }),
+        )
+
+        if (existingByPath.has(relativePath)) {
+          await stageDelete({
+            runId: args.run.runId,
+            path: relativePath,
+            skipReason,
+          })
+          await args.vectorStore.deleteStaleByPath({
+            branchStateId: args.run.branchStateId,
+            path: relativePath,
+            keepFileId: null,
+          })
+          stats.filesDeleted += 1
+        }
+
+        seenPaths.add(relativePath)
+        continue
+      }
+
+      const fileId = sha256Hex(content)
+      const existing = existingByPath.get(relativePath)
+      if (existing?.fileId === fileId) {
+        stats.filesUnchanged += 1
+        manifestLines.push(JSON.stringify({ path: relativePath, status: 'unchanged' }))
+        seenPaths.add(relativePath)
+        continue
+      }
+
+      const chunks = await buildVectorChunks({
+        path: relativePath,
+        content: content.toString('utf8'),
+        configHash: args.run.configHash,
+      })
+
+      if (chunks.length === 0) {
+        stats.filesSkipped += 1
+        manifestLines.push(
+          JSON.stringify({ path: relativePath, status: 'skipped', skipReason: 'no_chunks' }),
+        )
+
+        if (existing) {
+          await stageDelete({
+            runId: args.run.runId,
+            path: relativePath,
+            skipReason: 'no_chunks',
+          })
+          await args.vectorStore.deleteStaleByPath({
+            branchStateId: args.run.branchStateId,
+            path: relativePath,
+            keepFileId: null,
+          })
+          stats.filesDeleted += 1
+        }
+
+        seenPaths.add(relativePath)
+        continue
+      }
+
+      const embeddedChunks = embedVectorChunks(chunks)
+      await args.vectorStore.upsertChunks({
+        branchStateId: args.run.branchStateId,
+        runId: args.run.runId,
+        path: relativePath,
+        fileId,
+        chunks: embeddedChunks,
+      })
+
+      await args.vectorStore.deleteStaleByPath({
+        branchStateId: args.run.branchStateId,
+        path: relativePath,
+        keepFileId: fileId,
+      })
+
+      await stageUpsert({
+        runId: args.run.runId,
+        path: relativePath,
+        fileId,
+        sizeBytes: content.length,
+      })
+
+      stats.filesIndexed += 1
+      stats.chunksUpserted += embeddedChunks.length
+      manifestLines.push(
+        JSON.stringify({
+          path: relativePath,
+          status: existing ? 'changed' : 'new',
+          chunks: embeddedChunks.length,
+        }),
+      )
+      changedFileLines.push(
+        JSON.stringify({
+          path: relativePath,
+          changeType: existing ? 'modified' : 'added',
+          fileId,
+        }),
+      )
+      seenPaths.add(relativePath)
+    }
+
+    for (const [existingPath] of existingByPath) {
+      if (seenPaths.has(existingPath)) {
+        continue
+      }
+
+      await stageDelete({
+        runId: args.run.runId,
+        path: existingPath,
+        skipReason: 'deleted',
+      })
+      await args.vectorStore.deleteStaleByPath({
+        branchStateId: args.run.branchStateId,
+        path: existingPath,
+        keepFileId: null,
+      })
+
+      stats.filesDeleted += 1
+      changedFileLines.push(
+        JSON.stringify({
+          path: existingPath,
+          changeType: 'deleted',
+        }),
+      )
+    }
+
+    await args.artifactStore.writeManifest({
+      artifactsPrefix: args.run.artifactsPrefix,
+      lines: manifestLines,
+    })
+
+    await args.artifactStore.writeChangedFiles({
+      artifactsPrefix: args.run.artifactsPrefix,
+      lines: changedFileLines,
+    })
+
+    await args.artifactStore.writeRunJson({
+      artifactsPrefix: args.run.artifactsPrefix,
+      run: {
+        runId: args.run.runId,
+        mode: 'snapshot',
+        headSha: args.run.headSha,
+        stats,
+      },
+    })
+
+    return {
+      stats,
+    }
+  } finally {
+    if (extractDir) {
+      await rm(extractDir, { recursive: true, force: true })
+    }
+
+    await rm(path.dirname(archivePath), { recursive: true, force: true })
+  }
+}
diff --git a/src/lib/indexing/sources/gitlab-source.ts b/src/lib/indexing/sources/gitlab-source.ts
new file mode 100644
index 00000000..74a4107a
--- /dev/null
+++ b/src/lib/indexing/sources/gitlab-source.ts
@@ -0,0 +1,214 @@
+import { mkdtemp, writeFile } from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+
+import { getIntegrationById, decryptIntegrationToken } from '@/lib/gitlab/service'
+import type { GitLabCompareChange, GitLabSource } from '@/lib/indexing/contracts'
+
+type IntegrationContext = {
+  instanceUrl: string
+  projectId: string
+  token: string
+}
+
+type GitLabCompareResponse = {
+  compare_timeout?: boolean
+  diffs?: Array<{
+    old_path?: string
+    new_path?: string
+    new_file?: boolean
+    renamed_file?: boolean
+    deleted_file?: boolean
+  }>
+}
+
+type GitLabBranchResponse = {
+  commit?: {
+    id?: string
+  }
+}
+
+const readErrorText = async (response: Response) => {
+  const text = await response.text().catch(() => '')
+  return text.slice(0, 1000)
+}
+
+const encodeProjectId = (projectId: string) => encodeURIComponent(projectId)
+
+const loadIntegrationContext = async (integrationId: string): Promise<IntegrationContext> => {
+  const integration = await getIntegrationById(integrationId)
+  if (!integration) {
+    throw new Error(`Integration ${integrationId} not found.`)
+  }
+
+  return {
+    instanceUrl: integration.instanceUrl,
+    projectId: integration.projectId,
+    token: decryptIntegrationToken(integration),
+  }
+}
+
+const gitLabRequest = async (args: {
+  integration: IntegrationContext
+  apiPath: string
+}): Promise<Response> => {
+  const response = await fetch(`${args.integration.instanceUrl}${args.apiPath}`, {
+    headers: {
+      'private-token': args.integration.token,
+      'user-agent': 'argus-app',
+    },
+  })
+
+  if (!response.ok) {
+    const body = await readErrorText(response)
+    throw new Error(
+      `GitLab request failed (${response.status})${body ? `: ${body}` : ''}`,
+    )
+  }
+
+  return response
+}
+
+const toCompareChangeType = (diff: {
+  new_file?: boolean
+  renamed_file?: boolean
+  deleted_file?: boolean
+}): GitLabCompareChange['type'] => {
+  if (diff.deleted_file) {
+    return 'deleted'
+  }
+
+  if (diff.renamed_file) {
+    return 'renamed'
+  }
+
+  if (diff.new_file) {
+    return 'added'
+  }
+
+  return 'modified'
+}
+
+export class GitLabApiSource implements GitLabSource {
+  async resolveHeadSha(args: {
+    integrationId: string
+    branch: string
+    hintedHeadSha?: string
+  }): Promise<string> {
+    const hinted = args.hintedHeadSha?.trim()
+    if (hinted) {
+      return hinted
+    }
+
+    const integration = await loadIntegrationContext(args.integrationId)
+    const encodedProjectId = encodeProjectId(integration.projectId)
+    const encodedBranch = encodeURIComponent(args.branch)
+
+    const response = await gitLabRequest({
+      integration,
+      apiPath: `/api/v4/projects/${encodedProjectId}/repository/branches/${encodedBranch}`,
+    })
+
+    const payload = (await response.json()) as GitLabBranchResponse
+    const commitId = payload.commit?.id?.trim()
+    if (!commitId) {
+      throw new Error(`Unable to resolve head SHA for branch ${args.branch}.`)
+    }
+
+    return commitId
+  }
+
+  async compare(args: {
+    integrationId: string
+    fromSha: string
+    toSha: string
+  }): Promise<{
+    valid: boolean
+    incomplete: boolean
+    changes: GitLabCompareChange[]
+  }> {
+    try {
+      const integration = await loadIntegrationContext(args.integrationId)
+      const encodedProjectId = encodeProjectId(integration.projectId)
+      const from = encodeURIComponent(args.fromSha)
+      const to = encodeURIComponent(args.toSha)
+
+      const response = await gitLabRequest({
+        integration,
+        apiPath: `/api/v4/projects/${encodedProjectId}/repository/compare?from=${from}&to=${to}`,
+      })
+
+      const payload = (await response.json()) as GitLabCompareResponse
+      const diffs = payload.diffs ?? []
+      const changes: GitLabCompareChange[] = diffs.map((diff) => ({
+        oldPath: diff.old_path ?? null,
+        newPath: diff.new_path ?? null,
+        type: toCompareChangeType(diff),
+      }))
+
+      return {
+        valid: true,
+        incomplete: Boolean(payload.compare_timeout),
+        changes,
+      }
+    } catch {
+      return {
+        valid: false,
+        incomplete: true,
+        changes: [],
+      }
+    }
+  }
+
+  async fetchFile(args: {
+    integrationId: string
+    path: string
+    ref: string
+  }): Promise<{
+    path: string
+    content: Buffer
+  }> {
+    const integration = await loadIntegrationContext(args.integrationId)
+    const encodedProjectId = encodeProjectId(integration.projectId)
+    const filePath = encodeURIComponent(args.path)
+    const ref = encodeURIComponent(args.ref)
+
+    const response = await gitLabRequest({
+      integration,
+      apiPath: `/api/v4/projects/${encodedProjectId}/repository/files/${filePath}/raw?ref=${ref}`,
+    })
+
+    const content = Buffer.from(await response.arrayBuffer())
+    return {
+      path: args.path,
+      content,
+    }
+  }
+
+  async downloadArchive(args: {
+    integrationId: string
+    sha: string
+  }): Promise<{
+    archivePath: string
+  }> {
+    const integration = await loadIntegrationContext(args.integrationId)
+    const encodedProjectId = encodeProjectId(integration.projectId)
+    const sha = encodeURIComponent(args.sha)
+
+    const response = await gitLabRequest({
+      integration,
+      apiPath: `/api/v4/projects/${encodedProjectId}/repository/archive.tar.gz?sha=${sha}`,
+    })
+
+    const archiveBytes = Buffer.from(await response.arrayBuffer())
+    const tempDir = await mkdtemp(path.join(os.tmpdir(), 'argus-indexer-archive-'))
+    const archivePath = path.join(tempDir, 'source.tar.gz')
+    await writeFile(archivePath, archiveBytes)
+
+    return {
+      archivePath,
+    }
+  }
+}
+
+export const createGitLabSource = () => new GitLabApiSource()
