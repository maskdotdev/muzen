@@ -0,0 +1,46 @@
+import type { VectorChunkRecord } from '@/lib/indexing/contracts'
+import { sha256Hex } from '@/lib/utils/hash'
+
+const DEFAULT_EMBEDDING_DIMENSION = 16
+
+const readEmbeddingDimension = () => {
+  const fromEnv = process.env.INDEXER_EMBED_DIM
+  if (!fromEnv) {
+    return DEFAULT_EMBEDDING_DIMENSION
+  }
+
+  const parsed = Number.parseInt(fromEnv, 10)
+  if (!Number.isFinite(parsed) || parsed <= 0 || parsed > 3072) {
+    return DEFAULT_EMBEDDING_DIMENSION
+  }
+
+  return parsed
+}
+
+const embedTextDeterministic = (text: string, dimension: number): number[] => {
+  const values: number[] = []
+  let counter = 0
+
+  while (values.length < dimension) {
+    const hash = sha256Hex(`${text}:${counter}`)
+    for (let offset = 0; offset < hash.length && values.length < dimension; offset += 2) {
+      const byte = Number.parseInt(hash.slice(offset, offset + 2), 16)
+      const normalized = (byte / 255) * 2 - 1
+      values.push(Number(normalized.toFixed(6)))
+    }
+    counter += 1
+  }
+
+  return values
+}
+
+export const embedVectorChunks = (
+  chunks: Array<Omit<VectorChunkRecord, 'embedding'>>,
+): VectorChunkRecord[] => {
+  const dimension = readEmbeddingDimension()
+
+  return chunks.map((chunk) => ({
+    ...chunk,
+    embedding: embedTextDeterministic(chunk.content, dimension),
+  }))
+}
