@@ -0,0 +1,29 @@
+import type { VectorChunkRecord } from '@/lib/indexing/contracts'
+import { chunkWithCodeIntelligence } from '@/lib/indexing/engines/code-intelligence'
+import { sha256Hex } from '@/lib/utils/hash'
+
+const normalizeChunkText = (value: string) => value.replace(/\s+/g, ' ').trim()
+
+export const buildVectorChunks = async (args: {
+  path: string
+  content: string
+  configHash: string
+}): Promise<Array<Omit<VectorChunkRecord, 'embedding'>>> => {
+  const chunks = await chunkWithCodeIntelligence(args.path, args.content)
+
+  return chunks
+    .map((chunk) => {
+      const normalized = normalizeChunkText(chunk.content)
+      if (!normalized) {
+        return null
+      }
+
+      return {
+        chunkIndex: chunk.chunkIndex,
+        chunkId: sha256Hex(`${args.configHash}:${normalized}`),
+        content: chunk.content,
+        metadata: chunk.metadata,
+      }
+    })
+    .filter((chunk): chunk is Omit<VectorChunkRecord, 'embedding'> => Boolean(chunk))
+}
