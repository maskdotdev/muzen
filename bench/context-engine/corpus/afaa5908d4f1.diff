+import { describe, expect, test } from "bun:test"
+import { readFileSync } from "node:fs"
+import { join } from "node:path"
+
+describe("indexing console strict stream behavior", () => {
+  test("removes polling fallback and enforces stream reconnect constraints", () => {
+    const source = readFileSync(
+      join(process.cwd(), "src/components/indexing/indexing-console.tsx"),
+      "utf8",
+    )
+
+    expect(source.includes("window.setInterval(() => {\n      void loadIndexingData(selectedIntegrationId, true)\n    }, AUTO_REFRESH_MS)")).toBe(false)
+    expect(source.includes("source.addEventListener(\"heartbeat\"")).toBe(true)
+    expect(source.includes("STREAM_MAX_RECONNECT_ATTEMPTS")).toBe(true)
+    expect(source.includes("streamStatus === \"stale\"")).toBe(true)
+    expect(source.includes("const handleReconnectStream = useCallback(() =>")).toBe(true)
+  })
+})
