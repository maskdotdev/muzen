+const formatIssue = (issue: ReviewLinkedIssue): string => {
+  const lines = [
+    `- [${issue.provider}] ${issue.ref} - ${issue.title}`,
+    `  State: ${issue.state.raw} (${issue.state.normalized})`,
+  ]
+
+  if (issue.issueType) {
+    lines.push(`  Type: ${issue.issueType}`)
+  }
+  if (issue.priority) {
+    lines.push(`  Priority: ${issue.priority}`)
+  }
+  if (issue.labels.length > 0) {
+    lines.push(`  Labels: ${issue.labels.join(', ')}`)
+  }
+  if (issue.assigneeNames.length > 0) {
+    lines.push(`  Assignees: ${issue.assigneeNames.join(', ')}`)
+  }
+  if (issue.reporterName) {
+    lines.push(`  Reporter: ${issue.reporterName}`)
+  }
+  if (issue.descriptionRaw.trim()) {
+    lines.push(`  Acceptance Criteria / Description:\n${issue.descriptionRaw.trim()}`)
+  }
+
+  return lines.join('\n')
+}
+
+const formatIssueContextSection = (issueContext: ReviewIssueContext): string[] => {
+  const lines = [
+    '# Linked Issue Requirements',
+    'Treat linked issues as product requirements and acceptance criteria when evaluating whether the merge request is complete and correct.',
+    'Raise findings when the changed code appears inconsistent with, incomplete for, or likely to violate those requirements.',
+    'Do not invent requirements beyond the linked issue details and the diff.',
+    '',
+    `Issue refs parsed: ${issueContext.refsParsed}`,
+    `Issue lookups succeeded: ${issueContext.lookupsSucceeded}`,
+    `Issue lookups failed: ${issueContext.lookupsFailed}`,
+  ]
+
+  if (issueContext.error) {
+    lines.push(`Issue context error: ${issueContext.error}`)
+  }
+
+  if (issueContext.issues.length > 0) {
+    lines.push('')
+    lines.push('Resolved linked issues:')
+    for (const issue of issueContext.issues) {
+      lines.push(formatIssue(issue))
+    }
+  }
+
+  if (issueContext.failures.length > 0) {
+    lines.push('')
+    lines.push('Unresolved issue references:')
+    for (const failure of issueContext.failures) {
+      lines.push(
+        `- [${failure.provider}] ${failure.ref} - ${failure.reason}: ${failure.message}`,
+      )
+    }
+  }
+
+  return lines
+}
+
+const hasMeaningfulIssueContext = (issueContext: ReviewIssueContext | null | undefined) =>
