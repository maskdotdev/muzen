@@ -0,0 +1,145 @@
+"use client"
+
+import { CircleAlertIcon, MessageCircleIcon, PanelRightCloseIcon, PanelRightOpenIcon, TableOfContentsIcon } from "lucide-react"
+
+import {
+  useRightSidebarSlot,
+  type RightSidebarTab,
+} from "@/components/app-sidebar-right-slot"
+import { Button } from "@/components/ui/button"
+import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
+import { cn } from "@/lib/utils"
+
+const RIGHT_SIDEBAR_WIDTH = "calc(var(--spacing) * 86)"
+
+export function AppSidebarRight({
+  className,
+  children,
+  ...props
+}: React.ComponentProps<"div">) {
+  const { open, activeTab, setActiveTab } = useRightSidebarSlot()
+
+  return (
+    <div
+      data-slot="right-sidebar"
+      data-state={open ? "expanded" : "collapsed"}
+      className="group/right-sidebar text-sidebar-foreground hidden lg:block"
+      {...props}
+    >
+      {/* Gap element — reserves space in the parent flex layout */}
+      <div
+        className={cn(
+          "relative bg-transparent transition-[width] duration-200 ease-linear",
+          open ? "w-(--right-sidebar-width)" : "w-0",
+        )}
+        style={{ "--right-sidebar-width": RIGHT_SIDEBAR_WIDTH } as React.CSSProperties}
+      />
+      {/* Fixed sidebar panel — inset variant: p-2 padding, no border */}
+      <div
+        className={cn(
+          "fixed inset-y-0 right-0 z-10 hidden h-svh p-2 transition-[width] duration-200 ease-linear lg:flex",
+          open ? "w-(--right-sidebar-width)" : "w-0 overflow-hidden",
+          className,
+        )}
+        style={{ "--right-sidebar-width": RIGHT_SIDEBAR_WIDTH } as React.CSSProperties}
+      >
+        <div className="bg-sidebar flex h-full w-(--right-sidebar-width) flex-col rounded-lg">
+          {/* Tabbed content area */}
+          <Tabs
+            value={activeTab}
+            onValueChange={(value) => setActiveTab(value as RightSidebarTab)}
+            className="flex min-h-0 flex-1 flex-col"
+          >
+            <div className="shrink-0 px-3 pt-2">
+              <TabsList className="w-full">
+                <TabsTrigger value="overview" className="gap-1.5">
+                  <TableOfContentsIcon className="size-3.5" />
+                  Overview
+                </TabsTrigger>
+                <TabsTrigger value="issues" className="gap-1.5">
+                  <CircleAlertIcon className="size-3.5" />
+                  Issues
+                </TabsTrigger>
+                <TabsTrigger value="chat" className="gap-1.5">
+                  <MessageCircleIcon className="size-3.5" />
+                  Chat
+                </TabsTrigger>
+              </TabsList>
+            </div>
+
+            <TabsContent value="overview" className="min-h-0 flex-1 overflow-auto px-3 py-3">
+              <RightSidebarOverviewPlaceholder />
+            </TabsContent>
+
+            <TabsContent value="issues" className="min-h-0 flex-1 overflow-auto px-3 py-3">
+              <RightSidebarIssuesPlaceholder />
+            </TabsContent>
+
+            <TabsContent value="chat" className="min-h-0 flex-1 overflow-auto px-3 py-3">
+              <RightSidebarChatPlaceholder />
+            </TabsContent>
+          </Tabs>
+
+          {children}
+        </div>
+      </div>
+    </div>
+  )
+}
+
+export function RightSidebarTrigger({
+  className,
+  ...props
+}: React.ComponentProps<typeof Button>) {
+  const { open, toggleOpen } = useRightSidebarSlot()
+
+  return (
+    <Button
+      data-slot="right-sidebar-trigger"
+      variant="ghost"
+      size="icon"
+      className={cn("size-7", className)}
+      onClick={toggleOpen}
+      {...props}
+    >
+      {open ? <PanelRightCloseIcon /> : <PanelRightOpenIcon />}
+      <span className="sr-only">Toggle Right Sidebar</span>
+    </Button>
+  )
+}
+
+function RightSidebarOverviewPlaceholder() {
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="rounded-lg border border-dashed border-border/50 px-3 py-6 text-center">
+        <p className="text-sm text-muted-foreground">
+          Overview content will appear here.
+        </p>
+      </div>
+    </div>
+  )
+}
+
+function RightSidebarIssuesPlaceholder() {
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="rounded-lg border border-dashed border-border/50 px-3 py-6 text-center">
+        <p className="text-sm text-muted-foreground">
+          Issues will appear here.
+        </p>
+      </div>
+    </div>
+  )
+}
+
+function RightSidebarChatPlaceholder() {
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="rounded-lg border border-dashed border-border/50 px-3 py-6 text-center">
+        <p className="text-sm text-muted-foreground">
+          Chat will appear here.
+        </p>
+      </div>
+    </div>
+  )
+}
