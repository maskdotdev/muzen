+"use client"
+
+import { FileDiff, Virtualizer, WorkerPoolContextProvider } from "@pierre/diffs/react"
+import type { CSSProperties } from "react"
+
+import { AppSidebarRight } from "@/components/app-sidebar-right"
+import { RightSidebarPortal } from "@/components/app-sidebar-right-slot"
+import { useCopyableErrorToast } from "@/components/ui/use-copyable-error-toast"
+import { MergeRequestDiffFileHeader } from "@/features/review/components/diff/file-header"
+import { useMergeRequestDiffViewerController } from "@/features/review/hooks/diff/use-viewer-controller"
+import type { MergeRequestDiffViewerProps } from "@/features/review/model/diff/types"
+
+const DIFF_CHROME_STYLE = {
+  "--diffs-bg-context-number-override": "var(--diffs-bg-context)",
+  "--diffs-bg-addition-number-override": "var(--diffs-bg-addition)",
+  "--diffs-bg-deletion-number-override": "var(--diffs-bg-deletion)",
+  "--diffs-bg-selection-number-override": "var(--diffs-bg-selection)",
+} as CSSProperties
+
+export function MergeRequestDiffsOnlyViewer(props: MergeRequestDiffViewerProps) {
+  const panelProps = useMergeRequestDiffViewerController(props)
+
+  useCopyableErrorToast(panelProps.loadError, {
+    title: "Failed to load merge request diff",
+  })
+  useCopyableErrorToast(panelProps.parseError, {
+    title: "Failed to parse merge request diff",
+  })
+
+  const visibleFileEntries = panelProps.visibleFiles.map((file) => {
+    const fileKey = panelProps.getFileKey(file)
+    return {
+      file,
+      fileKey,
+      isCollapsed: panelProps.collapsedFileKeys.has(fileKey),
+    }
+  })
+
+  return (
+    <>
+      <RightSidebarPortal>
+        <AppSidebarRight />
+      </RightSidebarPortal>
+      <div className="flex min-h-0 flex-1 flex-col overflow-hidden">
+        {panelProps.loadError ? (
+          <div className="mb-3 rounded-lg border border-destructive/20 bg-destructive/5 px-4 py-3 text-sm text-destructive">
+            {panelProps.loadError}
+          </div>
+        ) : null}
+        {panelProps.parseError ? (
+          <div className="mb-3 rounded-lg border border-destructive/20 bg-destructive/5 px-4 py-3 text-sm text-destructive">
+            {panelProps.parseError}
+          </div>
+        ) : null}
+
+        <Virtualizer className="min-h-0 flex-1 overflow-auto" contentClassName="px-3 py-3 pb-8">
+          {panelProps.isDiffBusy ? (
+            <div className="rounded-lg border border-dashed border-border/50 px-4 py-10 text-center text-sm text-muted-foreground/70">
+              Preparing initial diff files…
+            </div>
+          ) : null}
+
+          {!panelProps.isDiffBusy &&
+          !panelProps.loadError &&
+          !panelProps.parseError &&
+          visibleFileEntries.length === 0 ? (
+            <div className="rounded-lg border border-dashed border-border/50 px-4 py-10 text-center text-sm text-muted-foreground/70">
+              No diff files available.
+            </div>
+          ) : null}
+
+          {visibleFileEntries.length > 0 ? (
+            <WorkerPoolContextProvider
+              poolOptions={panelProps.poolOptions}
+              highlighterOptions={panelProps.highlighterOptions}
+            >
+              <div className="space-y-3">
+                {visibleFileEntries.map((entry) => (
+                  <div key={entry.fileKey} className="relative overflow-clip rounded-lg">
+                    <MergeRequestDiffFileHeader
+                      file={entry.file}
+                      isCollapsed={entry.isCollapsed}
+                      reviewStatus="pending"
+                      isDarkMode={panelProps.effectiveDiffThemeType === "dark"}
+                      onToggleCollapsed={() => panelProps.onToggleFileCollapsed(entry.file)}
+                    />
+                    {!entry.isCollapsed ? (
+                      <div
+                        className="overflow-hidden rounded-b-lg border border-t-0 border-border"
+                        style={DIFF_CHROME_STYLE}
+                      >
+                        <FileDiff fileDiff={entry.file} options={panelProps.diffOptions} />
+                      </div>
+                    ) : null}
+                  </div>
+                ))}
+              </div>
+            </WorkerPoolContextProvider>
+          ) : null}
+        </Virtualizer>
+      </div>
+    </>
+  )
+}
