diff --git a/apps/web/src/components/app-sidebar-right-slot.tsx b/apps/web/src/components/app-sidebar-right-slot.tsx
new file mode 100644
index 00000000..30707087
--- /dev/null
+++ b/apps/web/src/components/app-sidebar-right-slot.tsx
@@ -0,0 +1,77 @@
+"use client"
+
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useMemo,
+  useState,
+  useEffect,
+  type ReactNode,
+} from "react"
+
+export type RightSidebarTab = "overview" | "issues" | "chat"
+
+type RightSidebarSlotContextProps = {
+  /** The sidebar content registered by a page via RightSidebarPortal. */
+  content: ReactNode | null
+  setContent: (content: ReactNode | null) => void
+  /** Whether the right sidebar is expanded (visible). */
+  open: boolean
+  setOpen: (open: boolean) => void
+  toggleOpen: () => void
+  /** The currently active tab in the right sidebar. */
+  activeTab: RightSidebarTab
+  setActiveTab: (tab: RightSidebarTab) => void
+}
+
+const RightSidebarSlotContext = createContext<RightSidebarSlotContextProps | null>(null)
+
+export function RightSidebarSlotProvider({ children }: { children: ReactNode }) {
+  const [content, setContent] = useState<ReactNode | null>(null)
+  const [open, setOpen] = useState(true)
+  const [activeTab, setActiveTab] = useState<RightSidebarTab>("overview")
+
+  const toggleOpen = useCallback(() => setOpen((prev) => !prev), [])
+
+  const value = useMemo<RightSidebarSlotContextProps>(
+    () => ({ content, setContent, open, setOpen, toggleOpen, activeTab, setActiveTab }),
+    [content, open, toggleOpen, activeTab],
+  )
+
+  return (
+    <RightSidebarSlotContext.Provider value={value}>
+      {children}
+    </RightSidebarSlotContext.Provider>
+  )
+}
+
+export function useRightSidebarSlot() {
+  const context = useContext(RightSidebarSlotContext)
+  if (!context) {
+    throw new Error("useRightSidebarSlot must be used within a RightSidebarSlotProvider.")
+  }
+  return context
+}
+
+/**
+ * Declarative component that registers content into the right sidebar slot.
+ * When unmounted (e.g. navigating away from the page), the slot is cleared.
+ *
+ * Usage:
+ * ```tsx
+ * <RightSidebarPortal>
+ *   <AppSidebarRight />
+ * </RightSidebarPortal>
+ * ```
+ */
+export function RightSidebarPortal({ children }: { children: ReactNode }) {
+  const { setContent } = useRightSidebarSlot()
+
+  useEffect(() => {
+    setContent(children)
+    return () => setContent(null)
+  }, [children, setContent])
+
+  return null
+}
