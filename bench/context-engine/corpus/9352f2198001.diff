+  try {
+    const parsed = JSON.parse(raw) as Record<
+      string,
+      { checkedAt: number; feedback: TokenTestFeedback } | undefined
+    >
+    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+      return new Map()
+    }
+
+    const entries = Object.entries(parsed).filter(([, item]) => {
+      if (!item || typeof item !== "object") {
+        return false
+      }
+      if (typeof item.checkedAt !== "number" || !Number.isFinite(item.checkedAt)) {
+        return false
+      }
+      if (!item.feedback || typeof item.feedback !== "object") {
+        return false
+      }
+      if (
+        item.feedback.kind !== "success" &&
+        item.feedback.kind !== "error"
+      ) {
+        return false
+      }
+      if (typeof item.feedback.message !== "string") {
+        return false
+      }
+      return true
+    })
+
+    return new Map(entries)
+  } catch {
+    return new Map()
+  }
