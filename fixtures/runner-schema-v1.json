          "default": "null"
        },
        {
          "name": "root",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "changedFiles",
          "type": "string[]",
          "required": false,
          "default": "[]"
        },
        {
          "name": "owner",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "number",
          "type": "integer",
          "required": false,
          "default": "null"
        },
        {
          "name": "server",
          "type": "string",
          "required": false,
