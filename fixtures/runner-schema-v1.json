{
  "schemaVersion": "muzen.runner.v1",
  "transport": "newline-delimited JSON-RPC 2.0 over stdio",
  "requests": [
    {
      "method": "runner.handshake",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Negotiate protocol version and capabilities.",
      "params": {
        "name": "RunnerHandshakeParams"
      },
      "result": {
        "name": "RunnerHandshakeResult"
      }
    },
    {
      "method": "runner.check",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Return local runner diagnostics.",
      "result": {
        "name": "RunnerCheckResult"
      }
    },
    {
      "method": "runner.schema.export",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Return protocol method metadata for SDK validation.",
      "result": {
        "name": "RunnerProtocolSchema"
      }
    },
    {
      "method": "run.start",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Start a review run.",
      "params": {
        "name": "RunStartParams"
      },
      "result": {
        "name": "RunnerRunResult"
      }
    },
    {
      "method": "run.cancel",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Cancel an active review run.",
      "params": {
        "name": "RunLookupParams"
      },
      "result": {
        "name": "RunCancelResult"
      }
    },
    {
      "method": "run.status",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Read active run status.",
      "params": {
        "name": "RunLookupParams"
      },
      "result": {
        "name": "RunStatusResult"
      }
    },
    {
      "method": "run.result",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Read final run report.",
      "params": {
        "name": "RunLookupParams"
      },
      "result": {
        "name": "RunnerRunResult"
      }
    },
    {
      "method": "artifact.read",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Read one redacted or raw artifact.",
      "params": {
        "name": "ArtifactReadParams"
      },
      "result": {
        "name": "RunnerArtifactReadResult"
      }
    },
    {
      "method": "artifact.export",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Export artifacts using a policy.",
      "params": {
        "name": "ArtifactExportParams"
      },
      "result": {
        "name": "RunnerArtifactExportResult"
      }
    },
    {
      "method": "snapshot.readText",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Read captured snapshot text.",
      "params": {
        "name": "SnapshotReadTextParams"
      },
      "result": {
        "name": "RunnerSnapshotTextResult"
      }
    },
    {
      "method": "webhook.github.handle",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Verify and schedule a GitHub webhook delivery.",
      "params": {
        "name": "WebhookHandleParams"
      },
      "result": {
        "name": "ReviewHttpResponse"
      }
    },
    {
      "method": "webhook.gitlab.handle",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Verify and schedule a GitLab webhook delivery.",
      "params": {
        "name": "WebhookHandleParams"
      },
      "result": {
        "name": "ReviewHttpResponse"
      }
    },
    {
      "method": "worker.runOnce",
      "direction": "sdk_to_runner",
      "status": "implemented",
      "summary": "Claim and execute ready durable review sessions through the Rust worker.",
      "params": {
        "name": "WorkerRunOnceParams"
      },
      "result": {
        "name": "WorkerRunOnceResult"
      }
    }
  ],
  "callbacks": [
    {
      "method": "source.materialize",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Ask the SDK source provider to materialize a review source.",
      "params": {
        "name": "SourceMaterializeParams"
      },
      "result": {
        "name": "SourceMaterializeResult"
      }
    },
    {
      "method": "run.heartbeat",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Ask the SDK host to renew an active run lease.",
      "params": {
        "name": "RunHeartbeatParams"
      },
      "result": {
        "name": "RunHeartbeatResult"
      }
    },
    {
      "method": "model.complete",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Ask the SDK model adapter for one model turn.",
      "params": {
        "name": "RunnerModelCompleteParams"
      },
      "result": {
        "name": "RunnerModelCompleteResult"
      }
    },
    {
      "method": "tool.execute",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Ask the SDK to execute a host custom tool.",
      "params": {
        "name": "RunnerToolExecuteParams"
      },
      "result": {
        "name": "RunnerToolExecuteResult"
      }
    }
  ],
  "notifications": [
    {
      "method": "event.review",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Emit one host-facing review event.",
      "params": {
        "name": "ReviewEventRecord"
      }
    },
    {
      "method": "event.runtime",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Emit one advanced runtime event.",
      "params": {
        "name": "RuntimeEventRecord"
      }
    },
    {
      "method": "run.finished",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Notify that a run reached a terminal state.",
      "params": {
        "name": "RunnerRunResult"
      }
    },
    {
      "method": "run.failed",
      "direction": "runner_to_sdk",
      "status": "implemented",
      "summary": "Notify that a run failed before producing a report.",
      "params": {
        "name": "RunFailedNotification"
      }
    }
  ],
  "definitions": [
    {
      "name": "RunnerHandshakeParams",
      "shape": "object",
      "fields": [
        {
          "name": "protocolVersion",
          "type": "string",
          "required": true
        },
        {
          "name": "clientName",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "clientVersion",
          "type": "string",
          "required": false,
          "default": "null"
        }
      ]
    },
    {
      "name": "RunnerHandshakeResult",
      "shape": "object",
      "fields": [
        {
          "name": "protocolVersion",
          "type": "string",
          "required": true
        },
        {
          "name": "runnerName",
          "type": "string",
          "required": true
        },
        {
          "name": "runnerVersion",
          "type": "string",
          "required": true
        },
        {
          "name": "capabilities",
          "type": "RunnerCapabilities",
          "required": true
        }
      ]
    },
    {
      "name": "RunnerCapabilities",
      "shape": "object",
      "fields": [
        {
          "name": "supportedMethods",
          "type": "string[]",
          "required": true
        },
        {
          "name": "plannedMethods",
          "type": "string[]",
          "required": true
        },
        {
          "name": "transports",
          "type": "string[]",
          "required": true
        }
      ]
    },
    {
      "name": "RunnerCheckResult",
      "shape": "object",
      "fields": [
        {
          "name": "ok",
          "type": "boolean",
          "required": true
        },
        {
          "name": "protocolVersion",
          "type": "string",
          "required": true
        },
        {
          "name": "runnerName",
          "type": "string",
          "required": true
        },
        {
          "name": "runnerVersion",
          "type": "string",
          "required": true
        },
        {
          "name": "rustPackage",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "RunnerProtocolSchema",
      "shape": "object",
      "fields": [
        {
          "name": "schemaVersion",
          "type": "string",
          "required": true
        },
        {
          "name": "transport",
          "type": "string",
          "required": true
        },
        {
          "name": "requests",
          "type": "RunnerMethodSchema[]",
          "required": true
        },
        {
          "name": "callbacks",
          "type": "RunnerMethodSchema[]",
          "required": true
        },
        {
          "name": "notifications",
          "type": "RunnerMethodSchema[]",
          "required": true
        },
        {
          "name": "definitions",
          "type": "RunnerPayloadSchema[]",
          "required": true
        }
      ]
    },
    {
      "name": "RunnerMethodSchema",
      "shape": "object",
      "fields": [
        {
          "name": "method",
          "type": "string",
          "required": true
        },
        {
          "name": "direction",
          "type": "RunnerMessageDirection",
          "required": true
        },
        {
          "name": "status",
          "type": "RunnerMethodStatus",
          "required": true
        },
        {
          "name": "summary",
          "type": "string",
          "required": true
        },
        {
          "name": "params",
          "type": "RunnerPayloadRef",
          "required": false,
          "default": "null"
        },
        {
          "name": "result",
          "type": "RunnerPayloadRef",
          "required": false,
          "default": "null"
        }
      ]
    },
    {
      "name": "RunnerPayloadRef",
      "shape": "object",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "RunnerPayloadSchema",
      "shape": "object",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "shape",
          "type": "RunnerPayloadShape",
          "required": true
        },
        {
          "name": "fields",
          "type": "RunnerPayloadFieldSchema[]",
          "required": false,
          "default": "[]"
        },
        {
          "name": "values",
          "type": "string[]",
          "required": false,
          "default": "[]"
        }
      ]
    },
    {
      "name": "RunnerPayloadFieldSchema",
      "shape": "object",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "type",
          "type": "string",
          "required": true
        },
        {
          "name": "required",
          "type": "boolean",
          "required": true
        },
        {
          "name": "default",
          "type": "string",
          "required": false,
          "default": "null"
        }
      ]
    },
    {
      "name": "RunnerMessageDirection",
      "shape": "enum",
      "values": [
        "sdk_to_runner",
        "runner_to_sdk"
      ]
    },
    {
      "name": "RunnerMethodStatus",
      "shape": "enum",
      "values": [
        "implemented",
        "reserved"
      ]
    },
    {
      "name": "RunnerPayloadShape",
      "shape": "enum",
      "values": [
        "object",
        "enum"
      ]
    },
    {
      "name": "RunnerFailureKind",
      "shape": "enum",
      "values": [
        "source_unavailable",
        "auth_failed",
        "tool_failed",
        "model_failed",
        "budget_exhausted",
        "cancelled",
        "policy_denied",
        "internal_error"
      ]
    },
    {
      "name": "RunnerRetryHint",
      "shape": "enum",
      "values": [
        "retryable",
        "not_retryable",
        "retry_after",
        "requires_user_action"
      ]
    },
    {
      "name": "RunStartParams",
      "shape": "object",
      "fields": [
        {
          "name": "protocolVersion",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "runId",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "repo",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "source",
          "type": "ReviewSource",
          "required": false,
          "default": "null"
        },
        {
          "name": "sourceProvider",
          "type": "RunSourceProviderParams",
          "required": false,
          "default": "null"
        },
        {
          "name": "changedFiles",
          "type": "string[]",
          "required": false,
          "default": "[]"
        },
        {
          "name": "metadata",
          "type": "json",
          "required": false,
          "default": "{}"
        },
        {
          "name": "change",
          "type": "RunChangeParams",
          "required": false,
          "default": "null"
        },
        {
          "name": "instructions",
          "type": "RunInstructionParams[]",
          "required": false,
          "default": "[]"
        },
        {
          "name": "sessions",
          "type": "RunSessionParams[]",
          "required": false,
          "default": "[]"
        },
        {
          "name": "limits",
          "type": "RunLimitParams",
          "required": false,
          "default": "null"
        },
        {
          "name": "model",
          "type": "RunModelParams",
          "required": false,
          "default": "null"
        },
        {
          "name": "tools",
          "type": "RunToolParams[]",
          "required": false,
          "default": "[]"
        },
        {
          "name": "heartbeat",
          "type": "RunHeartbeatConfigParams",
          "required": false,
          "default": "null"
        }
      ]
    },
    {
      "name": "RunHeartbeatConfigParams",
      "shape": "object",
      "fields": [
        {
          "name": "callback",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
