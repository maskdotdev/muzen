          "required": false,
          "default": "[]"
        },
        {
          "name": "diff",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "reviewTarget",
          "type": "string",
          "required": false,
          "default": "null"
        },
        {
          "name": "metadata",
          "type": "json",
          "required": false,
          "default": "{}"
        }
      ]
    },
    {
      "name": "RunChangeFileParams",
      "shape": "object",
      "fields": [
        {
          "name": "path",
          "type": "string",
          "required": true
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "default": "null"
        }
      ]
    },
    {
      "name": "RunInstructionParams",
      "shape": "object",
      "fields": [
